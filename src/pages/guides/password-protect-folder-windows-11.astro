---
import Layout from '../../layouts/Layout.astro';
import ProvisioningApp from '../../components/ProvisioningApp';

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Password Protect a Folder in Windows 11",
  "description": "Learn how to password protect and encrypt a folder in Windows 11 without BitLocker or third-party software, using FileLocker's in-browser encryption.",
  "totalTime": "PT1M",
  "supply": [
    { "@type": "HowToSupply", "name": "Windows 11 Directory or Folder" }
  ],
  "tool": [
    { "@type": "HowToTool", "name": "FileLocker In-Browser Tool (Edge, Chrome, or Firefox)" }
  ],
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Select Your Folder",
      "text": "Click the folder dropzone above or navigate to filelocker.online/lock-folder/. Select any folder from your Windows 11 PC."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Set a Secure Passphrase",
      "text": "Enter and confirm your password. FileLocker derives an authenticated 256-bit key using memory-hard Argon2id."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Download the Encrypted .vault Archive",
      "text": "Click 'Lock Folder'. Your browser recursively packages your files and folders into an authenticated AES-GCM 256-bit .vault container."
    }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://filelocker.online/" },
    { "@type": "ListItem", "position": 2, "name": "Guides", "item": "https://filelocker.online/guides/" },
    { "@type": "ListItem", "position": 3, "name": "Password Protect Folder Windows 11", "item": "https://filelocker.online/guides/password-protect-folder-windows-11/" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Can you password protect a folder in Windows 11 without software?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Windows 11 does not have a native, built-in feature to lock individual folders with a password. While Windows 11 Pro includes BitLocker, it only encrypts entire disk drives, not individual shareable folders. Windows 11 Home users have neither. With FileLocker, you can password-protect any folder directly in Microsoft Edge or Google Chrome using client-side AES-GCM 256-bit encryption without downloading desktop software."
      }
    },
    {
      "@type": "Question",
      "name": "Does Windows 11 Home have BitLocker?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Full BitLocker drive encryption is only included in Windows 11 Pro, Enterprise, and Education editions. Windows 11 Home only offers basic device encryption tied to a Microsoft account, which cannot password-lock individual folders or produce portable encrypted files."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between Windows EFS and FileLocker?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Windows Encrypting File System (EFS) ties encryption to your local Windows user account certificate. As long as you are logged into Windows, anyone sitting at your PC can open the folder without being prompted for a password. If you email an EFS folder or move it to a USB drive, the recipient cannot open it. FileLocker creates standalone, password-protected containers (.vault) that prompt for a password every single time, across any computer."
      }
    },
    {
      "@type": "Question",
      "name": "Are my Windows 11 files uploaded to a remote server?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. FileLocker processes your folder entirely inside your local browser memory using the native Web Crypto API. Zero bytes are uploaded to remote servers, making it 100% private and GDPR/HIPAA friendly."
      }
    },
    {
      "@type": "Question",
      "name": "How do I unlock and open the encrypted folder later?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Simply visit filelocker.online/unlock-file/ on your Windows 11 PC or any Mac, Linux, or mobile device. Drop the .vault file, enter your password, and your original folder and subfolder structure will extract instantly to your device."
      }
    }
  ]
};
---

<Layout
  title="How to Password Protect a Folder in Windows 11 | FileLocker"
  description="Learn how to password protect a folder in Windows 11 without software or BitLocker. Lock any directory with private AES-256 in-browser encryption."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(howToSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <!-- HERO -->
  <div class="guide-hero">
    <div class="hero-shape hero-shape-1"></div>
    <div class="hero-shape hero-shape-2"></div>
    <div class="hero-shape hero-shape-3"></div>
    <div class="hero-inner">
      <nav class="hero-breadcrumb">
        <a href="/guides/">Guides</a>
        <span class="separator">/</span>
        <span class="current">Password Protect Folder Windows 11</span>
      </nav>
      <h1>How to Password Protect a Folder in Windows 11</h1>
      <p class="hero-subtitle">
        Looking to lock a folder on Windows 11? Whether you are on Windows 11 Home or Pro, here is the complete guide to locking any folder with authenticated AES-256 encryption—no BitLocker, no batch scripts, and zero software installs.
      </p>
    </div>
  </div>

  <!-- INTERACTIVE EMBEDDED TOOL DROPZONE -->
  <div class="w-full bg-[#f8fafc] border-b border-gray-200/80 py-8 px-4 sm:px-6 flex items-center justify-center">
    <div class="w-full max-w-2xl mx-auto bg-white rounded-[2rem] border border-gray-200/80 shadow-[0_12px_45px_rgba(0,0,0,0.06)] overflow-hidden">
      <div class="bg-gradient-to-r from-blue-600 to-indigo-600 px-6 py-4 text-white flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <span class="p-1.5 bg-white/20 rounded-lg text-white">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/>
            </svg>
          </span>
          <span class="font-bold text-sm sm:text-base">Lock Any Windows 11 Folder Instantly</span>
        </div>
        <span class="text-xs bg-white/15 px-2.5 py-1 rounded-full font-medium">Home &amp; Pro</span>
      </div>

      <div class="p-4 sm:p-6">
        <ProvisioningApp client:load initialMode="folder" hideHeader={true} />
      </div>

      <div class="text-center py-3 bg-gray-50 border-t border-gray-100 text-[12px] text-gray-500 font-medium flex items-center justify-center gap-2">
        <svg class="w-3.5 h-3.5 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <span>100% Client-Side. Preserves full folder hierarchy with zero cloud uploads.</span>
      </div>
    </div>
  </div>

  <!-- MAIN GUIDE CONTENT -->
  <div class="w-full bg-[#f8fafc] py-12 px-6">
    <div class="max-w-4xl mx-auto space-y-10">

      <!-- SECTION 1: THE WINDOWS 11 PROBLEM -->
      <div class="content-card animate-fade-in-up">
        <div class="prose max-w-none text-gray-700 leading-relaxed">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">The Truth About Password Protecting Folders in Windows 11</h2>
          <p>
            Millions of users upgrade to Windows 11 expecting an easy right-click option: <em>"Lock this folder with a password."</em> Yet, when you right-click a directory in Windows 11 File Explorer, there is no password option anywhere.
          </p>
          <p>
            Microsoft provides two built-in security features, but both fall drastically short for everyday folder locking:
          </p>
          <ul class="space-y-3 pl-5 list-disc text-sm sm:text-base">
            <li>
              <strong>BitLocker Drive Encryption:</strong> BitLocker only locks entire hard drives (like <code>C:</code> or <code>D:</code>). You cannot use it to protect an individual folder of contracts, tax documents, or photos. More importantly, BitLocker is completely excluded from <strong>Windows 11 Home</strong>, which powers the vast majority of personal laptops.
            </li>
            <li>
              <strong>Encrypted File System (EFS):</strong> Under folder properties &gt; Advanced &gt; <em>"Encrypt contents to secure data"</em>, Windows offers EFS. However, EFS is tied to your Windows user account. If anyone borrows your laptop while you are logged in, the folder opens transparently with zero password prompt!
            </li>
          </ul>
        </div>
      </div>

      <!-- SECTION 2: METHOD 1 - FILELOCKER -->
      <div class="content-card animate-fade-in-up">
        <div class="prose max-w-none text-gray-700 leading-relaxed">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-brand-blue text-xs font-bold uppercase tracking-wide mb-3">
            Method 1 · Recommended for All Windows 11 Users
          </div>
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Password Protect Any Folder in Windows 11 with FileLocker (No Install)</h2>
          <p>
            FileLocker enables Windows 11 Home and Pro users to package and encrypt entire folders into a portable, password-locked container directly inside Microsoft Edge or Google Chrome:
          </p>

          <h3 class="text-lg font-semibold text-gray-900 mt-6 mb-3">Step-by-Step Instructions:</h3>
          <ol class="space-y-3 pl-5 list-decimal">
            <li>Open the interactive folder tool above (or visit <a href="/lock-folder/" class="text-brand-blue font-semibold hover:underline">/lock-folder/</a>).</li>
            <li>Click <strong>Select Folder</strong> and choose any directory from your Windows 11 File Explorer.</li>
            <li>When your browser displays the folder permission prompt (<em>"View files in folder?"</em>), click <strong>View files</strong>. This allows the browser's local sandbox to read files without uploading them.</li>
            <li>Enter a strong password. FileLocker derives a cryptographic key using <strong>Argon2id</strong> with 64MB of memory hardness.</li>
            <li>Click <strong>Lock Folder</strong>. Your folder is packed into a TAR structure and encrypted with <strong>AES-GCM 256-bit</strong>.</li>
            <li>Download your <code>.vault</code> file. It can now be saved safely on USB drives, emailed, or uploaded to OneDrive without exposing sensitive contents.</li>
          </ol>
        </div>
      </div>

      <!-- SECTION 3: METHOD 2 - 7-ZIP ON WINDOWS 11 -->
      <div class="content-card animate-fade-in-up">
        <div class="prose max-w-none text-gray-700 leading-relaxed">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 text-slate-800 text-xs font-bold uppercase tracking-wide mb-3">
            Method 2 · Desktop Software
          </div>
          <h2 class="text-2xl font-bold text-gray-900 mb-4">How to Password Protect a Folder Using 7-Zip on Windows 11</h2>
          <p>
            If you prefer installing standalone desktop software, <strong>7-Zip</strong> is the most capable free tool on Windows 11.
          </p>
          <ol class="space-y-3 pl-5 list-decimal text-sm sm:text-base">
            <li>Download and install 7-Zip from <code>7-zip.org</code>.</li>
            <li>Open Windows 11 File Explorer and find your folder.</li>
            <li>Right-click the folder, click <strong>Show more options</strong> (or press <kbd class="px-2 py-0.5 bg-gray-100 rounded border text-xs font-mono">Shift + F10</kbd>), and select <strong>7-Zip &gt; Add to archive...</strong></li>
            <li>In the 7-Zip window, choose <strong>7z</strong> or <strong>zip</strong> under Archive format.</li>
            <li>In the Encryption section, type your password.</li>
            <li><strong>CRITICAL:</strong> Ensure <em>"Encryption method"</em> is set to <strong>AES-256</strong> (never ZipCrypto).</li>
            <li>Check <strong>"Encrypt file names"</strong> if using the <code>.7z</code> format to hide file names from unauthorized viewers.</li>
            <li>Click <strong>OK</strong>.</li>
          </ol>
        </div>
      </div>

      <!-- SECTION 4: COMPARISON TABLE -->
      <div class="content-card animate-fade-in-up">
        <h2 class="section-heading">Windows 11 Folder Protection Comparison</h2>
        <div class="overflow-x-auto mt-4">
          <table class="w-full text-left text-xs sm:text-sm border-collapse">
            <thead>
              <tr class="border-b border-gray-200 bg-gray-50 text-gray-900">
                <th class="py-3 px-3.5 font-bold">Solution</th>
                <th class="py-3 px-3.5 font-bold">Windows 11 Home?</th>
                <th class="py-3 px-3.5 font-bold">Protects Single Folders?</th>
                <th class="py-3 px-3.5 font-bold">Prompts Password on Share?</th>
                <th class="py-3 px-3.5 font-bold">Zero Software Install?</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 text-gray-700">
              <tr class="bg-blue-50/40">
                <td class="py-3 px-3.5 font-bold text-brand-blue">FileLocker.online</td>
                <td class="py-3 px-3.5 text-emerald-600 font-bold">✓ Full Support</td>
                <td class="py-3 px-3.5 text-emerald-600 font-bold">✓ Yes</td>
                <td class="py-3 px-3.5 text-emerald-600 font-bold">✓ Every Time</td>
                <td class="py-3 px-3.5 text-emerald-600 font-bold">✓ In-Browser</td>
              </tr>
              <tr>
                <td class="py-3 px-3.5 font-semibold text-gray-900">BitLocker</td>
                <td class="py-3 px-3.5 text-red-600 font-medium">✗ Pro / Enterprise Only</td>
                <td class="py-3 px-3.5 text-red-600 font-medium">✗ Whole Drive Only</td>
                <td class="py-3 px-3.5 text-red-600 font-medium">✗ No (Drive Level)</td>
                <td class="py-3 px-3.5 text-emerald-600 font-bold">✓ Built-in (Pro)</td>
              </tr>
              <tr>
                <td class="py-3 px-3.5 font-semibold text-gray-900">Windows EFS</td>
                <td class="py-3 px-3.5 text-red-600 font-medium">✗ Pro Only</td>
                <td class="py-3 px-3.5 text-emerald-600 font-bold">✓ Yes</td>
                <td class="py-3 px-3.5 text-red-600 font-medium">✗ Tied to User Login</td>
                <td class="py-3 px-3.5 text-emerald-600 font-bold">✓ Built-in (Pro)</td>
              </tr>
              <tr>
                <td class="py-3 px-3.5 font-semibold text-gray-900">7-Zip</td>
                <td class="py-3 px-3.5 text-emerald-600 font-bold">✓ Full Support</td>
                <td class="py-3 px-3.5 text-emerald-600 font-bold">✓ Yes</td>
                <td class="py-3 px-3.5 text-emerald-600 font-bold">✓ Every Time</td>
                <td class="py-3 px-3.5 text-red-600 font-medium">✗ Requires Install</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- SECTION 5: FAQS -->
      <div class="content-card animate-fade-in-up">
        <h2 class="section-heading">Frequently Asked Questions</h2>
        <div class="faq-grid mt-6">
          <div class="faq-item">
            <h3>Can I lock a folder in Windows 11 without third-party software?</h3>
            <p>Windows 11 does not have a native folder password feature. You can use FileLocker directly in Microsoft Edge or Google Chrome to encrypt any folder without installing software or uploading data.</p>
          </div>
          <div class="faq-item">
            <h3>Does Windows 11 Home have BitLocker?</h3>
            <p>No. Full BitLocker is only included in Windows 11 Pro and Enterprise editions. FileLocker works identically across all Windows 11 editions.</p>
          </div>
          <div class="faq-item">
            <h3>Can the encrypted folder be opened on a Mac or phone?</h3>
            <p>Yes. FileLocker .vault containers can be decrypted on any computer, Mac, or smartphone simply by visiting <a href="/unlock-file/" class="text-brand-blue hover:underline">/unlock-file/</a> in any browser.</p>
          </div>
          <div class="faq-item">
            <h3>Are my files uploaded to a server?</h3>
            <p>No. FileLocker processes your folder entirely inside your local browser memory using the native Web Crypto API. Zero bytes leave your device.</p>
          </div>
        </div>
      </div>

      <!-- SECTION 6: CTA -->
      <div class="cta-banner mt-8 animate-fade-in-up">
        <h2 class="text-white text-2xl font-bold mb-2">Protect Your Windows 11 Folders Now</h2>
        <p class="cta-label mb-6">Lock any folder directly in your browser with private AES-256 client-side encryption.</p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/lock-folder/" class="cta-button">Lock a Folder</a>
          <a href="/lock-file/" class="cta-button" style="background:transparent;color:#fff;border:2px solid rgba(255,255,255,0.4);">Lock a File</a>
        </div>
      </div>

    </div>
  </div>
</Layout>

