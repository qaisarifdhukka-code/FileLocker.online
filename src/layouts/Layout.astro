---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "Protect files and folders with a password directly in your browser. No account required and no file upload to a server." 
} = Astro.props;

const canonicalPath = Astro.url.pathname === '/' ? '/' : `${Astro.url.pathname.replace(/\/+$/, '')}/`;
const canonicalURL = new URL(canonicalPath, 'https://filelocker.online').toString();

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonicalURL}#webpage`,
  "url": canonicalURL,
  "name": title,
  "description": description,
  "isPartOf": { "@id": "https://filelocker.online/#website" }
};

const siteSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://filelocker.online/#organization",
      "name": "FileLocker",
      "url": "https://filelocker.online/"
    },
    {
      "@type": "WebSite",
      "@id": "https://filelocker.online/#website",
      "url": "https://filelocker.online/",
      "name": "FileLocker",
      "publisher": {
        "@id": "https://filelocker.online/#organization"
      }
    }
  ]
};
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- OpenGraph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="FileLocker" />
    <meta property="og:image" content="https://filelocker.online/hero.png" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://filelocker.online/hero.png" />
    <meta name="theme-color" content="#1e40af" />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL} />
    <script type="application/ld+json" set:html={JSON.stringify(siteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />
    <slot name="head" />
</head>
<body class="text-brand-dark flex flex-col min-h-screen bg-bg-light overflow-x-hidden">

    <!-- FLOATING CAPSULE HEADER WRAPPER -->
    <header class="sticky top-3 sm:top-4 z-50 w-full px-3 sm:px-6 pointer-events-none">
        <nav aria-label="Main navigation" class="pointer-events-auto max-w-5xl mx-auto bg-white/90 backdrop-blur-md border border-slate-200/80 shadow-[0_8px_30px_rgb(0,0,0,0.06),0_1px_3px_rgb(0,0,0,0.04)] rounded-full px-3.5 sm:px-5 py-2 sm:py-2.5 flex items-center justify-between transition-all duration-300">
            <!-- Left: Logo -->
            <a href="/" aria-label="FileLocker home" class="flex items-center gap-2 cursor-pointer flex-shrink-0 pl-1 sm:pl-2 group">
