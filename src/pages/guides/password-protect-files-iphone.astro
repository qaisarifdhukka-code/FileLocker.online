---
import Layout from '../../layouts/Layout.astro';
import ProvisioningApp from '../../components/ProvisioningApp';

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Password Protect Files on iPhone and iPad",
  "description": "Learn how to password protect files and documents on iPhone and iPad without installing third-party apps, using FileLocker in Mobile Safari.",
  "totalTime": "PT1M",
  "supply": [
    { "@type": "HowToSupply", "name": "iPhone or iPad with iOS / iPadOS" }
  ],
  "tool": [
    { "@type": "HowToTool", "name": "Mobile Safari or Google Chrome on iOS" }
  ],
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Select File from iPhone Files App",
      "text": "Tap the dropzone above in Mobile Safari. Select any PDF, photo, or document from your iPhone or iCloud Drive. Nothing is uploaded to a server."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Set a Password",
      "text": "Type an encryption passphrase. FileLocker derives an authenticated 256-bit cryptographic key using Argon2id."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Save Protected File to iPhone",
      "text": "Tap 'Lock File'. Your iPhone encrypts the file locally using AES-GCM and saves a secure .vault file to your Downloads folder."
    }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://filelocker.online/" },
    { "@type": "ListItem", "position": 2, "name": "Guides", "item": "https://filelocker.online/guides/" },
    { "@type": "ListItem", "position": 3, "name": "Password Protect Files iPhone", "item": "https://filelocker.online/guides/password-protect-files-iphone/" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Can you password protect a file on iPhone without an app?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. While iOS does not have a native 'Lock with Password' option in the Apple Files app, you can open filelocker.online in Mobile Safari. Select your file from the Files app, set a password, and your iPhone will encrypt the file locally using AES-GCM 256-bit without downloading third-party App Store apps or uploading data."
      }
    },
    {
      "@type": "Question",
      "name": "Can I lock a PDF or Excel document on iPhone?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. FileLocker supports any file format on iPhone and iPad, including PDFs, Excel sheets, Word docs, photos, and ZIP archives."
      }
    },
    {
      "@type": "Question",
      "name": "Does FileLocker upload my iPhone files to a server?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. All encryption runs directly inside Mobile Safari using the native Web Crypto API. Zero bytes leave your iPhone."
      }
    },
    {
      "@type": "Question",
      "name": "How do I open an encrypted file on an iPhone?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Open filelocker.online/unlock-file/ in Mobile Safari, select your .vault file from your Downloads, type your password, and tap Unlock File. Your decrypted file will save directly back to your Files app."
      }
    }
  ]
};
---

<Layout
  title="How to Password Protect Files on iPhone & iPad | FileLocker"
  description="Learn how to password protect files, PDFs, and photos on iPhone and iPad without installing apps. Private AES-256 in-browser client-side encryption."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(howToSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <!-- HERO -->
  <div class="guide-hero">
    <div class="hero-shape hero-shape-1"></div>
    <div class="hero-shape hero-shape-2"></div>
    <div class="hero-shape hero-shape-3"></div>
    <div class="hero-inner">
      <nav class="hero-breadcrumb">
        <a href="/guides/">Guides</a>
        <span class="separator">/</span>
        <span class="current">Password Protect Files iPhone</span>
      </nav>
      <h1>How to Password Protect Files on iPhone &amp; iPad</h1>
      <p class="hero-subtitle">
        Apple's iOS Files app does not allow you to lock files with a password. Here is how to encrypt documents, PDFs, photos, and spreadsheets on your iPhone without downloading ad-supported apps.
      </p>
    </div>
  </div>

  <!-- INTERACTIVE EMBEDDED TOOL DROPZONE -->
  <div class="w-full bg-[#f8fafc] border-b border-gray-200/80 py-8 px-4 sm:px-6 flex items-center justify-center">
    <div class="w-full max-w-2xl mx-auto bg-white rounded-[2rem] border border-gray-200/80 shadow-[0_12px_45px_rgba(0,0,0,0.06)] overflow-hidden">
      <div class="bg-gradient-to-r from-blue-600 to-indigo-600 px-6 py-4 text-white flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <span class="p-1.5 bg-white/20 rounded-lg text-white">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
            </svg>
          </span>
          <span class="font-bold text-sm sm:text-base">Encrypt iPhone Files in Safari</span>
        </div>
        <span class="text-xs bg-white/15 px-2.5 py-1 rounded-full font-medium">iOS &amp; iPadOS</span>
      </div>

      <div class="p-4 sm:p-6">
        <ProvisioningApp client:load initialMode="file" hideHeader={true} />
      </div>

      <div class="text-center py-3 bg-gray-50 border-t border-gray-100 text-[12px] text-gray-500 font-medium flex items-center justify-center gap-2">
        <svg class="w-3.5 h-3.5 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <span>Zero app downloads required. Runs 100% locally in Mobile Safari.</span>
      </div>
    </div>
  </div>

  <!-- MAIN EDITORIAL CONTENT -->
  <div class="w-full bg-[#f8fafc] py-12 px-6">
    <div class="max-w-4xl mx-auto space-y-10">

      <!-- SECTION 1: THE IPHONE PRIVACY BLIND SPOT -->
      <div class="content-card animate-fade-in-up">
        <div class="prose max-w-none text-gray-700 leading-relaxed">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">The iPhone File Privacy Problem</h2>
          <p>
            Apple devices are famous for biometric security (Face ID and Touch ID). However, once your iPhone is unlocked, anyone holding your phone can open the <strong>Files app</strong> and access every document, contract, tax PDF, and spreadsheet stored on your device or iCloud Drive.
          </p>
          <p>
            Unlike macOS, iOS has no Disk Utility or Terminal. Apple does allow locking individual notes in the Notes app, but there is no native way to password-protect arbitrary PDFs, Office files, or photo archives.
          </p>
        </div>
      </div>

      <!-- SECTION 2: METHOD 1 - FILELOCKER IN SAFARI -->
      <div class="content-card animate-fade-in-up">
        <div class="prose max-w-none text-gray-700 leading-relaxed">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-brand-blue text-xs font-bold uppercase tracking-wide mb-3">
            Method 1 · Zero App Downloads
          </div>
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Password Protect Any File on iPhone with FileLocker</h2>
          <p>
            You do not need to install ad-ridden mobile apps from the App Store. FileLocker runs natively in Mobile Safari on iOS:
          </p>
          <ol class="space-y-3 pl-5 list-decimal text-sm sm:text-base">
            <li>Open <strong>filelocker.online/lock-file/</strong> in Safari or use the tool dropzone above.</li>
            <li>Tap <strong>Select File</strong> and choose <em>Choose File</em> to open your iPhone Files app. Pick any document, PDF, or image.</li>
            <li>Enter your password. FileLocker derives an authenticated 256-bit key using <strong>Argon2id</strong>.</li>
            <li>Tap <strong>Lock File</strong>. Safari uses your iPhone's hardware-accelerated Web Crypto engine to encrypt the file with <strong>AES-GCM 256-bit</strong>.</li>
            <li>When prompted, tap <strong>Download</strong>. Your protected <code>.vault</code> file is saved to your iPhone's Downloads folder. You can now safely email, message, or upload the file to iCloud.</li>
          </ol>
        </div>
      </div>

      <!-- SECTION 3: THE DANGER OF SKETCHY APP STORE APPS -->
      <div class="content-card animate-fade-in-up">
        <div class="prose max-w-none text-gray-700 leading-relaxed">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-50 text-red-700 text-xs font-bold uppercase tracking-wide mb-3">
            Privacy Warning
          </div>
          <h2 class="text-2xl font-bold text-gray-900 mb-4">Why You Should Avoid Third-Party iOS "Vault" Apps</h2>
          <p>
            Searching "file locker" or "folder lock" on the Apple App Store yields dozens of third-party apps. Cybersecurity audits frequently reveal three serious risks:
          </p>
          <ul class="space-y-2 pl-5 list-disc text-sm sm:text-base">
            <li><strong>Aggressive Analytics &amp; Ad Trackers:</strong> Free locker apps often embed tracking SDKs that harvest metadata, IP addresses, and file naming information.</li>
            <li><strong>Predatory Subscription Traps:</strong> Many apps lock your files and then demand $9.99/week subscriptions to decrypt or restore your own data.</li>
            <li><strong>Proprietary Vendor Lock-in:</strong> If the developer shuts down or deletes the app from the App Store, your encrypted files may become permanently unrecoverable.</li>
          </ul>
        </div>
      </div>

      <!-- SECTION 4: FAQS -->
      <div class="content-card animate-fade-in-up">
        <h2 class="section-heading">Frequently Asked Questions</h2>
        <div class="faq-grid mt-6">
          <div class="faq-item">
            <h3>Can I password protect a PDF on iPhone?</h3>
            <p>Yes. Select your PDF in FileLocker on Mobile Safari, enter a password, and download the protected .vault file.</p>
          </div>
          <div class="faq-item">
            <h3>Does FileLocker work on iPad?</h3>
            <p>Yes. FileLocker works identically across iPadOS in Safari and Google Chrome.</p>
          </div>
          <div class="faq-item">
            <h3>How do I open the file later on my iPhone?</h3>
            <p>Visit <a href="/unlock-file/" class="text-brand-blue hover:underline">filelocker.online/unlock-file/</a> in Safari, pick the .vault file, and type your password to decrypt it.</p>
          </div>
          <div class="faq-item">
            <h3>Are my files uploaded to a server?</h3>
            <p>No. Zero bytes leave your iPhone. All encryption is computed locally inside Mobile Safari.</p>
          </div>
        </div>
      </div>

      <!-- SECTION 5: CTA -->
      <div class="cta-banner mt-8 animate-fade-in-up">
        <h2 class="text-white text-2xl font-bold mb-2">Password Protect iPhone Files Now</h2>
        <p class="cta-label mb-6">Lock any document, PDF, or photo directly in Safari with private AES-256 client-side encryption.</p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/lock-file/" class="cta-button">Protect a File</a>
          <a href="/lock-folder/" class="cta-button" style="background:transparent;color:#fff;border:2px solid rgba(255,255,255,0.4);">Protect a Folder</a>
        </div>
      </div>

    </div>
  </div>
</Layout>

