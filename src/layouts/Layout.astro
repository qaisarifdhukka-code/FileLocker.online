                                <span class="group-hover:translate-x-0.5 transition-transform">Secure File Sharing Guide</span>
                            </a>
                        </li>
                        <li>
                            <a href="/guides/password-protect-word-document/" class="text-slate-600 hover:text-brand-blue transition-colors flex items-center gap-1 group">
