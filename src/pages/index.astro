---
import Layout from '../layouts/Layout.astro';
import ProvisioningApp from '../components/ProvisioningApp';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "isPartOf": { "@id": "https://filelocker.online/#website" },
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is FileLocker free to use?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. FileLocker provides browser-based tools for password protecting and opening supported FileLocker files."
      }
    },
    {
      "@type": "Question",
      "name": "Are my files uploaded to a server?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. FileLocker processes your files locally in your browser. Your selected files are not uploaded to a FileLocker server for processing."
      }
    },
    {
      "@type": "Question",
      "name": "Can I password protect a folder?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. You can select a folder and protect its contents with a single password while preserving its folder structure."
      }
    },
    {
      "@type": "Question",
      "name": "What types of files can I protect?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can use FileLocker with many common file types, including documents, photos, videos, archives, and other files."
      }
    },
    {
      "@type": "Question",
      "name": "Can I protect large files?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "FileLocker is designed to work with large files by processing data in smaller parts instead of loading the entire file into memory at once."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need to install software?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. FileLocker runs in your web browser, so there is no separate application to install."
      }
    },
    {
      "@type": "Question",
      "name": "What happens if I forget my password?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "FileLocker does not store your password. If you forget it, the protected file cannot be opened through FileLocker."
      }
    }
  ]
};
const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "FileLocker",
  "url": "https://filelocker.online/",
  "applicationCategory": "SecurityApplication",
  "operatingSystem": "Browsers with File System Access API support",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Free online tool to password protect and encrypt files and folders directly in your browser, without server uploads, software installation, or an account.",
  "isPartOf": { "@id": "https://filelocker.online/#website" }
};
---

<Layout
  title="File Locker — Password Protect Files & Folders Online Free"
  description="Password protect files and folders online for free with FileLocker. 100% private client-side encryption directly in your browser—zero uploads, no accounts."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(webAppSchema)} />

  <!-- HERO SECTION -->
  <section class="w-full relative overflow-hidden bg-white pt-20 pb-32 lg:pt-32 lg:pb-40">
      <!-- Background elements -->
      <div class="absolute top-0 right-0 w-full md:w-1/2 h-full bg-gradient-to-bl from-blue-50/80 to-transparent rounded-bl-[150px] -z-10 pointer-events-none"></div>
      <div class="absolute -top-20 right-10 w-[500px] h-[500px] bg-brand-blue/5 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute bottom-10 left-10 w-96 h-96 bg-purple-400/5 rounded-full blur-3xl pointer-events-none"></div>

      <div class="max-w-7xl mx-auto px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-8 items-center">
          <!-- Left: Text -->
          <div class="flex flex-col items-start text-left z-10">
              <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-gray-50 border border-gray-200 text-xs font-semibold text-gray-600 mb-6 shadow-sm">
                  <span class="bg-blue-100 text-brand-blue px-2 py-0.5 rounded-md font-bold text-[10px] uppercase tracking-wide">Free</span>
                  <span>• No account • No installation</span>
              </div>
              
              <h1 class="text-[2.75rem] md:text-6xl lg:text-[4rem] font-extrabold text-gray-900 leading-[1.05] mb-6 tracking-tight">
                  Password Protect Files and <span class="text-brand-blue">Folders</span> Online.
              </h1>
              
              <p class="text-lg md:text-xl text-gray-500 mb-10 max-w-lg leading-relaxed font-medium">
                  Add password protection to files and folders directly from your browser. No installation, no account, and no file upload required.
              </p>
              
              <div class="flex flex-col sm:flex-row items-center gap-4 mb-10">
                  <a href="/lock-file/" class="w-full sm:w-auto bg-brand-blue hover:bg-brand-blue-dark text-white font-bold py-3.5 px-8 rounded-full shadow-lg shadow-blue-500/30 transition-transform hover:-translate-y-0.5 flex items-center justify-center gap-2 text-base">
                      Protect a File <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                  </a>
                  <a href="/unlock-file/" class="w-full sm:w-auto text-center bg-white hover:bg-gray-50 text-gray-700 font-bold py-3.5 px-8 rounded-full border border-gray-200 shadow-sm transition-transform hover:-translate-y-0.5 text-base">
                      Unlock a File
                  </a>
              </div>
              
              <div class="flex flex-wrap items-center gap-x-6 gap-y-3 text-sm font-semibold text-gray-500">
                  <div class="flex items-center gap-2">
                      <svg class="w-5 h-5 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                      No installation
                  </div>
                  <div class="flex items-center gap-2">
                      <svg class="w-5 h-5 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                      No account
                  </div>
                  <div class="flex items-center gap-2">
                      <svg class="w-5 h-5 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                      Files stay on your device
                  </div>
              </div>
          </div>

          <!-- Right: Widget & Floating elements -->
          <div class="relative w-full h-[450px] lg:h-[550px] flex items-center justify-center z-10 lg:pl-10">
              <!-- Decorative floating icons -->
              <div class="hidden md:block absolute top-10 left-0 w-24 h-24 bg-blue-500 rounded-2xl shadow-xl shadow-blue-500/20 transform -rotate-12 animate-[bounce_5s_infinite]">
                  <svg class="w-12 h-12 text-white m-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
              </div>
              <div class="hidden md:flex absolute bottom-12 -left-4 w-16 h-16 bg-yellow-50 rounded-2xl shadow-lg border border-yellow-100 transform rotate-12 items-center justify-center">
                  <svg class="w-8 h-8 text-yellow-500" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
              </div>
              <div class="hidden md:block absolute top-1/4 right-0 lg:-right-8 w-20 h-20 bg-purple-500 rounded-2xl shadow-xl shadow-purple-500/20 transform rotate-12 animate-[bounce_6s_infinite]">
                  <svg class="w-10 h-10 text-white m-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              </div>

              <!-- Main App Card -->
              <div class="w-full max-w-[480px] bg-white/90 backdrop-blur-xl shadow-[0_20px_60px_-15px_rgba(0,0,0,0.15)] rounded-[2rem] border border-white/80 relative overflow-hidden flex flex-col z-20">
                  <ProvisioningApp client:load initialMode="both" hideHeader={true} />
                  <div class="text-center py-4 bg-gray-50/80 border-t border-gray-100 text-[12px] text-gray-500 font-medium flex items-center justify-center gap-1.5 mt-auto z-10 relative">
                      <svg class="w-4 h-4 text-brand-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                      Your files are processed locally. Nothing is uploaded.
                  </div>
              </div>
          </div>
      </div>
  </section>

  <!-- HOW TO SEO SECTION -->
  <section class="w-full bg-[#f8fafc] py-20 lg:py-24 border-t border-gray-100">
      <div class="max-w-7xl mx-auto px-6 lg:px-8">
          <div class="mb-14 max-w-2xl text-left">
              <h3 class="text-brand-blue font-bold text-xs tracking-wider uppercase mb-3">How it works</h3>
              <h2 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-4 tracking-tight">How FileLocker Works: Three Steps to Lock Any File or Folder</h2>
              <p class="text-gray-500 text-lg leading-relaxed">Protect documents, photos, videos, or archives directly from your browser without installing software. Your files are processed entirely on your device and are never uploaded to our servers.</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 relative items-stretch">
              <!-- Connecting dashed line on desktop -->
              <div class="hidden md:block absolute top-1/2 -translate-y-1/2 left-[12%] right-[12%] border-t-2 border-dashed border-blue-200/70 z-0 pointer-events-none"></div>

              <!-- Step 1 -->
              <div class="bg-white rounded-2xl md:rounded-3xl p-5 lg:p-6 border border-gray-100 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.03)] hover:shadow-lg hover:border-blue-100 transition-all duration-300 relative z-10 flex flex-col items-start text-left group">
                  <!-- Step Badge 01 -->
                  <div class="w-7 h-7 rounded-full bg-blue-50 text-brand-blue flex items-center justify-center text-[11px] font-bold border border-blue-100 mb-3 shadow-xs">
                      01
                  </div>

                  <!-- Squircle Icon -->
                  <div class="w-11 h-11 mb-3 bg-blue-50/90 rounded-xl flex items-center justify-center text-brand-blue group-hover:scale-105 transition-transform border border-blue-100/50">
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                  </div>

                  <!-- Content (Left Aligned) -->
                  <h3 class="font-bold text-gray-900 text-lg mb-1 text-left">Select a File</h3>
                  <p class="text-gray-500 text-xs sm:text-sm leading-relaxed text-left">Pick a file or folder you want to protect.</p>

                  <!-- Arrow to next step (Desktop) -->
                  <div class="hidden md:flex absolute -right-4 top-1/2 -translate-y-1/2 z-20 w-8 h-8 rounded-full bg-white border border-blue-100 shadow-sm items-center justify-center text-brand-blue">
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                      </svg>
                  </div>
              </div>

              <!-- Step 2 -->
              <div class="bg-white rounded-2xl md:rounded-3xl p-5 lg:p-6 border border-gray-100 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.03)] hover:shadow-lg hover:border-purple-100 transition-all duration-300 relative z-10 flex flex-col items-start text-left group">
                  <!-- Step Badge 02 -->
                  <div class="w-7 h-7 rounded-full bg-blue-50 text-brand-blue flex items-center justify-center text-[11px] font-bold border border-blue-100 mb-3 shadow-xs">
                      02
                  </div>

                  <!-- Squircle Icon -->
                  <div class="w-11 h-11 mb-3 bg-purple-50/90 rounded-xl flex items-center justify-center text-purple-600 group-hover:scale-105 transition-transform border border-purple-100/50">
                      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                      </svg>
                  </div>

                  <!-- Content (Left Aligned) -->
                  <h3 class="font-bold text-gray-900 text-lg mb-1 text-left">Set a Password</h3>
                  <p class="text-gray-500 text-xs sm:text-sm leading-relaxed text-left">Type a secure password to lock your items.</p>

                  <!-- Arrow to next step (Desktop) -->
                  <div class="hidden md:flex absolute -right-4 top-1/2 -translate-y-1/2 z-20 w-8 h-8 rounded-full bg-white border border-blue-100 shadow-sm items-center justify-center text-brand-blue">
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                      </svg>
                  </div>
              </div>

              <!-- Step 3 -->
              <div class="bg-white rounded-2xl md:rounded-3xl p-5 lg:p-6 border border-gray-100 shadow-[0_4px_20px_-4px_rgba(0,0,0,0.03)] hover:shadow-lg hover:border-green-100 transition-all duration-300 relative z-10 flex flex-col items-start text-left group">
                  <!-- Step Badge 03 -->
                  <div class="w-7 h-7 rounded-full bg-blue-50 text-brand-blue flex items-center justify-center text-[11px] font-bold border border-blue-100 mb-3 shadow-xs">
                      03
                  </div>

                  <!-- Squircle Icon -->
                  <div class="w-11 h-11 mb-3 bg-green-50/90 rounded-xl flex items-center justify-center text-green-500 group-hover:scale-105 transition-transform border border-green-100/50">
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M7 3h7l5 5v13a2 2 0 01-2 2H7a2 2 0 01-2-2V5a2 2 0 012-2zm6 1.5V9h4.5L13 4.5z"/><path d="M9 13h6l-3 4z"/><path d="M11 9h2v4h-2z"/>
                      </svg>
                  </div>

                  <!-- Content (Left Aligned) -->
                  <h3 class="font-bold text-gray-900 text-lg mb-1 text-left">Save It</h3>
                  <p class="text-gray-500 text-xs sm:text-sm leading-relaxed text-left">Download your protected file and share it anywhere.</p>
              </div>
          </div>
      </div>
  </section>

  <!-- WHY USE FILELOCKER -->
  <section class="w-full bg-white py-24 overflow-hidden">
      <div class="max-w-[1200px] mx-auto px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
          <!-- Left: Text & Features Grid -->
          <div>
              <h3 class="text-brand-blue font-bold text-[11px] tracking-wider uppercase mb-3">Why FileLocker</h3>
              <h2 class="text-4xl md:text-[2.75rem] leading-[1.1] font-extrabold text-gray-900 mb-4 tracking-tight">A 100% Client-Side File Locker: Zero Cloud Uploads</h2>
              <p class="text-gray-600 text-lg md:text-[17px] mb-12 max-w-md leading-relaxed">
                  A fast and easy way to password protect your files without installing any software.
              </p>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
                  <!-- Feature 1 -->
                  <div class="bg-white border border-gray-100/90 py-3 px-4 rounded-xl sm:rounded-2xl flex flex-col justify-center shadow-xs hover:shadow-md hover:border-gray-200 transition-all">
                      <div class="flex items-center gap-3 mb-1">
                          <div class="w-8 h-8 rounded-full bg-orange-50 flex items-center justify-center flex-shrink-0 text-orange-500">
                              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                          </div>
                          <h4 class="font-bold text-gray-900 text-[14px] sm:text-[15px]">No Installation</h4>
                      </div>
                      <p class="text-xs sm:text-[13px] text-gray-500 pl-11 leading-normal">Works directly in your browser.</p>
                  </div>
                  <!-- Feature 2 -->
                  <div class="bg-white border border-gray-100/90 py-3 px-4 rounded-xl sm:rounded-2xl flex flex-col justify-center shadow-xs hover:shadow-md hover:border-gray-200 transition-all">
                      <div class="flex items-center gap-3 mb-1">
                          <div class="w-8 h-8 rounded-full bg-blue-50 flex items-center justify-center flex-shrink-0 text-brand-blue">
                              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                          </div>
                          <h4 class="font-bold text-gray-900 text-[14px] sm:text-[15px]">No Account</h4>
                      </div>
                      <p class="text-xs sm:text-[13px] text-gray-500 pl-11 leading-normal">No sign up or personal data.</p>
                  </div>
                  <!-- Feature 3 -->
                  <div class="bg-white border border-gray-100/90 py-3 px-4 rounded-xl sm:rounded-2xl flex flex-col justify-center shadow-xs hover:shadow-md hover:border-gray-200 transition-all">
                      <div class="flex items-center gap-3 mb-1">
                          <div class="w-8 h-8 rounded-full bg-green-50 flex items-center justify-center flex-shrink-0 text-green-500">
                              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
                          </div>
                          <h4 class="font-bold text-gray-900 text-[14px] sm:text-[15px]">Your Files Stay on Device</h4>
                      </div>
                      <p class="text-xs sm:text-[13px] text-gray-500 pl-11 leading-normal">Processed locally in your browser.</p>
                  </div>
                  <!-- Feature 4 -->
                  <div class="bg-white border border-gray-100/90 py-3 px-4 rounded-xl sm:rounded-2xl flex flex-col justify-center shadow-xs hover:shadow-md hover:border-gray-200 transition-all">
                      <div class="flex items-center gap-3 mb-1">
                          <div class="w-8 h-8 rounded-full bg-purple-50 flex items-center justify-center flex-shrink-0 text-purple-500">
                              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20 6h-2.18c.11-.31.18-.65.18-1 0-1.66-1.34-3-3-3-1.05 0-1.96.54-2.5 1.35l-.5.67-.5-.68C10.96 2.54 10.05 2 9 2 7.34 2 6 3.34 6 5c0 .35.07.69.18 1H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-5-2c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zM9 4c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zm11 15H4v-2h16v2zm0-5H4V8h5.08L7 10.83 8.62 12 11 8.76 12 7.4l1 1.36L15.38 12 17 10.83 14.92 8H20v6z"/></svg>
                          </div>
                          <h4 class="font-bold text-gray-900 text-[14px] sm:text-[15px]">Completely Free</h4>
                      </div>
                      <p class="text-xs sm:text-[13px] text-gray-500 pl-11 leading-normal">Use it as much as you want.</p>
                  </div>
              </div>
          </div>

          <!-- Right: Illustration -->
          <div class="relative w-full h-[450px] flex items-center justify-center">
              <!-- Background shapes -->
              <!-- Orange blob -->
              <div class="absolute -left-6 top-12 w-[260px] h-[280px] bg-gradient-to-br from-[#fff0e6] to-[#ffe0cc] rounded-[45%_55%_65%_35%/45%_50%_65%_55%] transform -rotate-12 pointer-events-none"></div>
              
              <!-- Purple blob -->
              <div class="absolute -right-12 bottom-12 w-[240px] h-[260px] bg-gradient-to-br from-[#efe8ff] to-[#ddd0ff] rounded-[60%_40%_30%_70%/60%_30%_70%_40%] transform rotate-12 pointer-events-none"></div>
              
              <!-- Floating sphere -->
              <div class="absolute top-2 right-8 w-11 h-11 bg-gradient-to-br from-[#f0ebff] to-[#dbccff] rounded-full shadow-[inset_0_-3px_8px_rgba(0,0,0,0.06),0_10px_20px_rgba(0,0,0,0.05)] pointer-events-none"></div>
              
              <!-- Window Mockup -->
              <div class="relative w-full max-w-[460px] bg-[#f8fafc] rounded-[1.5rem] shadow-[0_20px_60px_-15px_rgba(0,0,0,0.15)] border border-gray-200 overflow-hidden transform rotate-2 transition-transform hover:rotate-0">
                  <!-- Browser Header -->
                  <div class="h-14 border-b border-gray-200 bg-white px-5 flex items-center justify-between">
                      <div class="flex items-center gap-1.5">
                          <div class="w-3 h-3 rounded-full bg-[#ff5f56]"></div>
                          <div class="w-3 h-3 rounded-full bg-[#ffbd2e]"></div>
                          <div class="w-3 h-3 rounded-full bg-[#27c93f]"></div>
                      </div>
                      <div class="flex items-center">
                          <img src="/filelocker-logo-main.svg" alt="FileLocker" class="h-5.5 w-auto" />
                      </div>
                      <div class="flex items-center gap-3 text-gray-400">
                          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                      </div>
                  </div>
                  <!-- Content -->
