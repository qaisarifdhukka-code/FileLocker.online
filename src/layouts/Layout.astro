                    <span>Protect</span>
                    <span class="w-7 h-7 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 transition-transform duration-200 accordion-arrow">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M19 9l-7 7-7-7" />
                        </svg>
                    </span>
                </button>
                <div id="accordion-protect" class="hidden pl-3 pt-2 pb-1 space-y-2">
                    <a href="/lock-file/" class="mobile-nav-link block text-sm font-medium text-slate-600 hover:text-brand-blue py-1.5">
                        Password Protect a File
                    </a>
                    <a href="/lock-folder/" class="mobile-nav-link block text-sm font-medium text-slate-600 hover:text-brand-blue py-1.5">
                        Password Protect a Folder
                    </a>
                </div>
            </div>

            <!-- Unlock Link (Direct Page Navigation) -->
            <div class="py-2.5">
                <a href="/unlock-file/" class="mobile-nav-link flex items-center justify-between text-[17px] font-semibold text-slate-800 hover:text-brand-blue py-2 transition-colors group">
