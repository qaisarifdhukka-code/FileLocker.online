---
import Layout from '../layouts/Layout.astro';
import ProvisioningApp from '../components/ProvisioningApp';

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "FileLocker — Folder Protection Tool",
  "url": "https://filelocker.online/lock-folder/",
  "applicationCategory": "SecurityApplication",
  "operatingSystem": "Browsers with File System Access API support",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Free browser-based tool to password protect and encrypt entire folders with a single password. Files are processed locally without server uploads or software installation."
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Password Protect a Folder Online",
  "description": "Learn how to password protect an entire folder directly in your browser without software or server uploads.",
  "step": [
    {
      "@type": "HowToStep",
      "name": "Select Your Folder",
      "text": "Click the folder selection box and pick any directory from your computer. FileLocker reads the contents locally without uploading anything."
    },
    {
      "@type": "HowToStep",
      "name": "Enter a Strong Password",
      "text": "Choose a secure password. FileLocker uses this to derive an authenticated AES-GCM encryption key."
    },
    {
      "@type": "HowToStep",
      "name": "Save the Protected .vault File",
      "text": "FileLocker packages the directory structure into an encrypted .vault container saved directly to your device."
    }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://filelocker.online/" },
    { "@type": "ListItem", "position": 2, "name": "Tools", "item": "https://filelocker.online/" },
    { "@type": "ListItem", "position": 3, "name": "Lock Folder", "item": "https://filelocker.online/lock-folder/" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I password protect a folder?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Select your folder using the FileLocker tool, set a password, and click to protect. FileLocker packages all folder contents and encrypts them locally, saving a single .vault file to your device."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need to create a ZIP file first?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. FileLocker handles the packaging automatically. When you select a folder, FileLocker streams all its contents through an encryption pipeline and produces a single .vault file, preserving the original folder structure."
      }
    },
    {
      "@type": "Question",
      "name": "Will my folder structure be preserved when I unlock?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. When you unlock a .vault file that was created from a folder, FileLocker restores the original folder structure and all file names exactly as they were."
      }
    },
    {
      "@type": "Question",
      "name": "Is there a limit on how many files I can protect in a folder?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "FileLocker processes folder contents using a streaming approach. The practical number of files depends on browser support, available storage, device resources, and the size and number of files in the folder."
      }
    }
  ]
};
---

<Layout 
  title="Password Protect a Folder Online Free | FileLocker"
  description="Password protect a folder online for free with FileLocker. Encrypt entire directories in your browser—zero uploads, no software, and 100% private."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(howToSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <!-- HERO -->
  <div class="guide-hero" style="padding-bottom:2rem;">
    <div class="hero-shape hero-shape-1"></div>
    <div class="hero-shape hero-shape-2"></div>
    <div class="hero-inner" style="text-align:center; max-width:40rem;">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-50 border border-blue-100 text-brand-blue text-xs font-bold uppercase tracking-wider mb-5">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
        Free · No uploads · No account
      </span>
      <h1>Password Protect a Folder Online</h1>
      <p class="hero-subtitle" style="margin:0 auto;">Secure all your folder contents with a single password — processed entirely on your device, no uploads required.</p>
    </div>
  </div>

  <div class="w-full bg-white border-b border-gray-100 py-8 px-4 sm:px-6 flex items-center justify-center">
    <div class="w-full max-w-2xl mx-auto bg-white rounded-[2rem] border border-gray-100 shadow-[0_8px_40px_rgba(0,0,0,0.07)] overflow-hidden">
      <ProvisioningApp client:load initialMode="folder" hideHeader={true} />
      <div class="text-center py-3.5 bg-gray-50 border-t border-gray-100 text-[12px] text-gray-400 font-medium flex items-center justify-center gap-1.5">
        <svg class="w-3.5 h-3.5 text-brand-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
        Your files are processed locally. Nothing is uploaded.
      </div>
    </div>
  </div>

  <!-- SEO CONTENT -->
  <section class="w-full bg-white py-12 px-6">
    <div class="max-w-5xl mx-auto">

      <div class="content-card animate-fade-in-up">
        <div class="flex items-center gap-3 mb-4">
          <span class="inline-flex items-center rounded-full bg-blue-50 px-3 py-1 text-xs font-bold uppercase tracking-wide text-brand-blue">Step-by-step tutorial</span>
        </div>
        <h2 class="section-heading">How to Password Protect a Folder Online</h2>
        <div class="prose max-w-none">
          <p>
            When you need to <strong>password protect a folder online</strong> without installing complex archive software like 7-Zip or VeraCrypt, FileLocker provides a zero-install, browser-based solution. Unlike standard web tools, your folder contents are never uploaded to any cloud server.
          </p>
        </div>
        
        <ol class="steps-grid" style="margin-top:1.5rem;">
          <li class="step-card">
            <span class="step-number">1</span>
            <strong>Select your folder</strong>
            <span>Click the folder box above and pick your folder. FileLocker reads the directory structure locally through the browser File System API.</span>
          </li>
          <li class="step-card">
            <span class="step-number">2</span>
            <strong>Set a strong password</strong>
            <span>Create a master password. FileLocker uses PBKDF2 key derivation and military-grade AES-GCM 256-bit encryption.</span>
          </li>
          <li class="step-card">
            <span class="step-number">3</span>
            <strong>Save your encrypted .vault file</strong>
            <span>Download the resulting <code>.vault</code> container. All subfolders and nested files remain intact and tamper-proof.</span>
          </li>
        </ol>
        
        <div class="callout callout-info" style="margin-top:1.5rem;">
          <p>
            Need to open your protected folder later? Open the <a href="/unlock-file/" class="font-semibold text-brand-blue hover:underline">FileLocker Unlock Tool</a>. For individual files, use our <a href="/lock-file/" class="font-semibold text-brand-blue hover:underline">file protection tool</a>. Looking for Windows 11 or Mac tutorials? Read our full guide on <a href="/guides/how-to-password-protect-a-folder/" class="font-semibold text-brand-blue hover:underline">how to password protect a folder</a> or our <a href="/guides/how-to-password-protect-files/" class="font-semibold text-brand-blue hover:underline">master file protection guide</a>.
          </p>
        </div>
      </div>

      <div class="content-card animate-fade-in-up animate-delay-1">
        <h2 class="section-heading">Why Password Protect a Folder Online with FileLocker?</h2>
        <div class="feature-grid">
          <div class="feature-card">
            <div class="feature-icon" style="background:#f0fdf4;">
              <svg class="w-6 h-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            </div>
            <h3>No ZIP File Needed</h3>
            <p>You do not need to manually create a ZIP archive first. FileLocker handles the packaging automatically when you select a folder. (If you prefer ZIP archives, see our <a href="/guides/password-protect-zip/" class="text-brand-blue font-semibold hover:underline">ZIP protection guide</a>).</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon" style="background:#eff6ff;">
              <svg class="w-6 h-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" /></svg>
            </div>
            <h3>Structure Preserved</h3>
            <p>When unlocked, the original folder structure, directory hierarchy, and all file names are restored exactly as they were when you protected the folder.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon" style="background:#faf5ff;">
              <svg class="w-6 h-6 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
            </div>
            <h3>Zero Cloud Uploads</h3>
            <p>Even if your folder contains gigabytes of confidential documents, everything is processed locally on your device via the Web Crypto API. Nothing is uploaded.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon" style="background:#fefce8;">
              <svg class="w-6 h-6 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" /></svg>
            </div>
            <h3>One Master Password</h3>
            <p>Protect your entire folder with a single password, regardless of how many hundreds of files or subdirectories it contains.</p>
          </div>
        </div>
      </div>

      <div class="content-card animate-fade-in-up animate-delay-2">
        <h2 class="section-heading">Frequently Asked Questions</h2>
        <div class="faq-grid">
          <div class="faq-item">
            <h3>How do I password protect a folder?</h3>
            <p>Select your folder using the FileLocker tool above, set a password, and click to protect. FileLocker packages all folder contents and encrypts them locally, saving a single <code>.vault</code> file.</p>
          </div>
          <div class="faq-item">
            <h3>Do I need to create a ZIP file first?</h3>
            <p>No. FileLocker handles the packaging automatically. When you select a folder, FileLocker streams all its contents through an encryption pipeline and produces a single <code>.vault</code> file, preserving your original folder structure.</p>
          </div>
          <div class="faq-item">
            <h3>Will my folder structure be preserved when I unlock?</h3>
            <p>Yes. When you unlock a <code>.vault</code> file created from a folder, FileLocker restores the original folder structure and all file names exactly as they were.</p>
          </div>
          <div class="faq-item">
            <h3>Is there a limit on how many files I can protect in a folder?</h3>
            <p>FileLocker processes folder contents using a streaming approach. The practical number of files depends on browser support, available storage, device resources, and the size and number of files in the folder.</p>
          </div>
        </div>
      </div>

      <div class="callout callout-info">
        <p>Protecting individual files instead? <a href="/lock-file/" class="font-semibold text-brand-blue hover:underline">Use the individual file protection tool →</a> or explore our <a href="/guides/" class="font-semibold text-brand-blue hover:underline">file protection guides</a>.</p>
      </div>

    </div>
  </section>
</Layout>
