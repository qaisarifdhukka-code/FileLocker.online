---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Contact Us | FileLocker Online" 
  description="Get in touch with the FileLocker team for support, business inquiries, or questions."
>
  <div class="w-full bg-[#f8fafc] min-h-screen py-16 px-6">
    <div class="max-w-3xl mx-auto bg-white rounded-3xl p-8 md:p-12 shadow-sm border border-gray-100">
      <h1 class="text-4xl font-extrabold text-gray-900 mb-6 tracking-tight">Contact Us</h1>
      <p class="text-lg text-gray-500 mb-10">We'd love to hear from you. Please reach out with any questions, feedback, or support requests.</p>
      
      <div class="space-y-8">
        <div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">General Support</h3>
          <p class="text-gray-600 mb-2">For general questions about how to use FileLocker, please check our <a href="/faq" class="text-brand-blue hover:underline">FAQ page</a> first.</p>
          <p class="text-gray-600">If you still need help, email us at: <a href="mailto:support@filelocker.online" class="text-brand-blue font-medium hover:underline">support@filelocker.online</a></p>
        </div>

        <div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Password Recovery</h3>
          <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 rounded-r-md">
            <p class="text-yellow-800 font-medium text-sm">
              Please note: Because FileLocker processes everything locally on your device, we DO NOT have access to your passwords. We cannot recover, reset, or bypass passwords for protected files under any circumstances.
            </p>
          </div>
        </div>

        <div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Business & Advertising</h3>
          <p class="text-gray-600">For advertising opportunities or business partnerships, please contact: <a href="mailto:business@filelocker.online" class="text-brand-blue font-medium hover:underline">business@filelocker.online</a></p>
        </div>
      </div>
    </div>
  </div>
</Layout>
