            <!-- Center: Navigation Links (Desktop) -->
            <div class="hidden md:flex items-center gap-1 lg:gap-2 text-sm font-medium text-slate-600">
                
                <!-- Protect Dropdown -->
                <div class="relative group py-1">
                    <button type="button" aria-haspopup="true" class="flex items-center gap-1.5 px-3 py-1.5 rounded-full hover:text-slate-900 hover:bg-slate-100/70 transition-all outline-none focus:ring-2 focus:ring-blue-500/20 cursor-pointer">
                        <span>Protect</span>
                        <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-slate-700 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M19 9l-7 7-7-7" />
                        </svg>
                    </button>
                    <!-- Popover Dropdown Card -->
                    <div class="absolute top-full left-0 pt-2 w-72 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200 transform origin-top -translate-y-1 group-hover:translate-y-0">
                        <div class="bg-white/95 backdrop-blur-xl border border-slate-200/80 shadow-[0_20px_50px_rgba(15,23,42,0.12)] rounded-2xl p-2 flex flex-col gap-1">
                            <a href="/lock-file/" class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-50 transition-colors group/item">
                                <div class="w-9 h-9 rounded-lg bg-blue-50 text-brand-blue flex items-center justify-center flex-shrink-0 group-hover/item:bg-blue-600 group-hover/item:text-white transition-colors">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                    </svg>
                                </div>
                                <div class="flex flex-col">
                                    <span class="text-xs font-semibold text-slate-900 group-hover/item:text-brand-blue transition-colors">Protect a File</span>
                                    <span class="text-[11px] text-slate-500 font-normal">Encrypt single files with AES-256</span>
                                </div>
                            </a>
                            <a href="/lock-folder/" class="flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-50 transition-colors group/item">
                                <div class="w-9 h-9 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center flex-shrink-0 group-hover/item:bg-indigo-600 group-hover/item:text-white transition-colors">
                                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
                                    </svg>
                                </div>
                                <div class="flex flex-col">
