---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Contact FileLocker | File Protection Support" 
  description="Contact FileLocker with questions about password protecting files and folders, browser-based processing, or using the FileLocker tools."
>
  <!-- HERO -->
  <div class="guide-hero">
    <div class="hero-shape hero-shape-1"></div>
    <div class="hero-shape hero-shape-2"></div>
    <div class="hero-inner" style="text-align:center; max-width:40rem;">
      <h1>Contact FileLocker Support</h1>
      <p class="hero-subtitle" style="margin:0 auto;">
        We'd love to hear from you. Please reach out with any questions, feedback, or support requests.
      </p>
    </div>
  </div>

  <!-- MAIN CONTENT -->
  <div class="w-full bg-[#f8fafc] py-16 px-6">
    <div class="max-w-3xl mx-auto">

      <div class="content-card animate-fade-in-up flex flex-col gap-8 divide-y divide-gray-100">
        
        <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 pt-2">
          <div class="flex-shrink-0 w-14 h-14 bg-blue-50 rounded-[1rem] flex items-center justify-center">
            <svg class="w-7 h-7 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          </div>
          <div>
            <h2 class="text-xl font-bold text-gray-900 mb-2 mt-1">General FileLocker Support</h2>
            <p class="text-gray-600 leading-relaxed max-w-xl">For general questions about how to use FileLocker, please check our <a href="/faq/" class="text-brand-blue hover:underline font-medium">FAQ page</a> first.</p>
            <p class="text-gray-600 mt-2">If you still need help, email us at: <a href="mailto:support@filelocker.online" class="text-brand-blue font-medium hover:underline">support@filelocker.online</a></p>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 pt-8">
          <div class="flex-shrink-0 w-14 h-14 bg-yellow-50 rounded-[1rem] flex items-center justify-center">
            <svg class="w-7 h-7 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
          </div>
          <div>
            <h2 class="text-xl font-bold text-gray-900 mb-4 mt-1">Password Recovery Questions</h2>
            <div class="callout callout-warning !mt-0 shadow-sm border border-yellow-100">
              <p class="text-gray-800 m-0">
                <strong>Please note:</strong> Because FileLocker processes everything locally on your device, we DO NOT have access to your passwords. We cannot recover, reset, or bypass passwords for protected files under any circumstances.
              </p>
            </div>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 pt-8 pb-2">
          <div class="flex-shrink-0 w-14 h-14 bg-purple-50 rounded-[1rem] flex items-center justify-center">
            <svg class="w-7 h-7 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          </div>
          <div>
            <h2 class="text-xl font-bold text-gray-900 mb-2 mt-1">Business & Advertising</h2>
            <p class="text-gray-600 leading-relaxed">For advertising opportunities or business partnerships, please contact: <br><a href="mailto:business@filelocker.online" class="text-brand-blue font-medium hover:underline inline-block mt-1">business@filelocker.online</a></p>
          </div>
        </div>

      </div>

    </div>
  </div>
</Layout>
