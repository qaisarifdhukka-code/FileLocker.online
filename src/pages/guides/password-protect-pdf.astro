---
import Layout from '../../layouts/Layout.astro';

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Password Protect a PDF File",
  "description": "Password protect any PDF file for free using FileLocker's browser-based encryption tool.",
  "step": [
    {
      "@type": "HowToStep",
      "name": "Open the FileLocker Tool",
      "text": "Go to the free File Protection tool at filelocker.online/lock-file."
    },
    {
      "@type": "HowToStep",
      "name": "Select your PDF",
      "text": "Click to upload and select the PDF document you want to protect from your device."
    },
    {
      "@type": "HowToStep",
      "name": "Create a Strong Password",
      "text": "Enter a password that only you and the intended recipient will know. Do not forget this password â€” it cannot be recovered."
    },
    {
      "@type": "HowToStep",
      "name": "Save the .vault File",
      "text": "Click to protect. FileLocker encrypts the PDF and saves it as a .vault file to your device."
    }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Can I password protect a PDF for free?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. FileLocker provides free, browser-based PDF protection using AES-GCM encryption. No subscription or account is required."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need Adobe Acrobat to password protect a PDF?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Adobe Acrobat is one option, but FileLocker lets you protect any PDF file for free directly in your browser without an Adobe subscription."
      }
    },
    {
      "@type": "Question",
      "name": "Is my PDF uploaded to a server?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. FileLocker processes your PDF entirely on your device using local JavaScript. Your file is never uploaded to a server."
      }
    },
    {
      "@type": "Question",
      "name": "Can the recipient open my protected PDF without FileLocker?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. A FileLocker-protected PDF is saved as a .vault file, which requires the FileLocker unlock tool and the correct password to open. Share the password with your recipient separately."
      }
    }
  ]
};
---

<Layout 
  title="How to Password Protect a PDF File for Free | FileLocker"
  description="Learn how to password protect a PDF file for free in your browser. No Adobe Acrobat subscription required â€” AES-GCM encryption, no server uploads."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(howToSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <div class="w-full bg-[#f8fafc] min-h-screen py-16 px-6">
    <div class="max-w-3xl mx-auto">
      
      <!-- Breadcrumbs -->
      <nav class="flex text-sm text-gray-500 mb-8 font-medium">
        <a href="/guides" class="hover:text-brand-blue">Guides</a>
        <span class="mx-2">/</span>
        <span class="text-gray-900">Protect a PDF</span>
      </nav>

      <div class="bg-white rounded-3xl p-8 md:p-12 shadow-sm border border-gray-100">
        
        <h1 class="text-3xl md:text-4xl font-extrabold text-gray-900 mb-6 leading-tight">How to Password Protect a PDF File for Free</h1>
        
        <div class="prose prose-lg max-w-none text-gray-600">
          <p class="lead text-xl text-gray-500 mb-8">
            Need to send a sensitive tax document, medical record, or legal contract as a PDF? If you've tried using Adobe Acrobat, you probably noticed that password protection is locked behind an expensive monthly subscription.
          </p>

          <p>
            Fortunately, you don't need expensive software to secure your PDF files. FileLocker uses AES-GCM encryption to protect any PDF directly in your web browser, completely for free.
          </p>

          <div class="bg-blue-50 border border-blue-100 rounded-2xl p-6 my-8">
            <h3 class="text-lg font-bold text-gray-900 mt-0 mb-2 flex items-center gap-2">
              <svg class="w-5 h-5 text-brand-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              Privacy First
            </h3>
            <p class="m-0 text-sm">
              Because FileLocker processes your PDF using JavaScript directly on your device, your sensitive document is <strong>never uploaded to our servers</strong>. Your document is processed entirely on your device.
            </p>
          </div>

          <h2 class="text-2xl font-bold text-gray-900 mt-12 mb-6">Step-by-Step Guide</h2>
          
          <ol class="space-y-6 list-decimal list-outside ml-6 font-medium text-gray-900">
            <li>
              <strong>Open the FileLocker Tool</strong><br/>
              <span class="text-gray-600 font-normal">Go to our free <a href="/lock-file" class="text-brand-blue hover:underline">File Protection tool</a>.</span>
            </li>
            <li>
              <strong>Select your PDF</strong><br/>
              <span class="text-gray-600 font-normal">Click "Upload from PC or Mobile" and select the PDF document you want to protect.</span>
            </li>
            <li>
              <strong>Create a Strong Password</strong><br/>
              <span class="text-gray-600 font-normal">Enter a password that only you and the intended recipient will know. <em>Do not forget this password, as it cannot be recovered!</em></span>
            </li>
            <li>
              <strong>Save the .vault File</strong><br/>
              <span class="text-gray-600 font-normal">Click "Lock &amp; Save File". FileLocker will encrypt the PDF and save it as a <code>.vault</code> file to your device.</span>
            </li>
          </ol>

          <h2 class="text-2xl font-bold text-gray-900 mt-12 mb-6">How do I open it later?</h2>
          <p>
            When your recipient receives the <code>.vault</code> file (via email, WhatsApp, or cloud storage), they simply go to the <a href="/unlock-file" class="text-brand-blue hover:underline">Unlock Tool</a>, select the file, enter the password you gave them, and it instantly restores the original, readable PDF document.
          </p>

          <h2 class="text-2xl font-bold text-gray-900 mt-12 mb-6">Alternatives to FileLocker for PDFs</h2>
          <p>FileLocker is not the only way to password protect a PDF. Here are common alternatives:</p>
          <ul>
            <li><strong>Adobe Acrobat:</strong> Adobe's native password protection is built directly into the PDF format and is supported by most PDF readers. However, it requires an Adobe Acrobat subscription for most protection features.</li>
            <li><strong>Microsoft Word / LibreOffice:</strong> If you are starting from a Word document, both Microsoft Word and LibreOffice can export password-protected PDFs.</li>
            <li><strong>macOS Preview:</strong> On a Mac, you can add a password to a PDF directly from the Preview app when exporting.</li>
          </ul>
          <p>The main advantage of FileLocker over these alternatives is that it is free, works for any PDF regardless of how it was created, and processes your file entirely on your device.</p>

        </div>

        <div class="mt-12 space-y-4">
          <h2 class="text-2xl font-bold text-gray-900">Frequently Asked Questions</h2>
          <div class="space-y-4 mt-6">
            <div class="bg-gray-50 p-6 rounded-2xl border border-gray-100">
              <h3 class="font-bold text-gray-900 text-lg mb-2">Can I password protect a PDF for free?</h3>
              <p class="text-gray-600">Yes. FileLocker provides free, browser-based PDF protection using AES-GCM encryption. No subscription or account is required.</p>
            </div>
            <div class="bg-gray-50 p-6 rounded-2xl border border-gray-100">
              <h3 class="font-bold text-gray-900 text-lg mb-2">Do I need Adobe Acrobat to password protect a PDF?</h3>
              <p class="text-gray-600">No. Adobe Acrobat is one option, but FileLocker lets you protect any PDF file for free directly in your browser without an Adobe subscription.</p>
            </div>
            <div class="bg-gray-50 p-6 rounded-2xl border border-gray-100">
              <h3 class="font-bold text-gray-900 text-lg mb-2">Is my PDF uploaded to a server?</h3>
              <p class="text-gray-600">No. FileLocker processes your PDF entirely on your device. Your file is never uploaded to a server.</p>
            </div>
            <div class="bg-gray-50 p-6 rounded-2xl border border-gray-100">
              <h3 class="font-bold text-gray-900 text-lg mb-2">Can the recipient open my protected PDF without FileLocker?</h3>
              <p class="text-gray-600">No. A FileLocker-protected PDF is saved as a <code>.vault</code> file, which requires the FileLocker unlock tool and the correct password to open.</p>
            </div>
          </div>
        </div>

        <div class="mt-12 text-center border-t border-gray-100 pt-10">
          <a href="/lock-file" class="bg-brand-blue hover:bg-brand-blue-dark text-white font-bold py-4 px-10 rounded-full shadow-lg transition-transform hover:scale-105 active:scale-95 inline-block text-lg">
            Protect a PDF Now
          </a>
        </div>

      </div>
    </div>
  </div>
</Layout>

