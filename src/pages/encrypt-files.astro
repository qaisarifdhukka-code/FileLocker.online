---
import Layout from '../layouts/Layout.astro';
import ProvisioningApp from '../components/ProvisioningApp';

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "FileLocker — Free File Encryption Online",
  "url": "https://filelocker.online/encrypt-files/",
  "applicationCategory": "SecurityApplication",
  "operatingSystem": "All modern browsers (Windows, macOS, Linux, iOS, Android)",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Encrypt files online for free directly in your browser. 100% private AES-GCM 256-bit client-side encryption. Zero server uploads, zero accounts."
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Encrypt Files Online for Free",
  "description": "Learn how to encrypt files online for free using FileLocker's in-browser AES-256 cryptographic tool.",
  "totalTime": "PT1M",
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Select Your File",
      "text": "Drag and drop any file into the FileLocker encryption dropzone. Your file stays inside your browser sandbox; nothing is uploaded to remote servers."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Set Encryption Password",
      "text": "Enter a strong password. FileLocker derives an authenticated 256-bit encryption key using memory-hard Argon2id."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Download Encrypted File",
      "text": "Click 'Lock File'. Your browser encrypts the data locally with AES-GCM 256-bit and exports a secure .vault file."
    }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://filelocker.online/" },
    { "@type": "ListItem", "position": 2, "name": "Tools", "item": "https://filelocker.online/" },
    { "@type": "ListItem", "position": 3, "name": "Encrypt Files", "item": "https://filelocker.online/encrypt-files/" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I encrypt files online for free?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can encrypt files online for free using FileLocker. Simply select your file in the tool above, enter a password, and download the encrypted .vault container. Unlike cloud upload tools, all encryption runs 100% locally on your device via the Web Crypto API."
      }
    },
    {
      "@type": "Question",
      "name": "Are my files uploaded to your servers during encryption?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Zero bytes of your files or passwords are ever sent to FileLocker servers or any third-party infrastructure. All cryptographic processing occurs directly in your browser memory."
      }
    },
    {
      "@type": "Question",
      "name": "What encryption standard does FileLocker use?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "FileLocker uses authenticated AES-GCM (Galois/Counter Mode) with 256-bit keys, combined with Argon2id key derivation using 64MB of memory and 3 passes to prevent GPU brute-force attacks."
      }
    },
    {
      "@type": "Question",
      "name": "How do I decrypt and open an encrypted file?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To decrypt a file, open filelocker.online/unlock-file/ in any web browser on any device, select the .vault file, enter your password, and download the decrypted original file."
      }
    },
    {
      "@type": "Question",
      "name": "Can I encrypt entire folders?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Use our dedicated Folder Encryption Tool at /lock-folder/ to encrypt entire directory trees with all nested subdirectories into a single container."
      }
    },
    {
      "@type": "Question",
      "name": "Is online file encryption as secure as desktop software?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. FileLocker utilizes the native browser Web Crypto API, which is implemented in compiled C++ directly by browser vendors (Google, Apple, Mozilla). It uses the exact same underlying NIST-approved AES-GCM and Argon2id primitives as desktop encryption tools like VeraCrypt and BitLocker."
      }
    }
  ]
};
---

<Layout
  title="Encrypt Files Online Free (AES-256) | FileLocker"
  description="Encrypt files online for free directly in your browser. 100% private AES-GCM 256-bit client-side encryption. Zero server uploads, zero accounts, and zero logs."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(howToSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <!-- HERO -->
  <div class="guide-hero" style="padding-bottom:2rem;">
    <div class="hero-shape hero-shape-1"></div>
    <div class="hero-shape hero-shape-2"></div>
    <div class="hero-shape hero-shape-3"></div>
    <div class="hero-inner" style="text-align:center; max-width:44rem;">
      <nav class="hero-breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span class="current">Encrypt Files</span>
      </nav>
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-50 border border-blue-100 text-brand-blue text-xs font-bold uppercase tracking-wider mb-5">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C9.243 2 7 4.243 7 7v3H6c-1.103 0-2 .897-2 2v8c0 1.103.897 2 2 2h12c1.103 0 2-.897 2-2v-8c0-1.103-.897-2-2-2h-1V7c0-2.757-2.243-5-5-5zm0 2c1.654 0 3 1.346 3 3v3H9V7c0-1.654 1.346-3 3-3z"/></svg>
        AES-GCM 256-bit · 100% Client-Side · Zero Uploads
      </span>
      <h1>Encrypt Files Online Free</h1>
      <p class="hero-subtitle" style="margin:0 auto;">
        Secure documents, spreadsheets, PDFs, photos, and archives directly in your browser. Military-grade client-side encryption with zero server exposure.
      </p>
    </div>
  </div>

  <!-- INTERACTIVE EMBEDDED TOOL DROPZONE -->
  <div class="w-full bg-[#f8fafc] border-b border-gray-200/80 py-8 px-4 sm:px-6 flex items-center justify-center">
    <div class="w-full max-w-2xl mx-auto bg-white rounded-[2rem] border border-gray-200/80 shadow-[0_12px_45px_rgba(0,0,0,0.06)] overflow-hidden">
      <div class="bg-gradient-to-r from-blue-600 to-indigo-600 px-6 py-4 text-white flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <span class="p-1.5 bg-white/20 rounded-lg text-white">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
          </span>
          <span class="font-bold text-sm sm:text-base">In-Browser File Encryption</span>
        </div>
        <span class="text-xs bg-white/15 px-2.5 py-1 rounded-full font-medium">Free &amp; Unlimited</span>
      </div>

      <div class="p-4 sm:p-6">
        <ProvisioningApp client:load initialMode="file" hideHeader={true} />
      </div>

      <div class="text-center py-3 bg-gray-50 border-t border-gray-100 text-[12px] text-gray-500 font-medium flex items-center justify-center gap-2">
        <svg class="w-3.5 h-3.5 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <span>Zero server uploads. Your file is encrypted locally in your browser memory.</span>
      </div>
    </div>
  </div>

  <!-- MAIN EDITORIAL CONTENT -->
  <div class="w-full bg-[#f8fafc] py-12 px-6">
    <div class="max-w-4xl mx-auto space-y-10">

      <!-- SECTION 1: WHAT FILE ENCRYPTION ACTUALLY MEANS -->
      <div class="content-card animate-fade-in-up">
        <div class="prose max-w-none text-gray-700 leading-relaxed">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">What Is File Encryption and Why Does It Matter?</h2>
          <p>
            File encryption transforms readable data (plaintext) into an unreadable mathematical scramble (ciphertext) using an encryption algorithm and a secret cryptographic key. Without the correct key, decrypting the data is mathematically infeasible—even for the world's most powerful supercomputers running for billions of years.
          </p>
          <p>
            Whether you are sending a confidential NDA, saving sensitive tax returns to cloud storage (Google Drive, Dropbox, OneDrive), or carrying proprietary company documents on a USB thumb drive, unencrypted files are perpetually exposed to interception, cloud server compromises, and unauthorized access.
          </p>
        </div>
      </div>

      <!-- SECTION 2: HOW FILELOCKER ENCRYPTS FILES (CRYPTOGRAPHIC DEEP-DIVE) -->
      <div class="content-card animate-fade-in-up">
        <div class="prose max-w-none text-gray-700 leading-relaxed">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 text-brand-blue text-xs font-bold uppercase tracking-wide mb-3">
            Cryptographic Architecture
          </div>
          <h2 class="text-2xl font-bold text-gray-900 mb-4">How FileLocker Encrypts Your Files Locally</h2>
          <p>
            Unlike traditional cloud conversion sites that force you to upload your confidential files to their remote servers, FileLocker executes 100% of its cryptographic operations <strong>directly on your machine</strong>:
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-6">
            <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200">
              <div class="w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center font-bold text-sm mb-3">1</div>
              <strong class="text-slate-900 font-bold block mb-1">Key Derivation with Argon2id</strong>
              <p class="text-xs text-slate-600 leading-relaxed mb-0">
                When you input a password, FileLocker derives a 256-bit key using <strong>Argon2id</strong> (winner of the Password Hashing Competition) with a 16-byte random salt and 64MB memory hardness. This prevents GPU and ASIC brute-force dictionary attacks.
              </p>
            </div>
            <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200">
              <div class="w-8 h-8 rounded-lg bg-indigo-600 text-white flex items-center justify-center font-bold text-sm mb-3">2</div>
              <strong class="text-slate-900 font-bold block mb-1">Authenticated AES-GCM 256-bit</strong>
              <p class="text-xs text-slate-600 leading-relaxed mb-0">
                Your file is encrypted using <strong>AES-GCM (Galois/Counter Mode)</strong>, standardizing on NIST SP 800-38D. GCM provides simultaneous confidentiality and tamper-proof cryptographic integrity via a 128-bit authentication tag.
              </p>
            </div>
          </div>

          <p>
            Because the keys and data are handled strictly within the browser's native Web Crypto API, your encryption keys and unencrypted data <strong>never touch a network socket</strong>.
          </p>
        </div>
      </div>

      <!-- SECTION 3: FORMATS SUPPORTED -->
      <div class="content-card animate-fade-in-up">
        <h2 class="section-heading">Supported File Types &amp; Formats</h2>
        <p class="text-gray-600 mb-6 text-sm">
          FileLocker encrypts any arbitrary binary data without requiring format-specific converters:
        </p>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 text-center">
          <div class="p-3.5 rounded-xl border border-gray-200 bg-white shadow-xs">
            <span class="font-bold text-gray-900 text-sm block">PDF Documents</span>
            <span class="text-xs text-gray-500">.pdf</span>
          </div>
          <div class="p-3.5 rounded-xl border border-gray-200 bg-white shadow-xs">
            <span class="font-bold text-gray-900 text-sm block">Excel Spreadsheets</span>
            <span class="text-xs text-gray-500">.xlsx, .xls, .csv</span>
          </div>
          <div class="p-3.5 rounded-xl border border-gray-200 bg-white shadow-xs">
            <span class="font-bold text-gray-900 text-sm block">Word Documents</span>
            <span class="text-xs text-gray-500">.docx, .doc, .rtf</span>
          </div>
          <div class="p-3.5 rounded-xl border border-gray-200 bg-white shadow-xs">
            <span class="font-bold text-gray-900 text-sm block">ZIP &amp; Archives</span>
            <span class="text-xs text-gray-500">.zip, .7z, .tar</span>
          </div>
          <div class="p-3.5 rounded-xl border border-gray-200 bg-white shadow-xs">
            <span class="font-bold text-gray-900 text-sm block">Photos &amp; Images</span>
            <span class="text-xs text-gray-500">.jpg, .png, .webp</span>
          </div>
          <div class="p-3.5 rounded-xl border border-gray-200 bg-white shadow-xs">
            <span class="font-bold text-gray-900 text-sm block">Videos &amp; Audio</span>
            <span class="text-xs text-gray-500">.mp4, .mov, .mp3</span>
          </div>
          <div class="p-3.5 rounded-xl border border-gray-200 bg-white shadow-xs">
            <span class="font-bold text-gray-900 text-sm block">Source Code</span>
            <span class="text-xs text-gray-500">.js, .py, .ts, .json</span>
          </div>
          <div class="p-3.5 rounded-xl border border-blue-200 bg-blue-50/50 shadow-xs">
            <a href="/lock-folder/" class="font-bold text-brand-blue text-sm block">Entire Folders</a>
            <span class="text-xs text-blue-600">Preserves directory trees</span>
          </div>
        </div>
      </div>

      <!-- SECTION 4: COMPARISON MATRIX -->
      <div class="content-card animate-fade-in-up">
        <h2 class="section-heading">How FileLocker Compares to Other File Encryption Tools</h2>
        <p class="text-gray-600 mb-6 text-sm">
          A transparent review of how client-side browser encryption stacks up against heavy desktop software and cloud upload services:
        </p>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs sm:text-sm border-collapse">
            <thead>
              <tr class="border-b border-gray-200 bg-gray-50 text-gray-900">
                <th class="py-3 px-3.5 font-bold">Tool</th>
                <th class="py-3 px-3.5 font-bold">Privacy / Zero Uploads?</th>
                <th class="py-3 px-3.5 font-bold">Zero Installation?</th>
                <th class="py-3 px-3.5 font-bold">Cross-Platform?</th>
                <th class="py-3 px-3.5 font-bold">Account Required?</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 text-gray-700">
              <tr class="bg-blue-50/40">
                <td class="py-3 px-3.5 font-bold text-brand-blue">FileLocker.online</td>
                <td class="py-3 px-3.5 text-emerald-600 font-bold">✓ 100% Client-Side</td>
                <td class="py-3 px-3.5 text-emerald-600 font-bold">✓ Runs in Browser</td>
                <td class="py-3 px-3.5 text-emerald-600 font-bold">✓ Windows, Mac, iOS, Android</td>
                <td class="py-3 px-3.5 text-emerald-600 font-bold">✓ No Account</td>
              </tr>
              <tr>
                <td class="py-3 px-3.5 font-semibold text-gray-900">Cloud Tools (Smallpdf/iLovePDF)</td>
                <td class="py-3 px-3.5 text-red-600 font-medium">✗ Uploads to Server</td>
                <td class="py-3 px-3.5 text-emerald-600 font-bold">✓ In Browser</td>
                <td class="py-3 px-3.5 text-emerald-600 font-bold">✓ All Browsers</td>
                <td class="py-3 px-3.5 text-amber-600 font-medium">⚠️ Often Required</td>
              </tr>
              <tr>
                <td class="py-3 px-3.5 font-semibold text-gray-900">VeraCrypt</td>
                <td class="py-3 px-3.5 text-emerald-600 font-bold">✓ Local Software</td>
                <td class="py-3 px-3.5 text-red-600 font-medium">✗ Complex Desktop Install</td>
                <td class="py-3 px-3.5 text-amber-600 font-medium">⚠️ Desktop Only (No Mobile)</td>
                <td class="py-3 px-3.5 text-emerald-600 font-bold">✓ No Account</td>
              </tr>
              <tr>
                <td class="py-3 px-3.5 font-semibold text-gray-900">BitLocker</td>
                <td class="py-3 px-3.5 text-emerald-600 font-bold">✓ Local Software</td>
                <td class="py-3 px-3.5 text-red-600 font-medium">✗ Windows Pro Edition Only</td>
                <td class="py-3 px-3.5 text-red-600 font-medium">✗ Windows Only</td>
                <td class="py-3 px-3.5 text-amber-600 font-medium">⚠️ Microsoft Account</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- SECTION 5: FAQS -->
      <div class="content-card animate-fade-in-up">
        <h2 class="section-heading">Frequently Asked Questions</h2>
        <div class="faq-grid mt-6">
          <div class="faq-item">
            <h3>How do I encrypt files online for free?</h3>
            <p>Select your file in the tool above, type a password, and click Lock File. FileLocker encrypts your file directly in your browser with AES-GCM 256-bit without uploading data.</p>
          </div>
          <div class="faq-item">
            <h3>Are my files uploaded to your servers?</h3>
            <p>No. Zero bytes of your files or passwords ever leave your computer or phone. All processing occurs inside your browser's local sandbox.</p>
          </div>
          <div class="faq-item">
            <h3>How do I decrypt an encrypted file?</h3>
            <p>Visit <a href="/unlock-file/" class="text-brand-blue hover:underline">/unlock-file/</a>, drop your protected <code>.vault</code> container, type your password, and your file decrypts instantly.</p>
          </div>
          <div class="faq-item">
            <h3>Is browser encryption secure?</h3>
            <p>Yes. FileLocker uses the W3C Web Cryptography API implemented in native C++ by browser vendors. It uses the exact same cryptographic primitives as commercial desktop software.</p>
          </div>
          <div class="faq-item">
            <h3>Can I encrypt entire folders?</h3>
            <p>Yes. Use our <a href="/lock-folder/" class="text-brand-blue hover:underline">Folder Protection Tool</a> to package and lock complete directory structures.</p>
          </div>
          <div class="faq-item">
            <h3>What if I forget my password?</h3>
            <p>There are no backdoors or recovery keys. If a password is forgotten, the file cannot be decrypted by anyone. Store passwords in a password manager.</p>
          </div>
        </div>
      </div>

      <!-- SECTION 6: CTA BANNER -->
      <div class="cta-banner mt-8 animate-fade-in-up">
        <h2 class="text-white text-2xl font-bold mb-2">Encrypt Your Files Securely Now</h2>
        <p class="cta-label mb-6">100% private, client-side AES-256 encryption. No signups, no uploads, completely free.</p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="/lock-file/" class="cta-button">Encrypt a File</a>
          <a href="/lock-folder/" class="cta-button" style="background:transparent;color:#fff;border:2px solid rgba(255,255,255,0.4);">Encrypt a Folder</a>
        </div>
      </div>

    </div>
  </div>
</Layout>

