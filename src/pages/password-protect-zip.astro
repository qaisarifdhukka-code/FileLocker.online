---
import Layout from '../layouts/Layout.astro';
import ProvisioningApp from '../components/ProvisioningApp';

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "FileLocker — Password Protect ZIP Files Online",
  "url": "https://filelocker.online/password-protect-zip/",
  "applicationCategory": "SecurityApplication",
  "operatingSystem": "All modern browsers (Chrome, Edge, Firefox, Safari)",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Free online tool to password protect ZIP files (.zip, .7z, .rar) directly in your browser with AES-256 encryption. Zero server uploads, no 7-Zip or WinRAR required."
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Password Protect a ZIP File Online with FileLocker",
  "description": "Learn how to encrypt and password protect a ZIP archive directly in your browser without software installation or server uploads.",
  "step": [
    {
      "@type": "HowToStep",
      "name": "Select Your ZIP File",
      "text": "Drop your .zip, .7z, or .rar archive into the encryption tool. The archive is read locally in your browser memory."
    },
    {
      "@type": "HowToStep",
      "name": "Set a Strong Encryption Password",
      "text": "Choose your master passphrase. FileLocker derives an authenticated 256-bit AES-GCM key using memory-hard Argon2id (64MB RAM)."
    },
    {
      "@type": "HowToStep",
      "name": "Save Your Encrypted .vault Container",
      "text": "Click Lock File. The browser encrypts the ZIP archive locally and downloads an authenticated .vault container to your device."
    }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://filelocker.online/" },
    { "@type": "ListItem", "position": 2, "name": "Tools", "item": "https://filelocker.online/lock-file/" },
    { "@type": "ListItem", "position": 3, "name": "Password Protect ZIP", "item": "https://filelocker.online/password-protect-zip/" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Why is standard Windows ZIP password protection insecure?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Traditional ZIP encryption uses 'ZipCrypto' (developed in 1989), which suffers from known-plaintext vulnerabilities and can be cracked in under 5 minutes using open-source tools like bkcrack. FileLocker replaces this obsolete cipher with authenticated AES-256-GCM and memory-hard Argon2id key derivation."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need 7-Zip or WinRAR to protect or open the file?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. FileLocker runs entirely inside modern web browsers. Neither you nor the recipient need to install desktop compression software."
      }
    },
    {
      "@type": "Question",
      "name": "Are my ZIP archives uploaded to any server?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. FileLocker processes your archive 100% locally on your computer or mobile device. Zero bytes leave your browser."
      }
    }
  ]
};
---

<Layout 
  title="Password Protect ZIP Online Free (AES-256) | FileLocker"
  description="Password protect ZIP files online for free. Encrypt .zip, .7z, and .rar archives in your browser with AES-256. Zero uploads, no 7-Zip or WinRAR needed."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(howToSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <!-- HERO SECTION WITH INTEGRATED TOOL -->
  <section class="w-full relative overflow-hidden bg-white pt-16 pb-20 border-b border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-50 border border-amber-200 text-xs font-semibold text-amber-800 mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-amber-600 animate-pulse"></span>
        <span>Dedicated Archive Locker · Zero Server Uploads</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-gray-900 leading-tight mb-4 tracking-tight">
        Password Protect <span class="text-amber-600">ZIP Files</span> Online Free
      </h1>
      <p class="text-base sm:text-lg text-gray-600 max-w-2xl mx-auto mb-10 leading-relaxed font-normal">
        Lock confidential ZIP and 7Z archives with client-side AES-256-GCM encryption. No 7-Zip desktop utility needed, and zero bytes uploaded to any remote server.
      </p>

      <!-- LIVE INTERACTIVE TOOL DROPZONE -->
      <div class="w-full max-w-2xl mx-auto bg-white rounded-3xl border border-gray-200/90 shadow-[0_12px_45px_rgba(0,0,0,0.08)] overflow-hidden text-left mb-6">
        <div class="bg-gradient-to-r from-amber-600 via-orange-600 to-indigo-600 px-6 py-4 text-white flex items-center justify-between">
          <div class="flex items-center gap-2.5">
            <span class="p-1.5 bg-white/20 rounded-lg text-white">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-6 10h-4v-2h4v2zm0-4h-4v-2h4v2z"/>
              </svg>
            </span>
            <div>
              <div class="font-bold text-sm sm:text-base leading-tight">ZIP Archive Locker</div>
              <div class="text-[11px] text-white/80">Supports .zip, .7z, .rar, .tar · AES-256-GCM + Argon2id</div>
            </div>
          </div>
          <span class="text-xs bg-white/15 px-3 py-1 rounded-full font-medium border border-white/20">Private Mode</span>
        </div>

        <div class="p-4 sm:p-6">
          <ProvisioningApp 
            client:load 
            initialMode="file" 
            acceptExtensions=".zip,.7z,.rar,.tar,.gz" 
            formatName="ZIP Archive" 
            hideHeader={true} 
            customTitle="Protect ZIP Archive"
            customSubtitle="Drop your ZIP, 7Z, or RAR archive below to encrypt it with a private password."
          />
        </div>

        <div class="bg-gray-50 border-t border-gray-100 py-3 px-6 flex flex-wrap items-center justify-between gap-2 text-xs text-gray-500">
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span><strong>Zero server uploads:</strong> Archives stay 100% in local memory</span>
          </div>
          <a href="/guides/password-protect-zip/" class="text-brand-blue font-semibold hover:underline">
            Read complete ZIP vulnerability guide →
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- EDUCATIONAL CONTENT & COMPARISON -->
  <section class="w-full bg-[#f8fafc] py-16 px-4 sm:px-6">
    <div class="max-w-4xl mx-auto space-y-12">

      <div class="bg-white rounded-2xl border border-gray-200/80 p-8 shadow-sm">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Why Standard ZipCrypto is Obsolete</h2>
        <p class="text-gray-700 leading-relaxed mb-4">
          When Windows creates a "password-protected ZIP", it uses a 1989 algorithm called <strong>ZipCrypto</strong>. Modern research has thoroughly compromised ZipCrypto: anyone possessing just 12 bytes of known plaintext can recover the internal keys and decrypt the entire ZIP in less than 5 minutes.
        </p>
        <p class="text-gray-700 leading-relaxed">
          FileLocker replaces outdated legacy algorithms with authenticated <strong>AES-256 in Galois/Counter Mode (GCM)</strong> coupled with <strong>Argon2id</strong> (allocating 64MB of RAM per hash), ensuring absolute immunity to known-plaintext and GPU cluster attacks.
        </p>
      </div>

      <!-- FAQ SECTION -->
      <div class="bg-white rounded-2xl border border-gray-200/80 p-8 shadow-sm">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Frequently Asked Questions: ZIP Protection</h2>
        <div class="space-y-6">
          <div class="border-b border-gray-100 pb-5">
            <h3 class="font-bold text-gray-900 text-base mb-2">Can I password protect an entire uncompressed folder instead of creating a ZIP first?</h3>
            <p class="text-gray-600 text-sm leading-relaxed">
              Yes! You don't even need to zip your folder first. Use our <a href="/lock-folder/" class="text-brand-blue font-semibold hover:underline">Folder Protection Tool</a>: simply select your folder, and FileLocker packages the directory hierarchy into an encrypted <code>.vault</code> container on the fly.
            </p>
          </div>
          <div>
            <h3 class="font-bold text-gray-900 text-base mb-2">How do I decrypt an encrypted ZIP file?</h3>
            <p class="text-gray-600 text-sm leading-relaxed">
              Open <a href="/unlock-file/" class="text-brand-blue font-semibold hover:underline">filelocker.online/unlock-file/</a>, select the <code>.vault</code> file, enter the password, and download the decrypted original archive immediately.
            </p>
          </div>
        </div>
      </div>

      <!-- BOTTOM CALL TO ACTION -->
      <div class="bg-gradient-to-r from-amber-600 to-orange-700 rounded-2xl p-8 sm:p-10 text-white text-center shadow-lg">
        <h2 class="text-2xl sm:text-3xl font-extrabold mb-3">Upgrade Your Archive Security</h2>
        <p class="text-amber-100 max-w-xl mx-auto mb-6 text-sm sm:text-base">
          Scroll up to encrypt your archive with modern authenticated AES-256 encryption.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="#top" class="px-6 py-3 rounded-full bg-white text-amber-900 font-bold text-sm shadow hover:bg-amber-50 transition-colors">
            Encrypt ZIP Archive
          </a>
          <a href="/unlock-file/" class="px-6 py-3 rounded-full bg-white/10 hover:bg-white/20 text-white font-bold text-sm border border-white/20 transition-colors">
            Unlock Protected File
          </a>
        </div>
      </div>

    </div>
  </section>
</Layout>

