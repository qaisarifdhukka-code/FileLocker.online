                        <span>Browse All Guides</span>
                        <span>→</span>
                    </a>
                </div>
            </div>

            <!-- How It Works Link (Direct Page Navigation) -->
            <div class="py-2.5">
                <a href="/how-it-works/" class="mobile-nav-link flex items-center justify-between text-[17px] font-semibold text-slate-800 hover:text-brand-blue py-2 transition-colors group">
