---
import Layout from '../layouts/Layout.astro';
import ProvisioningApp from '../components/ProvisioningApp';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is FileLocker free to use?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. FileLocker provides browser-based tools for password protecting and opening supported FileLocker files."
      }
    },
    {
      "@type": "Question",
      "name": "Are my files uploaded to a server?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. FileLocker processes your files locally in your browser. Your selected files are not uploaded to a FileLocker server for processing."
      }
    },
    {
      "@type": "Question",
      "name": "Can I password protect a folder?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. You can select a folder and protect its contents with a single password while preserving its folder structure."
      }
    },
    {
      "@type": "Question",
      "name": "What types of files can I protect?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can use FileLocker with many common file types, including documents, photos, videos, archives, and other files."
      }
    },
    {
      "@type": "Question",
      "name": "Can I protect large files?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "FileLocker is designed to work with large files by processing data in smaller parts instead of loading the entire file into memory at once."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need to install software?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. FileLocker runs in your web browser, so there is no separate application to install."
      }
    },
    {
      "@type": "Question",
      "name": "What happens if I forget my password?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "FileLocker does not store your password. If you forget it, the protected file cannot be opened through FileLocker."
      }
    }
  ]
};
---

<Layout title="Password-Protect Files and Folders Online | FileLocker">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />
  <!-- HERO SECTION -->
  <section class="w-full bg-[#f8fafc] flex flex-col items-center pt-24 pb-20 px-4 text-center relative overflow-hidden">
      <!-- Decorative Floating Shapes -->
      <div class="hidden sm:block absolute top-10 left-10 text-orange-400 opacity-70 animate-bounce" style="animation-duration: 3s;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L2 22h20L12 2z"/></svg>
      </div>
      <div class="hidden sm:block absolute top-20 right-20 text-pink-500 opacity-70 animate-pulse">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor"><rect x="4" y="4" width="16" height="16" rx="2"/></svg>
      </div>
      <div class="hidden sm:block absolute bottom-10 left-1/4 text-blue-400 opacity-70">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="10"/></svg>
      </div>
      <div class="hidden sm:block absolute bottom-20 right-1/4 text-purple-400 opacity-70 animate-bounce" style="animation-duration: 4s;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l4 8h8l-6 6 2 8-8-6-8 6 2-8-6-6h8z"/></svg>
      </div>

      <div class="inline-flex items-center gap-2 mb-8 bg-white border border-gray-200 shadow-sm rounded-full px-4 py-1.5 text-sm font-medium text-gray-600">
          <span class="bg-blue-50 text-brand-blue px-2 py-0.5 rounded-md border border-blue-100 font-bold">Free Online File Protection Tool</span>
      </div>

      <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold mb-6 tracking-tight text-gray-900 max-w-4xl leading-[1.15]">
          Password Protect Files and <span class="bg-brand-blue text-white px-4 py-1 rounded-lg inline-block shadow-md mt-2 md:mt-0">Folders</span> Online
      </h1>
      <p class="text-lg md:text-xl text-gray-500 mb-12 max-w-2xl font-medium px-4">
          Add password protection to files and folders directly from your browser. No installation, no account, and no file upload required.
      </p>

      <div class="w-full max-w-2xl mx-auto relative z-10 -mt-8">
          <ProvisioningApp client:load initialMode="both" hideHeader={true} />
          
          <!-- Trust Checkmarks -->
          <div class="mt-4 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm font-medium text-gray-600">
              <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Files stay on your device</span>
              <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> No account required</span>
              <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg> Free to use</span>
          </div>
      </div>
  </section>

  <!-- HOW TO SEO SECTION -->
  <section class="w-full bg-brand-blue py-12 px-6 relative overflow-hidden">
      <!-- Decorative background glow -->
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[300px] bg-white opacity-10 rounded-full blur-[100px] pointer-events-none"></div>
      
      <div class="max-w-5xl mx-auto relative z-10">
          <div class="text-center mb-10">
              <h2 class="text-2xl md:text-3xl font-extrabold text-white mb-3">How to Password Protect a File or Folder Online</h2>
              <p class="text-white/80 max-w-2xl mx-auto text-sm md:text-base leading-relaxed">
                  Protect documents, photos, videos, or archives directly from your browser without installing software. Your files are processed entirely on your device and are never uploaded to our servers.
              </p>
          </div>
          
          <div class="bg-white rounded-[2rem] p-6 md:p-8 shadow-2xl relative max-w-4xl mx-auto">
              
              <!-- Desktop Connecting Lines -->
              <div class="hidden md:block absolute top-[64px] left-1/4 right-1/4 h-px border-t-2 border-dashed border-gray-200 z-0"></div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-4 relative z-10">
