                                <span class="group-hover:translate-x-0.5 transition-transform">Password Protect a Folder</span>
                            </a>
                        </li>
                        <li>
                            <a href="/unlock-file/" class="text-slate-600 hover:text-brand-blue transition-colors flex items-center gap-1.5 group">
                                <span class="group-hover:translate-x-0.5 transition-transform">Open a Protected File</span>
