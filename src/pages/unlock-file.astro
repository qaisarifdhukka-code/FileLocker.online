---
import Layout from '../layouts/Layout.astro';
import UnlockApp from '../components/UnlockApp';

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "FileLocker — Unlock Tool",
  "url": "https://filelocker.online/unlock-file/",
  "applicationCategory": "SecurityApplication",
  "operatingSystem": "Browsers with File System Access API support",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Unlock and decrypt FileLocker-protected .vault files directly in your browser. Restore protected files and folders without server uploads or software installation."
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What types of files can I unlock with FileLocker?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "FileLocker's unlock tool is designed to open .vault files that were created with FileLocker. It decrypts the file entirely within your browser and restores the original file or folder."
      }
    },
    {
      "@type": "Question",
      "name": "Is my file uploaded to a server when I unlock it?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. The decryption process happens entirely within your browser. Your file is never sent to a server."
      }
    },
    {
      "@type": "Question",
      "name": "What happens if I enter the wrong password?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "FileLocker uses authenticated encryption (AES-GCM), which detects an incorrect password and refuses to produce corrupted output. You will see an error message and can try again with the correct password."
      }
    },
    {
      "@type": "Question",
      "name": "Can FileLocker recover a lost password?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Because FileLocker processes everything locally and never stores passwords or encryption keys, there is no way to recover a forgotten password. The correct password is required to open a protected file."
      }
    }
  ]
};
---

<Layout 
  title="Unlock Password-Protected Files Online | FileLocker"
  description="Unlock password-protected .vault files online with FileLocker. Open protected files in your browser without uploads, software, or an account."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <!-- HERO -->
  <div class="guide-hero" style="padding-bottom:2rem;">
    <div class="hero-shape hero-shape-1"></div>
    <div class="hero-shape hero-shape-2"></div>
    <div class="hero-inner" style="text-align:center; max-width:40rem;">
      <h1>Unlock Password-Protected Files Online</h1>
      <p class="hero-subtitle" style="margin:0 auto;">Open a FileLocker-protected <code style="background:rgba(255,255,255,0.15);padding:0.1rem 0.35rem;border-radius:0.25rem;">.vault</code> file directly in your browser — no uploads, no software required.</p>
    </div>
  </div>

  <div class="flex-1 bg-bg-light w-full flex items-center justify-center">
    <div class="w-full max-w-3xl mx-auto">
      <UnlockApp client:load hideHeader={true} />
    </div>
  </div>

  <!-- SEO CONTENT -->
  <section class="w-full bg-[#f8fafc] py-12 px-6 border-t border-gray-200">
    <div class="max-w-3xl mx-auto">

      <div class="content-card animate-fade-in-up">
        <h2 class="section-heading">How to Open a Password Protected File</h2>
        <div class="prose max-w-none">
          <p>To <strong>unlock a password-protected file online</strong>, select the FileLocker <code>.vault</code> file, enter the password used to protect it, and save the restored file to your device.</p>
          <p>FileLocker's unlock tool decrypts any <code>.vault</code> file that was created with FileLocker. The entire process runs inside your web browser — your file is never sent to a server.</p>
        </div>
        <ol class="steps-grid">
            <li class="step-card">
              <span class="step-number">1</span>
              <strong>Select your .vault file</strong>
              <span>Click the upload area and choose the <code>.vault</code> file from your device.</span>
            </li>
            <li class="step-card">
              <span class="step-number">2</span>
              <strong>Enter the password</strong>
              <span>Type the password that was used when the file was originally protected. You must get this from the person who created the protected file.</span>
            </li>
            <li class="step-card">
              <span class="step-number">3</span>
              <strong>Save the original file</strong>
              <span>FileLocker decrypts the contents and your browser prompts you to save the restored file or folder to your device.</span>
            </li>
          </ol>
        <div class="prose max-w-none">
          <p>Because all processing happens locally, there is no waiting for uploads or server processing. Large files — including videos — are decrypted using the same streaming approach used during encryption.</p>
        </div>
      </div>

      <div class="content-card animate-fade-in-up animate-delay-1">
        <h2 class="section-heading">What is a .vault File?</h2>
        <div class="prose max-w-none">
          <p>A <code>.vault</code> file is a file that has been encrypted by FileLocker. It contains the original file's encrypted contents along with cryptographic metadata — such as a salt and nonce — needed to safely decrypt it. When you unlock a <code>.vault</code> file that contains a folder, FileLocker also restores the original folder structure exactly as it was when protected.</p>
        </div>
      </div>

      <div class="content-card animate-fade-in-up animate-delay-2">
        <h2 class="section-heading">Frequently Asked Questions</h2>
        <div class="faq-grid">
          <div class="faq-item">
            <h3>What types of files can I unlock with FileLocker?</h3>
            <p>FileLocker's unlock tool opens <code>.vault</code> files created with FileLocker. It decrypts the file within your browser and restores the original file or folder.</p>
          </div>
          <div class="faq-item">
            <h3>Is my file uploaded to a server when I unlock it?</h3>
            <p>No. The decryption process happens entirely within your browser. Your file is never sent to a server.</p>
          </div>
          <div class="faq-item">
            <h3>What happens if I enter the wrong password?</h3>
            <p>FileLocker uses authenticated encryption (AES-GCM), which detects an incorrect password and refuses to produce corrupted output. You will see an error and can try again with the correct password.</p>
          </div>
          <div class="faq-item">
            <h3>Can FileLocker recover a lost password?</h3>
            <p>No. Because FileLocker processes everything locally and never stores passwords or encryption keys, there is no way to recover a forgotten password. The correct password is required to open a protected file.</p>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <div class="cta-banner mt-8 animate-fade-in-up animate-delay-3">
        <p class="cta-label">Need to protect a file instead?</p>
        <a href="/lock-file/" class="cta-button">Password Protect a File</a>
      </div>

    </div>
  </section>
</Layout>
