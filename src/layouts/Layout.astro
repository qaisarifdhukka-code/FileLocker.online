    </div>

    <!-- MAIN CONTENT -->
    <main id="main-content" class="flex-1 flex flex-col w-full relative">
        <slot />
    </main>
    
    <!-- FOOTER -->
    <footer class="w-full bg-slate-50/80 border-t border-slate-200/80 pt-16 pb-12 mt-auto relative overflow-hidden">
        <!-- Top subtle accent light diffuser -->
        <div class="absolute top-0 left-1/2 -translate-x-1/2 w-3/4 max-w-4xl h-px bg-gradient-to-r from-transparent via-blue-500/30 to-transparent pointer-events-none"></div>

        <div class="max-w-7xl mx-auto px-6 lg:px-8">
            <!-- Main Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-10 lg:gap-8 mb-14">
                
                <!-- Col 1: Brand & Cryptographic Authority -->
                <div class="sm:col-span-2 md:col-span-3 lg:col-span-2 pr-0 lg:pr-8">
                    <a href="/" aria-label="FileLocker home" class="inline-flex items-center gap-2 mb-4 group">
                        <img src="/filelocker-logo-main.svg" alt="FileLocker" class="h-7 w-auto transition-transform group-hover:scale-[1.02]" />
