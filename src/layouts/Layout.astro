                <!-- Col 2: Tools -->
                <div>
                    <p class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-4">Tools</p>
                    <ul class="space-y-3 text-sm">
                        <li>
                            <a href="/lock-file/" class="text-slate-600 hover:text-brand-blue transition-colors flex items-center gap-1.5 group">
                                <span class="group-hover:translate-x-0.5 transition-transform">Password Protect a File</span>
                            </a>
                        </li>
                        <li>
