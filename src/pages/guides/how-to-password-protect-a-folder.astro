---
import Layout from '../../layouts/Layout.astro';

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Password Protect a Folder Online Without Software",
  "description": "Learn how to password protect and encrypt an entire directory folder on Windows, Mac, or Linux using FileLocker's zero-knowledge client-side tool.",
  "step": [
    {
      "@type": "HowToStep",
      "name": "Select Your Folder",
      "text": "Open FileLocker's free Lock Folder tool and select your directory. Your browser accesses the files locally without uploading any data over the internet."
    },
    {
      "@type": "HowToStep",
      "name": "Create a Strong Master Password",
      "text": "Enter and confirm your password. FileLocker uses PBKDF2 key derivation and military-grade AES-GCM 256-bit encryption entirely inside your browser."
    },
    {
      "@type": "HowToStep",
      "name": "Download the Encrypted .vault File",
      "text": "Click Protect Folder. FileLocker packages the directory tree into a single tamper-proof .vault file ready to store or share via email or cloud."
    }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://filelocker.online/" },
    { "@type": "ListItem", "position": 2, "name": "Guides", "item": "https://filelocker.online/guides/" },
    { "@type": "ListItem", "position": 3, "name": "How to Password Protect a Folder", "item": "https://filelocker.online/guides/how-to-password-protect-a-folder/" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I password protect a folder in Windows 11 without software?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Windows 11 does not have a native right-click option to password protect regular folders. Using FileLocker in your browser (Chrome, Edge, or Brave), you can select any folder, enter a password, and encrypt all its nested files into a secure .vault file in seconds without installing any desktop software."
      }
    },
    {
      "@type": "Question",
      "name": "Can I password protect a folder on a Mac?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. On macOS, you can either create an encrypted disk image (.dmg) using Disk Utility, or use FileLocker directly in your browser. FileLocker is significantly faster because it produces a cross-platform .vault file that can be opened on both Windows and Mac without formatting disk images."
      }
    },
    {
      "@type": "Question",
      "name": "Why can't I just right-click and set a password on a Windows folder?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Microsoft built NTFS file encryption (EFS) and BitLocker into Windows, but EFS binds encryption to your Windows user account rather than a standalone password. If another user logs into your PC or steals the drive, standard folder permissions do not provide password challenge protection. That is why container-based encryption like FileLocker is needed."
      }
    },
    {
      "@type": "Question",
      "name": "Does 7-Zip password protect folders directly?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "7-Zip does not lock the existing folder in place; instead, it compresses the folder into an encrypted .7z or .zip archive with AES-256 encryption. While effective, it requires installing desktop software and re-compressing every time you update files. FileLocker provides the same AES-256 security directly in your web browser with zero software installation."
      }
    },
    {
      "@type": "Question",
      "name": "Will my directory hierarchy and subfolders stay intact?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. FileLocker streams the entire directory structure into a standardized TAR archive before applying AES-GCM authenticated encryption. When unlocked, all nested subfolders, relative file paths, and file names are restored exactly as they originally were."
      }
    },
    {
      "@type": "Question",
      "name": "How does the recipient open a password-protected folder?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The recipient opens FileLocker's free Unlock Tool in their browser, selects the .vault file, and enters the password. The folder contents decrypt locally on their device without installing any software or creating an account."
      }
    }
  ]
};
---

<Layout
  title="How to Password Protect a Folder Online | FileLocker"
  description="Learn how to password protect a folder in Windows 11, Mac, or online for free. Encrypt entire directories with AES-GCM without software or cloud uploads."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(howToSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <!-- HERO -->
  <div class="guide-hero">
    <div class="hero-shape hero-shape-1"></div>
    <div class="hero-shape hero-shape-2"></div>
    <div class="hero-shape hero-shape-3"></div>
    <div class="hero-inner">
      <nav class="hero-breadcrumb">
        <a href="/guides/">Guides</a>
        <span class="separator">/</span>
        <span class="current">Password Protect a Folder</span>
      </nav>
      <h1>How to Password Protect a Folder in Windows 11, Mac & Online</h1>
      <p class="hero-subtitle">
        Lock entire directories, client projects, financial archives, and nested subfolders with authenticated AES-GCM encryption. 100% private in your browser with zero server uploads and zero software installation.
      </p>
    </div>
  </div>

  <!-- MAIN CONTENT -->
  <div class="w-full bg-[#f8fafc] py-12 px-6">
    <div class="max-w-5xl mx-auto space-y-8">

      <!-- QUICK ACTION CARDS -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 animate-fade-in-up">
        <a href="/lock-folder/" class="guide-index-card card-teal p-6 flex flex-col justify-between">
          <div>
            <div class="card-icon bg-teal-50 text-teal-600 mb-4">
              <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
              </svg>
            </div>
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-teal-50 text-teal-700 text-xs font-bold uppercase tracking-wider mb-2">Instant In-Browser Tool</div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Password Protect an Entire Folder</h3>
            <p class="text-gray-600 text-sm">Select any directory to encrypt all files, subdirectories, and media into a secure .vault file.</p>
          </div>
          <div class="card-link mt-4 text-teal-600 font-semibold flex items-center gap-1">
            Open Folder Locker <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </div>
        </a>

        <a href="/lock-file/" class="guide-index-card card-blue p-6 flex flex-col justify-between">
          <div>
            <div class="card-icon bg-blue-50 text-brand-blue mb-4">
              <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-blue-50 text-brand-blue text-xs font-bold uppercase tracking-wider mb-2">Individual Files</div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Password Protect a Single File</h3>
            <p class="text-gray-600 text-sm">Lock individual PDFs, Word docs, spreadsheets, or 4K videos directly on your device.</p>
          </div>
          <div class="card-link mt-4 text-brand-blue font-semibold flex items-center gap-1">
            Open File Locker <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </div>
        </a>
      </div>

      <!-- PROBLEM OVERVIEW -->
      <div class="content-card animate-fade-in-up">
        <h2 class="section-heading">The Native Folder Locking Problem: Why Windows & Mac Make It Hard</h2>
        <div class="prose max-w-none text-gray-700 space-y-4">
          <p>
            Almost every computer user encounters this dilemma: you have a folder full of confidential tax documents, client deliverables, personal photos, or financial spreadsheets, and you want to put a password on it. You right-click the folder, expecting to see <em>"Lock with Password"</em> or <em>"Password Protect Folder"</em>.
          </p>
          <p>
            To your frustration, <strong>neither Windows 11, Windows 10, nor macOS offers a direct, one-click folder password feature</strong>:
          </p>
          <ul class="list-disc pl-6 space-y-2">
            <li>
              <strong>Windows BitLocker:</strong> Only encrypts <em>entire hard drive volumes</em> or USB drives on Windows Pro/Enterprise editions. It cannot lock an individual folder.
            </li>
            <li>
              <strong>Windows Encrypting File System (EFS):</strong> Ties encryption to your Windows user account. If someone borrows your laptop or accesses your unlocked session, the files open without asking for a password. EFS is also disabled on Windows Home editions.
            </li>
            <li>
              <strong>macOS Disk Utility:</strong> Requires manually creating an encrypted virtual disk image (<code>.dmg</code>), choosing partition schemes, copying files into the mounted drive, and unmounting it. The resulting DMG cannot be opened on Windows or Android without third-party tools.
            </li>
            <li>
              <strong>Third-Party Desktop Apps (7-Zip, VeraCrypt):</strong> Effective, but require software installation on every machine—making it impossible to securely share folders with colleagues or clients on locked-down office computers.
            </li>
          </ul>
          <p>
            Below, we explore the 3 most effective methods to password protect a folder: starting with the fastest, software-free method via FileLocker, followed by native desktop alternatives.
          </p>
        </div>
      </div>

      <!-- METHOD 1: FILELOCKER -->
      <div class="content-card animate-fade-in-up">
        <div class="flex items-center gap-2 mb-2">
          <span class="px-3 py-1 bg-green-100 text-green-800 text-xs font-bold rounded-full uppercase">Method 1 (Recommended)</span>
          <span class="text-xs text-gray-400 font-medium">Fastest · Cross-Platform · No Software</span>
        </div>
        <h2 class="section-heading">How to Password Protect Any Folder Online with FileLocker</h2>
        <div class="prose max-w-none text-gray-700 space-y-4">
          <p>
            FileLocker uses the modern browser <strong>File System Access API</strong> combined with the <strong>Web Crypto API</strong>. It reads your folder structure locally, packages the files into an in-memory streaming archive, and encrypts everything using authenticated <strong>AES-GCM (256-bit)</strong>.
          </p>
          <div class="callout callout-info">
            <p>
              <strong>Zero Server Uploads:</strong> Your files never travel across the internet. Encryption happens 100% inside your local web browser. You can even disconnect your internet after loading the page and the tool will continue working.
            </p>
          </div>

          <ol class="steps-grid my-6">
            <li class="step-card">
              <span class="step-number">1</span>
              <strong>Select Your Folder</strong>
              <span>Open the <a href="/lock-folder/" class="text-brand-blue font-semibold hover:underline">Lock Folder Tool</a>. Click the dropzone and pick the folder you wish to protect from your Windows Explorer or Mac Finder.</span>
            </li>
            <li class="step-card">
              <span class="step-number">2</span>
              <strong>Set a Master Password</strong>
              <span>Enter a strong password. FileLocker derives an encryption key using PBKDF2 with a cryptographic salt, ensuring high resistance against brute-force attacks.</span>
            </li>
            <li class="step-card">
              <span class="step-number">3</span>
              <strong>Save the Protected .vault File</strong>
              <span>Click <strong>"Lock & Save Folder"</strong>. FileLocker packages the directory tree and downloads a standalone <code>.vault</code> file to your device.</span>
            </li>
          </ol>

          <p>
            The resulting <code>.vault</code> container holds your entire directory structure. You can safely email it, upload it to <a href="/guides/password-protect-google-drive-files/" class="text-brand-blue underline">Google Drive or Dropbox</a>, or store it on an unencrypted USB flash drive.
          </p>
        </div>
      </div>

      <!-- METHOD 2: 7-ZIP ON WINDOWS -->
      <div class="content-card animate-fade-in-up">
        <div class="flex items-center gap-2 mb-2">
          <span class="px-3 py-1 bg-blue-100 text-blue-800 text-xs font-bold rounded-full uppercase">Method 2</span>
          <span class="text-xs text-gray-400 font-medium">Desktop Software · Windows 11 & 10</span>
        </div>
        <h2 class="section-heading">How to Password Protect a Folder in Windows Using 7-Zip</h2>
        <div class="prose max-w-none text-gray-700 space-y-4">
          <p>
            If you have administrative rights on your PC and prefer an installed desktop tool, <strong>7-Zip</strong> is the gold-standard open-source file archiver for Windows.
          </p>
          <ol class="list-decimal pl-6 space-y-3">
            <li>
              <strong>Download & Install 7-Zip:</strong> Go to the official 7-Zip website and install the 64-bit Windows version.
            </li>
            <li>
              <strong>Right-Click Your Folder:</strong> In Windows 11 File Explorer, right-click the folder, click <em>"Show more options"</em>, hover over <strong>7-Zip</strong>, and select <strong>"Add to archive..."</strong>.
            </li>
            <li>
              <strong>Configure Encryption Settings:</strong>
              <ul class="list-disc pl-6 mt-1 space-y-1 text-sm">
                <li>Set Archive format to <strong>7z</strong> (or <strong>zip</strong>).</li>
                <li>In the <strong>Encryption</strong> panel on the right, type and re-enter your password.</li>
                <li>Set Encryption method to <strong>AES-256</strong>.</li>
                <li><strong>Crucial step:</strong> Check the box <strong>"Encrypt file names"</strong> (available with <code>.7z</code> format). This hides file names from anyone browsing the archive without the password.</li>
              </ul>
            </li>
            <li>
              <strong>Click OK:</strong> 7-Zip will create an encrypted archive. You can then delete the original unencrypted folder.
            </li>
          </ol>
          <p class="text-sm text-gray-500">
            <em>Drawback:</em> Anyone opening the archive on another machine must also have 7-Zip or a compatible decompression utility installed. For an online alternative that requires zero software, see our <a href="/guides/password-protect-zip/" class="text-brand-blue underline">ZIP password protection guide</a>.
          </p>
        </div>
      </div>

      <!-- METHOD 3: MAC DISK UTILITY -->
      <div class="content-card animate-fade-in-up">
        <div class="flex items-center gap-2 mb-2">
          <span class="px-3 py-1 bg-purple-100 text-purple-800 text-xs font-bold rounded-full uppercase">Method 3</span>
          <span class="text-xs text-gray-400 font-medium">Native macOS · Apple Silicon & Intel</span>
        </div>
        <h2 class="section-heading">How to Password Protect a Folder on Mac Using Disk Utility</h2>
        <div class="prose max-w-none text-gray-700 space-y-4">
          <p>
            macOS includes a built-in utility capable of creating encrypted container files called <strong>Disk Images (.dmg)</strong>. Here is how to lock a folder using native macOS tools:
          </p>
          <ol class="list-decimal pl-6 space-y-3">
            <li>
              <strong>Open Disk Utility:</strong> Press <code>Cmd + Space</code> to open Spotlight, type <em>Disk Utility</em>, and hit Enter.
            </li>
            <li>
              <strong>Create Image from Folder:</strong> In the top menu bar, click <strong>File > New Image > Image from Folder...</strong> (or press <code>Cmd + Shift + N</code>).
            </li>
            <li>
              <strong>Select the Folder:</strong> Navigate to the folder you want to protect and click <strong>Choose</strong>.
            </li>
            <li>
              <strong>Set Password & Encryption Level:</strong>
              <ul class="list-disc pl-6 mt-1 space-y-1 text-sm">
                <li>In the <strong>Encryption</strong> dropdown, choose <strong>128-bit AES</strong> (faster) or <strong>256-bit AES</strong> (more secure).</li>
                <li>A popup will prompt you to enter and verify your password.</li>
                <li><strong>Important:</strong> Uncheck <em>"Remember password in my keychain"</em> if you don't want your Mac to automatically unlock the folder!</li>
                <li>Set <strong>Image Format</strong> to <em>read/write</em> (if you plan to add more files later) or <em>read-only</em>.</li>
              </ul>
            </li>
            <li>
              <strong>Save:</strong> Click Save. macOS creates an encrypted <code>.dmg</code> file. Once finished, move the original folder to the Trash.
            </li>
          </ol>
          <p class="text-sm text-gray-500">
            <em>Drawback:</em> <code>.dmg</code> files cannot be opened natively on Windows or mobile devices without third-party converters.
          </p>
        </div>
      </div>

      <!-- COMPARISON TABLE -->
      <div class="content-card animate-fade-in-up">
        <h2 class="section-heading">Comparison: FileLocker vs. 7-Zip vs. macOS Disk Utility</h2>
        <p class="text-gray-600 mb-6">See how the top folder protection methods compare across ease of use, platform support, and security:</p>
        
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm border-collapse">
            <thead>
              <tr class="border-b border-gray-200 bg-gray-50/50">
                <th class="py-3 px-4 font-bold text-gray-900">Feature</th>
                <th class="py-3 px-4 font-bold text-brand-blue">FileLocker (Online)</th>
                <th class="py-3 px-4 font-bold text-gray-900">7-Zip (Windows)</th>
                <th class="py-3 px-4 font-bold text-gray-900">Disk Utility (Mac)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <tr>
                <td class="py-3 px-4 font-semibold text-gray-800">Software Installation</td>
                <td class="py-3 px-4 text-green-600 font-bold">Zero (In-Browser)</td>
                <td class="py-3 px-4 text-gray-600">Required (Desktop EXE)</td>
                <td class="py-3 px-4 text-green-600 font-semibold">Pre-installed (Mac only)</td>
              </tr>
              <tr>
                <td class="py-3 px-4 font-semibold text-gray-800">Encryption Standard</td>
                <td class="py-3 px-4 text-gray-800 font-medium">AES-GCM (256-bit)</td>
                <td class="py-3 px-4 text-gray-800">AES-256 (CBC)</td>
                <td class="py-3 px-4 text-gray-800">AES-128 / AES-256</td>
              </tr>
              <tr>
                <td class="py-3 px-4 font-semibold text-gray-800">Cross-Platform Unlocking</td>
                <td class="py-3 px-4 text-green-600 font-bold">Windows, Mac, Linux, Mobile</td>
                <td class="py-3 px-4 text-yellow-600">Requires 7-Zip on client</td>
                <td class="py-3 px-4 text-red-600 font-medium">Mac Only (.dmg format)</td>
              </tr>
              <tr>
                <td class="py-3 px-4 font-semibold text-gray-800">Hides Nested File Names</td>
                <td class="py-3 px-4 text-green-600 font-bold">Yes (Full TAR Vault)</td>
                <td class="py-3 px-4 text-green-600">Yes (7z format only)</td>
                <td class="py-3 px-4 text-green-600">Yes</td>
              </tr>
              <tr>
                <td class="py-3 px-4 font-semibold text-gray-800">Cloud Storage Ready</td>
                <td class="py-3 px-4 text-green-600 font-bold">Yes (.vault container)</td>
                <td class="py-3 px-4 text-green-600">Yes (.7z / .zip)</td>
                <td class="py-3 px-4 text-yellow-600">Mac ecosystems only</td>
              </tr>
              <tr>
                <td class="py-3 px-4 font-semibold text-gray-800">Price</td>
                <td class="py-3 px-4 text-green-600 font-bold">100% Free</td>
                <td class="py-3 px-4 text-green-600 font-bold">Free (Open Source)</td>
                <td class="py-3 px-4 text-green-600 font-bold">Free (Built-in)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- HOW TO RECIPIENT UNLOCKS -->
      <div class="content-card animate-fade-in-up">
        <h2 class="section-heading">How the Recipient Unlocks a Protected Folder</h2>
        <div class="prose max-w-none text-gray-700 space-y-4">
          <p>
            One of the biggest pain points when sharing encrypted folders is forcing the recipient to install complex software like 7-Zip, PeaZip, or VeraCrypt. With FileLocker, the recipient experience is frictionless:
          </p>
          <ol class="list-decimal pl-6 space-y-2">
            <li>Send the recipient the <code>.vault</code> file via email, Google Drive link, WeTransfer, or USB flash drive.</li>
            <li>Send the password via a separate, secure channel (e.g. Signal, WhatsApp, or SMS).</li>
            <li>The recipient opens the <a href="/unlock-file/" class="text-brand-blue font-semibold hover:underline">FileLocker Unlock Tool</a> in any modern browser.</li>
            <li>They select the <code>.vault</code> file and enter the password.</li>
            <li>The browser decrypts the archive and downloads the complete folder with all nested subdirectories restored intact.</li>
          </ol>
        </div>
      </div>

      <!-- FAQ SECTION -->
      <div class="content-card animate-fade-in-up">
        <h2 class="section-heading">Frequently Asked Questions About Folder Password Protection</h2>
        <div class="faq-grid">
          <div class="faq-item">
            <h3>How do I password protect a folder in Windows 11 without software?</h3>
            <p>Windows 11 lacks a direct right-click password option. Using FileLocker in Chrome, Edge, or Brave, you can select any directory, set a password, and encrypt all nested files into a secure .vault file in seconds without installing any desktop software.</p>
          </div>
          <div class="faq-item">
            <h3>Can I password protect a folder on a Mac?</h3>
            <p>Yes. You can create an encrypted disk image (.dmg) via macOS Disk Utility, or use FileLocker directly in your browser. FileLocker produces a cross-platform .vault file that opens on both Windows and Mac without formatting disk images.</p>
          </div>
          <div class="faq-item">
            <h3>Why can't I just right-click and set a password on a Windows folder?</h3>
            <p>Microsoft designed EFS and BitLocker around user accounts and drives rather than individual folder passwords. EFS decrypts automatically whenever you are logged into your PC, offering zero protection against shared access or stolen files.</p>
          </div>
          <div class="faq-item">
            <h3>Does 7-Zip password protect folders directly?</h3>
            <p>7-Zip compresses the folder into an encrypted .7z or .zip archive with AES-256. While strong, it requires desktop software on every computer. FileLocker offers equivalent AES-256 encryption directly in your web browser.</p>
          </div>
          <div class="faq-item">
            <h3>Will my directory hierarchy and subfolders stay intact?</h3>
            <p>Yes. FileLocker packages the entire folder into an in-memory TAR stream before applying AES-GCM encryption. Decryption restores all subfolders, file names, and directory structures exactly as they were.</p>
          </div>
          <div class="faq-item">
            <h3>Can I password protect a folder on a USB flash drive?</h3>
            <p>Yes. Simply select the folder located on your USB flash drive in FileLocker, enter your password, and save the .vault file directly back to the USB drive. You can then delete the unencrypted folder.</p>
          </div>
        </div>
      </div>

      <!-- RELATED GUIDES -->
      <div class="content-card animate-fade-in-up">
        <h2 class="section-heading">Related File & Folder Protection Tutorials</h2>
        <p class="text-gray-600 mb-4">Explore other step-by-step guides for locking specific document formats and media:</p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a href="/guides/how-to-password-protect-files/" class="guide-link font-semibold text-brand-blue">Master Guide: Protect Any File →</a>
          <a href="/guides/password-protect-photos/" class="guide-link font-semibold text-purple-600">Password Protect Photos &amp; Albums →</a>
          <a href="/guides/secure-file-sharing/" class="guide-link font-semibold text-emerald-600">Secure File Sharing Guide →</a>
          <a href="/guides/password-protect-google-drive-files/" class="guide-link">Protect Google Drive Files →</a>
          <a href="/guides/password-protect-word-document/" class="guide-link">Protect Word Documents →</a>
          <a href="/guides/password-protect-zip/" class="guide-link">Password Protect a ZIP File →</a>
          <a href="/guides/protect-large-videos/" class="guide-link">Protect Large Video Files (4K) →</a>
          <a href="/guides/password-protect-pdf/" class="guide-link">Password Protect a PDF Document →</a>
          <a href="/guides/password-protect-excel/" class="guide-link">Password Protect an Excel File →</a>
