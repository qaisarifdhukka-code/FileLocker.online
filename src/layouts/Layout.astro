                    </div>
                </div>

                <!-- Unlock Link -->
                <a href="/unlock-file/" class="flex items-center gap-1.5 px-3 py-1.5 rounded-full hover:text-slate-900 hover:bg-slate-100/70 transition-all outline-none focus:ring-2 focus:ring-blue-500/20">
                    <span>Unlock</span>
                </a>

                <!-- Guides Dropdown -->
                <div class="relative group py-1">
                    <button type="button" aria-haspopup="true" class="flex items-center gap-1.5 px-3 py-1.5 rounded-full hover:text-slate-900 hover:bg-slate-100/70 transition-all outline-none focus:ring-2 focus:ring-blue-500/20 cursor-pointer">
                        <span>Guides</span>
                        <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-slate-700 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M19 9l-7 7-7-7" />
                        </svg>
                    </button>
                    <!-- Popover Dropdown Card -->
                    <div class="absolute top-full left-1/2 -translate-x-1/2 pt-2 w-80 opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200 transform origin-top -translate-y-1 group-hover:translate-y-0">
                        <div class="bg-white/95 backdrop-blur-xl border border-slate-200/80 shadow-[0_20px_50px_rgba(15,23,42,0.12)] rounded-2xl p-2.5 flex flex-col gap-1">
                            <div class="px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-slate-400">Featured Guides</div>
                            <a href="/guides/how-to-password-protect-files/" class="flex items-center justify-between p-2 rounded-xl hover:bg-slate-50 text-xs font-semibold text-slate-800 hover:text-brand-blue transition-colors">
                                <span>How to Password Protect Any File</span>
                                <span class="text-slate-400 text-[11px]">→</span>
                            </a>
                            <a href="/guides/how-to-password-protect-a-folder/" class="flex items-center justify-between p-2 rounded-xl hover:bg-slate-50 text-xs font-semibold text-slate-800 hover:text-brand-blue transition-colors">
                                <span>How to Password Protect a Folder</span>
                                <span class="text-slate-400 text-[11px]">→</span>
                            </a>
