---
import Layout from '../layouts/Layout.astro';
import ProvisioningApp from '../components/ProvisioningApp';

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "FileLocker — File Protection Tool",
  "url": "https://filelocker.online/lock-file/",
  "applicationCategory": "SecurityApplication",
  "operatingSystem": "Browsers with File System Access API support",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Browser-based tool to password protect common files directly on your device without server uploads, software installation, or an account."
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I password protect a file?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Select your file using the FileLocker tool, enter a password, and click to protect. FileLocker will encrypt the file locally and save it as a .vault file to your device."
      }
    },
    {
      "@type": "Question",
      "name": "Is my file uploaded to a server?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. FileLocker processes your file entirely within your browser using local JavaScript. Your file is never sent to a server."
      }
    },
    {
      "@type": "Question",
      "name": "What types of files can I password protect?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "FileLocker can protect many common file types, including documents, PDFs, spreadsheets, images, videos, ZIP archives, and other files."
      }
    },
    {
      "@type": "Question",
      "name": "Is there a file size limit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "FileLocker processes files in chunks using browser storage and streaming APIs. Practical limits depend on browser support, available storage, device resources, and the file being processed."
      }
    }
  ]
};
---

<Layout 
  title="Password Protect a File Online | FileLocker"
  description="Password protect a file online with FileLocker. Encrypt files directly in your browser without uploads, software installation, or an account."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <!-- HERO -->
  <div class="guide-hero" style="padding-bottom:2rem;">
    <div class="hero-shape hero-shape-1"></div>
    <div class="hero-shape hero-shape-2"></div>
    <div class="hero-inner" style="text-align:center; max-width:40rem;">
      <h1>Password Protect a File Online</h1>
      <p class="hero-subtitle" style="margin:0 auto;">Select a file, set a password, and download your protected file — processed entirely on your device.</p>
    </div>
  </div>

  <div class="flex-1 bg-bg-light w-full flex items-center justify-center">
    <div class="w-full max-w-3xl mx-auto">
      <ProvisioningApp client:load initialMode="file" hideHeader={true} />
    </div>
  </div>

  <!-- SEO CONTENT -->
  <section class="w-full bg-[#f8fafc] py-12 px-6 border-t border-gray-200">
    <div class="max-w-3xl mx-auto">

      <div class="content-card animate-fade-in-up">
        <div class="flex items-center gap-3 mb-4">
          <span class="inline-flex items-center rounded-full bg-blue-50 px-3 py-1 text-xs font-bold uppercase tracking-wide text-brand-blue">Three simple steps</span>
        </div>
        <h2 class="section-heading">How to Password Protect a File</h2>
        <div class="prose max-w-none">
          <p>Password protect a file online by selecting it, creating a password, and saving the protected <code>.vault</code> copy. Processing happens in your browser rather than on a FileLocker server.</p>
        </div>

        <ol class="steps-grid" style="margin-top:1.5rem;">
          <li class="step-card">
            <span class="step-number">1</span>
            <strong>Select your file</strong>
            <span>Choose the file you want to protect from your device.</span>
          </li>
          <li class="step-card">
            <span class="step-number">2</span>
            <strong>Create a password</strong>
            <span>Use a strong password and keep it safe—FileLocker cannot recover a lost password.</span>
          </li>
          <li class="step-card">
            <span class="step-number">3</span>
            <strong>Save your .vault file</strong>
            <span>Save the protected copy, then use the unlock tool and the correct password to restore it later.</span>
          </li>
        </ol>

        <div class="callout callout-info" style="margin-top:1.5rem;">
          <p>You can store or share the resulting <code>.vault</code> file as needed. To open it later, use <a href="/unlock-file/" class="font-semibold text-brand-blue hover:underline">FileLocker's unlock tool</a> and the original password.</p>
        </div>
      </div>

      <div class="content-card animate-fade-in-up animate-delay-1">
        <h2 class="section-heading">Why Password Protect a File Online with FileLocker?</h2>
        <div class="feature-grid">
          <div class="feature-card">
            <div class="feature-icon" style="background:#eff6ff;">
              <svg class="w-6 h-6 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
            </div>
            <h3>No File Uploads</h3>
            <p>Your files are processed entirely within your browser using local JavaScript. Nothing is sent to a server at any point.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon" style="background:#f0fdf4;">
              <svg class="w-6 h-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            </div>
            <h3>No Software Required</h3>
            <p>FileLocker runs directly in your web browser. There is nothing to install and no account to create.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon" style="background:#faf5ff;">
              <svg class="w-6 h-6 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" /></svg>
            </div>
            <h3>Protect Common File Types</h3>
            <p>Protect documents, PDFs, spreadsheets, images, videos, ZIP archives, and many other file formats without changing the original file.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon" style="background:#fefce8;">
              <svg class="w-6 h-6 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            </div>
            <h3>Large Files Supported</h3>
            <p>FileLocker uses streaming and browser storage APIs to reduce memory pressure when processing large files. Actual limits depend on your browser, device, available storage, and the file.</p>
          </div>
        </div>
      </div>

      <div class="content-card animate-fade-in-up animate-delay-2">
        <h2 class="section-heading">Protect Specific File Types</h2>
        <p class="text-gray-600 mb-4">Follow a focused guide for the file you need to protect. <a href="/lock-folder/" class="text-brand-blue font-semibold hover:underline">Protect a folder instead →</a></p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <a href="/guides/password-protect-pdf/" class="guide-link">Password protect a PDF →</a>
          <a href="/guides/password-protect-zip/" class="guide-link">Password protect a ZIP file →</a>
          <a href="/guides/password-protect-excel/" class="guide-link">Password protect an Excel file →</a>
          <a href="/guides/protect-large-videos/" class="guide-link">Protect large video files →</a>
        </div>
      </div>

      <div class="content-card animate-fade-in-up animate-delay-3">
        <h2 class="section-heading">Frequently Asked Questions</h2>
        <div class="faq-grid">
          <div class="faq-item">
            <h3>How do I password protect a file?</h3>
            <p>Select your file using the FileLocker tool above, enter a password, and click to protect. FileLocker will encrypt the file locally and save it as a <code>.vault</code> file to your device.</p>
          </div>
          <div class="faq-item">
            <h3>Is my file uploaded to a server?</h3>
            <p>No. FileLocker processes your file entirely within your browser. Your file is never sent to a server.</p>
          </div>
          <div class="faq-item">
            <h3>What types of files can I password protect?</h3>
            <p>FileLocker can protect many common file types, including documents, PDFs, spreadsheets, images, videos, ZIP archives, and other files.</p>
          </div>
          <div class="faq-item">
            <h3>Is there a file size limit?</h3>
            <p>FileLocker processes files in chunks to reduce memory pressure. Practical limits depend on browser support, available storage, device resources, and the file being processed.</p>
          </div>
        </div>
      </div>

    </div>
  </section>
</Layout>
