---
import Layout from '../../layouts/Layout.astro';

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Password Protect Photos and Images Online",
  "description": "Learn how to encrypt and password protect sensitive photos (JPG, PNG, HEIC, WebP) or entire photo folders in your browser using free client-side AES-GCM encryption.",
  "step": [
    {
      "@type": "HowToStep",
      "name": "Select Your Photo or Photo Album Folder",
      "text": "Open FileLocker in your browser. Choose the File tool for individual images (JPG, PNG, WebP) or the Folder tool for an entire photo directory."
    },
    {
      "@type": "HowToStep",
      "name": "Enter a Private Encryption Password",
      "text": "Enter and confirm your password. FileLocker derives an authenticated AES-GCM 256-bit encryption key locally on your device using PBKDF2."
    },
    {
      "@type": "HowToStep",
      "name": "Save the Protected .vault File",
      "text": "Download the encrypted .vault file. Your original photos are now locked inside a mathematically unbreakable container that can be safely archived, emailed, or stored on cloud drives."
    }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://filelocker.online/" },
    { "@type": "ListItem", "position": 2, "name": "Guides", "item": "https://filelocker.online/guides/" },
    { "@type": "ListItem", "position": 3, "name": "Password Protect Photos", "item": "https://filelocker.online/guides/password-protect-photos/" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Can I password protect photos on Windows 11 without software?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Windows 11 does not have a native password lock feature in the default Photos app. While Windows Pro editions include BitLocker for entire disk drives, locking specific photos requires third-party tools. With FileLocker, you can password protect individual photos or entire picture folders directly in your browser using AES-GCM 256-bit encryption with zero software installation."
      }
    },
    {
      "@type": "Question",
      "name": "How do I password protect photos on a Mac?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "On macOS, the Apple Photos app allows locking the 'Hidden' album with Touch ID. However, image files stored directly in Finder folders remain completely unprotected. To lock any JPG, PNG, or RAW photos in Finder, use FileLocker in Safari or Chrome to encrypt them into a secure .vault container."
      }
    },
    {
      "@type": "Question",
      "name": "Are my private photos uploaded to a cloud server when encrypting?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. FileLocker operates 100% client-side inside your web browser using the native Web Crypto API. Your photos never leave your device's memory and zero bytes are transmitted to any server. You can verify this by checking the Network tab in browser Developer Tools."
      }
    },
    {
      "@type": "Question",
      "name": "Can I password protect an entire album or folder of photos at once?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. FileLocker's Lock Folder tool allows you to select an entire photo directory containing hundreds of high-resolution images. It bundles and encrypts the entire album into a single .vault file protected by your password."
      }
    },
    {
      "@type": "Question",
      "name": "What image formats are supported?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "FileLocker supports all image formats, including JPEG/JPG, PNG, WebP, HEIC/HEIF, GIF, TIFF, SVG, PSD, and camera RAW formats (CR2, NEF, ARW)."
      }
    },
    {
      "@type": "Question",
      "name": "How does someone unlock and view the protected photos?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "To view the photos, open FileLocker's Unlock tool in any browser, drop the .vault file, and enter the password. The photos are decrypted locally on your computer in seconds."
      }
    }
  ]
};
---

<Layout
  title="How to Password Protect Photos & Images Online | FileLocker"
  description="Password protect private photos (JPG, PNG, HEIC) or picture folders in your browser. 100% private client-side AES-256 encryption with zero uploads."
  canonical="https://filelocker.online/guides/password-protect-photos/"
>
  <head slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>

  <div class="guide-wrapper py-12 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
    <!-- BREADCRUMBS -->
    <nav class="flex items-center gap-2 text-sm text-gray-500 mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-brand-blue transition-colors">Home</a>
      <span class="text-gray-300">/</span>
      <a href="/guides/" class="hover:text-brand-blue transition-colors">Guides</a>
      <span class="text-gray-300">/</span>
      <span class="text-gray-900 font-medium" aria-current="page">Password Protect Photos</span>
    </nav>

    <!-- ARTICLE HEADER -->
    <header class="mb-10 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-50 text-purple-700 text-xs font-semibold uppercase tracking-wider mb-4 border border-purple-100">
        Privacy &amp; Media Protection Guide
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-gray-900 tracking-tight leading-tight mb-4">
        How to Password Protect Photos &amp; Images Online
      </h1>
      <p class="text-lg text-gray-600 leading-relaxed">
        Keep passport scans, confidential IDs, medical documents, and personal pictures safe from prying eyes. Learn how to encrypt individual photos or entire photo albums with zero-knowledge AES-GCM protection.
      </p>
    </header>

    <!-- MAIN CONTENT -->
    <main class="space-y-12">
      <!-- DUAL ACTION CARDS -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-8">
        <a href="/lock-file/" class="guide-index-card card-purple p-6 flex flex-col justify-between">
          <div>
            <div class="card-icon bg-purple-50 text-purple-600 mb-4">
              <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-purple-50 text-purple-700 text-xs font-bold uppercase tracking-wider mb-2">Single Image</div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Lock Single Photo</h3>
            <p class="text-gray-600 text-sm">Encrypt an ID scan, passport image, or confidential picture into a secure .vault file.</p>
          </div>
          <div class="card-link mt-4 text-purple-600 font-semibold flex items-center gap-1">
            Open File Locker <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </div>
        </a>

        <a href="/lock-folder/" class="guide-index-card card-teal p-6 flex flex-col justify-between">
          <div>
            <div class="card-icon bg-teal-50 text-teal-600 mb-4">
              <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
              </svg>
            </div>
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-teal-50 text-teal-700 text-xs font-bold uppercase tracking-wider mb-2">Full Photo Album</div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Lock Entire Photo Album</h3>
            <p class="text-gray-600 text-sm">Bundle hundreds of images and nested photo folders into one password-protected container.</p>
          </div>
          <div class="card-link mt-4 text-teal-600 font-semibold flex items-center gap-1">
            Open Folder Locker <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </div>
        </a>
      </div>

      <!-- WHY PHOTO PROTECTION IS HARD -->
      <div class="content-card animate-fade-in-up">
        <h2 class="section-heading">The Photo Privacy Blind Spot: Why Windows &amp; Mac Make It Difficult</h2>
        <div class="prose max-w-none text-gray-700 space-y-4">
          <p>
            Digital photos frequently contain the most sensitive information we handle: photos of driver's licenses, passports, credit cards, medical scans, tax documentation, and confidential family memories.
          </p>
          <p>
            Yet modern operating systems provide surprisingly little native protection for standalone photo files:
          </p>
          <ul class="list-disc pl-6 space-y-2">
            <li><strong>Windows 10 &amp; 11:</strong> The default Windows Photos app contains no password lock. Any person who sits at your computer can browse your Pictures folder or see thumbnail previews in File Explorer.</li>
            <li><strong>macOS:</strong> While Apple Photos includes a locked "Hidden" album, this only applies to images imported into Apple's Photos app. Raw image files on your Desktop, Downloads, or external USB drives remain entirely visible in Finder.</li>
            <li><strong>Cloud Backup Exposure:</strong> When photos are backed up to Google Photos, iCloud, or OneDrive, cloud providers scan image contents with automated image recognition algorithms to detect faces, objects, and text (OCR).</li>
          </ul>
          <p>
            To achieve true privacy, you need a way to wrap sensitive photos into an encrypted vault that conceals both image contents and thumbnail previews.
          </p>
        </div>
      </div>

      <!-- ZERO KNOWLEDGE CLIENT SIDE ENCRYPTION -->
      <div class="content-card animate-fade-in-up">
        <h2 class="section-heading">Method 1: Password Protect Photos Online with FileLocker (Free &amp; Zero Install)</h2>
        <div class="prose max-w-none text-gray-700 space-y-4">
          <p>
            FileLocker provides an instantaneous, hardware-accelerated way to encrypt photos without uploading anything to the internet. Because it executes entirely via the browser's native <a href="/security/" class="text-brand-blue font-semibold hover:underline">Web Crypto API</a>, your private pictures never leave your computer's RAM.
          </p>
          
          <h3 class="text-lg font-bold text-gray-900 mt-4">Step-by-Step Instructions:</h3>
          <ol class="steps-grid my-6">
            <li class="step-card">
              <span class="step-number">1</span>
              <strong>Choose Your Photos or Album</strong>
              <span>Open the <a href="/lock-file/" class="text-brand-blue font-semibold hover:underline">Lock File tool</a> for a single image, or <a href="/lock-folder/" class="text-brand-blue font-semibold hover:underline">Lock Folder</a> to encrypt an entire directory album.</span>
            </li>
            <li class="step-card">
              <span class="step-number">2</span>
              <strong>Set a Robust Password</strong>
              <span>Enter your password. FileLocker derives an authenticated <strong>AES-GCM (256-bit)</strong> encryption key locally on your CPU using PBKDF2 with 100,000 hash iterations.</span>
            </li>
            <li class="step-card">
              <span class="step-number">3</span>
              <strong>Download the .vault Container</strong>
              <span>Save the resulting <code>.vault</code> file. Your photos are now scrambled and unreadable. You can safely store the vault on your drive, email it, or upload it to cloud storage.</span>
            </li>
          </ol>
        </div>
      </div>

      <!-- METHOD 2: 7-ZIP FOR WINDOWS -->
      <div class="content-card animate-fade-in-up">
        <h2 class="section-heading">Method 2: How to Password Protect Photos in Windows Using 7-Zip</h2>
        <div class="prose max-w-none text-gray-700 space-y-4">
          <p>
            If you prefer desktop software on Windows, the open-source utility <strong>7-Zip</strong> provides strong AES-256 archive encryption:
          </p>
          <ol class="list-decimal pl-6 space-y-2">
            <li>Download and install 7-Zip from <code>7-zip.org</code>.</li>
            <li>Select the photos or the photo folder in Windows File Explorer.</li>
            <li>Right-click the selection and choose <strong>7-Zip &gt; Add to archive…</strong></li>
            <li>In the dialog, set <strong>Archive format</strong> to <code>7z</code>.</li>
            <li>In the <strong>Encryption</strong> section, enter your password and check <strong>Encrypt file names</strong> (this hides thumbnail names from onlookers).</li>
            <li>Click <strong>OK</strong> to create the password-protected archive.</li>
          </ol>
          <p class="text-sm bg-amber-50 border border-amber-200 rounded-lg p-3 text-amber-900 mt-2">
            <strong>Warning:</strong> Always delete the original unencrypted photos from your drive and empty the Recycle Bin after creating the archive; otherwise, the raw photos remain accessible.
          </p>
        </div>
      </div>

      <!-- METHOD 3: MACOS DISK UTILITY -->
      <div class="content-card animate-fade-in-up">
        <h2 class="section-heading">Method 3: How to Password Protect Photos on Mac Using Disk Utility</h2>
        <div class="prose max-w-none text-gray-700 space-y-4">
          <p>
            macOS includes a native tool called <strong>Disk Utility</strong> that can package photos into an encrypted virtual disk image:
          </p>
          <ol class="list-decimal pl-6 space-y-2">
            <li>Place all photos you want to protect into a single folder in Finder.</li>
            <li>Open <strong>Disk Utility</strong> (press <code>Cmd + Space</code> and search for Disk Utility).</li>
            <li>In the top menu, click <strong>File &gt; New Image &gt; Image from Folder…</strong></li>
            <li>Select your photo folder and click <strong>Choose</strong>.</li>
            <li>Set <strong>Encryption</strong> to <strong>256-bit AES encryption</strong>. Enter and verify your password.</li>
            <li>Set <strong>Image Format</strong> to <strong>read/write</strong>. Click <strong>Save</strong>.</li>
          </ol>
          <p>
            macOS creates a password-protected <code>.dmg</code> file. You must enter your password each time you mount the disk image to view the photos.
          </p>
        </div>
      </div>

      <!-- COMPARISON TABLE -->
      <div class="content-card animate-fade-in-up">
        <h2 class="section-heading">Comparison: FileLocker vs. 7-Zip vs. macOS Disk Utility</h2>
        <div class="prose max-w-none text-gray-700 space-y-4">
          <p>Here is how the three photo protection methods compare:</p>
          <div class="overflow-x-auto my-6">
            <table class="comparison-table w-full text-left text-sm border-collapse">
              <thead>
                <tr class="bg-gray-100 border-b border-gray-200">
                  <th class="p-3 font-semibold text-gray-900">Feature</th>
                  <th class="p-3 font-bold text-brand-blue bg-blue-50/50">FileLocker (Online)</th>
                  <th class="p-3 font-semibold text-gray-700">7-Zip (Windows)</th>
                  <th class="p-3 font-semibold text-gray-700">macOS Disk Utility</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-200">
                <tr>
                  <td class="p-3 font-medium text-gray-900">Installation Required</td>
                  <td class="p-3 text-emerald-600 font-bold bg-blue-50/30">Zero (Runs in Browser)</td>
                  <td class="p-3 text-gray-600">Yes (Desktop download)</td>
                  <td class="p-3 text-gray-600">Pre-installed on macOS only</td>
                </tr>
                <tr>
                  <td class="p-3 font-medium text-gray-900">Platform Compatibility</td>
                  <td class="p-3 text-emerald-600 font-bold bg-blue-50/30">Windows, Mac, Linux, Mobile</td>
                  <td class="p-3 text-gray-600">Windows &amp; Linux</td>
                  <td class="p-3 text-rose-600 font-medium">macOS only (.dmg format)</td>
                </tr>
                <tr>
                  <td class="p-3 font-medium text-gray-900">Encryption Standard</td>
                  <td class="p-3 text-emerald-600 font-bold bg-blue-50/30">AES-GCM (256-bit)</td>
                  <td class="p-3 text-gray-600">AES-256</td>
                  <td class="p-3 text-gray-600">AES-128 / AES-256</td>
                </tr>
                <tr>
                  <td class="p-3 font-medium text-gray-900">Protects Entire Albums</td>
                  <td class="p-3 text-emerald-600 font-bold bg-blue-50/30">Yes (Folder Tool)</td>
                  <td class="p-3 text-gray-600">Yes (Archive folder)</td>
                  <td class="p-3 text-gray-600">Yes (Folder to DMG)</td>
                </tr>
                <tr>
                  <td class="p-3 font-medium text-gray-900">Recipient Friction</td>
                  <td class="p-3 text-emerald-600 font-bold bg-blue-50/30">Zero (Opens in browser)</td>
                  <td class="p-3 text-gray-600">Requires 7-Zip or WinRAR</td>
                  <td class="p-3 text-rose-600 font-medium">Windows users cannot open DMG</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- HOW RECIPIENTS UNLOCK -->
      <div class="content-card animate-fade-in-up">
        <h2 class="section-heading">How to Open and Decrypt Protected Photos</h2>
        <div class="prose max-w-none text-gray-700 space-y-4">
          <p>
            When you need to view your locked photos or share them with a trusted family member or colleague:
          </p>
          <ol class="list-decimal pl-6 space-y-2">
            <li>Visit <a href="/unlock-file/" class="text-brand-blue font-semibold hover:underline">filelocker.online/unlock-file/</a> in any web browser.</li>
            <li>Drag or select the <code>.vault</code> file.</li>
            <li>Enter your password.</li>
            <li>The browser decrypts the photos locally in RAM and restores the original image files.</li>
          </ol>
          <p>
            Decryption takes less than 2 seconds, with zero server uploads and zero account requirements.
          </p>
        </div>
      </div>

      <!-- FREQUENTLY ASKED QUESTIONS -->
      <div class="content-card animate-fade-in-up">
        <h2 class="section-heading">Frequently Asked Questions About Photo Protection</h2>
        <div class="space-y-4 my-6">
          <details class="faq-accordion group border border-gray-200 rounded-xl p-4 transition-all duration-200 hover:border-gray-300">
            <summary class="font-bold text-gray-900 cursor-pointer flex justify-between items-center select-none">
              <span>Can I password protect photos on Windows 11 without software?</span>
              <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <p class="text-gray-600 text-sm mt-3 leading-relaxed">
              Windows 11 does not have a native password lock feature in the default Photos app. While Windows Pro editions include BitLocker for entire disk drives, locking specific photos requires third-party tools. With FileLocker, you can password protect individual photos or entire picture folders directly in your browser using AES-GCM 256-bit encryption with zero software installation.
            </p>
          </details>

          <details class="faq-accordion group border border-gray-200 rounded-xl p-4 transition-all duration-200 hover:border-gray-300">
            <summary class="font-bold text-gray-900 cursor-pointer flex justify-between items-center select-none">
              <span>How do I password protect photos on a Mac?</span>
              <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <p class="text-gray-600 text-sm mt-3 leading-relaxed">
              On macOS, the Apple Photos app allows locking the 'Hidden' album with Touch ID. However, image files stored directly in Finder folders remain completely unprotected. To lock any JPG, PNG, or RAW photos in Finder, use FileLocker in Safari or Chrome to encrypt them into a secure .vault container.
            </p>
          </details>

          <details class="faq-accordion group border border-gray-200 rounded-xl p-4 transition-all duration-200 hover:border-gray-300">
            <summary class="font-bold text-gray-900 cursor-pointer flex justify-between items-center select-none">
              <span>Are my private photos uploaded to a cloud server when encrypting?</span>
              <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <p class="text-gray-600 text-sm mt-3 leading-relaxed">
              No. FileLocker operates 100% client-side inside your web browser using the native Web Crypto API. Your photos never leave your device's memory and zero bytes are transmitted to any server. You can verify this by checking the Network tab in browser Developer Tools.
            </p>
          </details>

          <details class="faq-accordion group border border-gray-200 rounded-xl p-4 transition-all duration-200 hover:border-gray-300">
            <summary class="font-bold text-gray-900 cursor-pointer flex justify-between items-center select-none">
              <span>Can I password protect an entire album or folder of photos at once?</span>
              <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <p class="text-gray-600 text-sm mt-3 leading-relaxed">
              Yes. FileLocker's Lock Folder tool allows you to select an entire photo directory containing hundreds of high-resolution images. It bundles and encrypts the entire album into a single .vault file protected by your password.
            </p>
          </details>

          <details class="faq-accordion group border border-gray-200 rounded-xl p-4 transition-all duration-200 hover:border-gray-300">
            <summary class="font-bold text-gray-900 cursor-pointer flex justify-between items-center select-none">
              <span>What image formats are supported?</span>
              <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <p class="text-gray-600 text-sm mt-3 leading-relaxed">
              FileLocker supports all image formats, including JPEG/JPG, PNG, WebP, HEIC/HEIF, GIF, TIFF, SVG, PSD, and camera RAW formats (CR2, NEF, ARW).
            </p>
          </details>

          <details class="faq-accordion group border border-gray-200 rounded-xl p-4 transition-all duration-200 hover:border-gray-300">
            <summary class="font-bold text-gray-900 cursor-pointer flex justify-between items-center select-none">
              <span>How does someone unlock and view the protected photos?</span>
              <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <p class="text-gray-600 text-sm mt-3 leading-relaxed">
              To view the photos, open FileLocker's Unlock tool in any browser, drop the .vault file, and enter the password. The photos are decrypted locally on your computer in seconds.
            </p>
          </details>
        </div>
      </div>

      <!-- RELATED GUIDES (INTERNAL LINKING MESH) -->
      <div class="content-card animate-fade-in-up">
        <h2 class="section-heading">Related Media &amp; File Protection Guides</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 my-6">
          <a href="/guides/how-to-password-protect-a-folder/" class="p-4 rounded-xl border border-gray-200 hover:border-brand-blue hover:shadow-md transition-all group">
            <div class="text-xs font-semibold uppercase text-teal-600 mb-1">Folder Master</div>
            <div class="font-bold text-gray-900 group-hover:text-brand-blue">How to Password Protect a Folder</div>
            <p class="text-xs text-gray-500 mt-1">Windows 11, Mac, and online zero-knowledge folder protection.</p>
          </a>

