---
import Layout from '../../layouts/Layout.astro';

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Password Protect a PDF File",
  "description": "Learn how to password protect PDF files online for free with FileLocker. Secure PDF documents directly in your browser without uploading your files.",
  "step": [
    {
      "@type": "HowToStep",
      "name": "Open the FileLocker Tool",
      "text": "Go to the free File Protection tool at filelocker.online/lock-file."
    },
    {
      "@type": "HowToStep",
      "name": "Select your PDF",
      "text": "Click to upload and select the PDF document you want to protect from your device."
    },
    {
      "@type": "HowToStep",
      "name": "Create a Strong Password",
      "text": "Enter a password that only you and the intended recipient will know. Do not forget this password — it cannot be recovered."
    },
    {
      "@type": "HowToStep",
      "name": "Save the .vault File",
      "text": "Click to protect. FileLocker encrypts the PDF and saves it as a .vault file to your device."
    }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://filelocker.online/" },
    { "@type": "ListItem", "position": 2, "name": "Guides", "item": "https://filelocker.online/guides/" },
    { "@type": "ListItem", "position": 3, "name": "Protect a PDF", "item": "https://filelocker.online/guides/password-protect-pdf/" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Can I password protect a PDF for free?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. FileLocker provides free, browser-based PDF protection using AES-GCM encryption. No subscription or account is required."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need Adobe Acrobat to password protect a PDF?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Adobe Acrobat is one option. FileLocker provides another browser-based way to protect a PDF without installing desktop software."
      }
    },
    {
      "@type": "Question",
      "name": "Is my PDF uploaded to a server?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. FileLocker processes your PDF entirely on your device using local JavaScript. Your file is never uploaded to a server."
      }
    },
    {
      "@type": "Question",
      "name": "Can the recipient open my protected PDF without FileLocker?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. A FileLocker-protected PDF is saved as a .vault file, which requires the FileLocker unlock tool and the correct password to open. Share the password with your recipient separately."
      }
    }
  ]
};
---

<Layout 
  title="Password Protect a PDF Online | FileLocker"
  description="Learn how to password protect a PDF online with FileLocker. Secure PDF documents in your browser without uploads, accounts, or software."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(howToSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <!-- HERO -->
  <div class="guide-hero">
    <div class="hero-shape hero-shape-1"></div>
    <div class="hero-shape hero-shape-2"></div>
    <div class="hero-shape hero-shape-3"></div>
    <div class="hero-inner">
      <nav class="hero-breadcrumb">
        <a href="/guides/">Guides</a>
        <span class="separator">/</span>
        <span class="current">Protect a PDF</span>
      </nav>
      <h1>How to Password Protect a PDF Online</h1>
      <p class="hero-subtitle">
        Need to send a sensitive tax document, legal contract, report, or other PDF? Password protection can be useful when you want the recipient to have the file but still require a password before the protected copy can be opened.
      </p>
    </div>
  </div>

  <!-- MAIN CONTENT -->
  <div class="w-full bg-[#f8fafc] py-12 px-6">
    <div class="max-w-3xl mx-auto">

      <div class="content-card animate-fade-in-up">
        <div class="prose max-w-none">
          <p>
            Fortunately, you don't need expensive software to secure your PDF files. FileLocker uses AES-GCM encryption to protect any PDF directly in your web browser, completely for free.
          </p>

          <div class="callout callout-info">
            <div class="callout-title">
              <svg class="callout-icon text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              Privacy First
            </div>
            <p>
              Because FileLocker processes your PDF using JavaScript directly on your device, your sensitive document is <strong>never uploaded to our servers</strong>. Your document is processed entirely on your device.
            </p>
          </div>
        </div>
      </div>

      <div class="content-card animate-fade-in-up animate-delay-1">
        <h2 class="section-heading">How to Password Protect a PDF Step by Step</h2>
        
        <ol class="steps-grid">
          <li class="step-card">
            <span class="step-number">1</span>
            <strong>Open the FileLocker Tool</strong>
            <span>Go to our free <a href="/lock-file/" class="text-brand-blue hover:underline">File Protection tool</a>.</span>
          </li>
          <li class="step-card">
            <span class="step-number">2</span>
            <strong>Select your PDF</strong>
            <span>Click "Upload from PC or Mobile" and select the PDF document you want to protect.</span>
          </li>
          <li class="step-card">
            <span class="step-number">3</span>
            <strong>Create a Strong Password</strong>
            <span>Enter a password that only you and the intended recipient will know. <em>Do not forget this password, as it cannot be recovered!</em></span>
          </li>
          <li class="step-card">
            <span class="step-number">4</span>
            <strong>Save the .vault File</strong>
            <span>Click "Lock &amp; Save File". FileLocker will encrypt the PDF and save it as a <code>.vault</code> file to your device.</span>
          </li>
        </ol>
      </div>

      <div class="content-card animate-fade-in-up animate-delay-2">
        <div class="prose max-w-none">
          <h2>How to Open a Password-Protected PDF Later</h2>
          <p>
            When your recipient receives the <code>.vault</code> file (via email, WhatsApp, or cloud storage), they simply go to the <a href="/unlock-file/">Unlock Tool</a>, select the file, enter the password you gave them, and it restores the original PDF document after the password is verified.
          </p>

          <h2>Other Ways to Password Protect a PDF</h2>
          <p>FileLocker is not the only way to password protect a PDF. Here are common alternatives:</p>
          <ul>
            <li><strong>Adobe Acrobat:</strong> Adobe provides built-in PDF protection features in Acrobat. Availability of specific features can depend on the Acrobat edition or plan.</li>
            <li><strong>Microsoft Word / LibreOffice:</strong> If you are starting from a Word document, both Microsoft Word and LibreOffice can export password-protected PDFs.</li>
            <li><strong>macOS Preview:</strong> On a Mac, you can add a password to a PDF directly from the Preview app when exporting.</li>
          </ul>
          <p>FileLocker is useful when you want a browser-based workflow that processes the PDF on your device and produces a protected <code>.vault</code> file. The recipient can then use FileLocker's unlock tool with the correct password.</p>
        </div>
      </div>

      <div class="content-card animate-fade-in-up animate-delay-3">
        <h2 class="section-heading">Frequently Asked Questions</h2>
        <div class="faq-grid">
          <div class="faq-item">
            <h3>Can I password protect a PDF for free?</h3>
            <p>Yes. FileLocker provides free, browser-based PDF protection using AES-GCM encryption. No subscription or account is required.</p>
          </div>
          <div class="faq-item">
            <h3>Do I need Adobe Acrobat to password protect a PDF?</h3>
            <p>No. Adobe Acrobat is one option. FileLocker provides another browser-based way to protect a PDF without installing desktop software.</p>
          </div>
          <div class="faq-item">
            <h3>Is my PDF uploaded to a server?</h3>
            <p>No. FileLocker processes your PDF entirely on your device. Your file is never uploaded to a server.</p>
          </div>
          <div class="faq-item">
            <h3>Can the recipient open my protected PDF without FileLocker?</h3>
            <p>No. A FileLocker-protected PDF is saved as a <code>.vault</code> file, which requires the FileLocker unlock tool and the correct password to open.</p>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <div class="cta-banner mt-8 animate-fade-in-up animate-delay-4">
        <p class="cta-label">Ready to secure your PDF?</p>
        <a href="/lock-file/" class="cta-button">Protect a PDF Now</a>
      </div>

    </div>
  </div>
</Layout>
