        </div>

        <!-- Bottom Drawer Actions & Footer (Image 2 & 3 formatting) -->
        <div class="pt-5 border-t border-slate-100 flex flex-col gap-3.5 flex-shrink-0">
            <!-- CTA Button in Logo Brand Blue -->
