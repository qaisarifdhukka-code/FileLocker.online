---
import Layout from '../../layouts/Layout.astro';

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Password Protect Large Video Files",
  "description": "Learn how to password protect large video files in your browser using FileLocker's streaming and browser-storage approach.",
  "step": [
    { "@type": "HowToStep", "name": "Open the FileLocker Tool", "text": "Go to the free File Protection tool at filelocker.online/lock-file." },
    { "@type": "HowToStep", "name": "Select your Video File", "text": "Click to upload and select your video file (e.g., .mp4, .mov, .mkv). Nothing is uploaded over the internet." },
    { "@type": "HowToStep", "name": "Create a Password", "text": "Enter a strong password. This password will be required to open the video later." },
    { "@type": "HowToStep", "name": "Save the Protected File", "text": "Click to protect. FileLocker will process the video and save it as a .vault file to your device." }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://filelocker.online/" },
    { "@type": "ListItem", "position": 2, "name": "Guides", "item": "https://filelocker.online/guides/" },
    { "@type": "ListItem", "position": 3, "name": "Protect Large Videos", "item": "https://filelocker.online/guides/protect-large-videos/" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What video formats does FileLocker support?",
      "acceptedAnswer": { "@type": "Answer", "text": "FileLocker can protect common video formats including .mp4, .mov, .mkv, and .avi. It encrypts file data rather than relying on a particular media format." }
    },
    {
      "@type": "Question",
      "name": "Can FileLocker handle very large video files?",
      "acceptedAnswer": { "@type": "Answer", "text": "FileLocker processes video in smaller chunks instead of requiring the entire source file to be loaded into memory at once. Practical limits still depend on browser support, available storage, device resources, and the file being processed." }
    },
    {
      "@type": "Question",
      "name": "Is my video uploaded to a server?",
      "acceptedAnswer": { "@type": "Answer", "text": "No. FileLocker processes your video entirely on your device. Because there are no network uploads, processing speed also depends on your browser, device resources, and local storage performance." }
    },
    {
      "@type": "Question",
      "name": "How do I share a protected video?",
      "acceptedAnswer": { "@type": "Answer", "text": "After protecting your video, you will have a .vault file. You can upload this file to Google Drive, Dropbox, or a USB drive. The recipient needs to use FileLocker's unlock tool and the correct password to restore the original video." }
    }
  ]
};
---

<Layout 
  title="Password Protect Large Video Files Online | FileLocker"
  description="Learn how to protect large video files online with FileLocker. Secure and encrypt videos in your browser without uploads, software, accounts, or downloads."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(howToSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <!-- HERO -->
  <div class="guide-hero">
    <div class="hero-shape hero-shape-1"></div>
    <div class="hero-shape hero-shape-2"></div>
    <div class="hero-shape hero-shape-3"></div>
    <div class="hero-inner">
      <nav class="hero-breadcrumb">
        <a href="/guides/">Guides</a>
        <span class="separator">/</span>
        <span class="current">Protect Large Videos</span>
      </nav>
      <h1>How to Password Protect Large Video Files Online</h1>
      <p class="hero-subtitle">
        Protecting a 10GB 4K video can be challenging for browser tools that try to load the entire file into memory. FileLocker uses browser storage and streaming APIs to process the video in smaller chunks instead.
      </p>
    </div>
  </div>

  <!-- MAIN CONTENT -->
  <div class="w-full bg-[#f8fafc] py-12 px-6">
    <div class="max-w-3xl mx-auto">

      <div class="content-card animate-fade-in-up">
        <div class="prose max-w-none">
          <p>
            FileLocker uses modern streaming technology and browser storage to process <strong>large files in smaller chunks</strong>. This can reduce memory pressure compared with loading the entire file into memory at once, although actual limits depend on the browser, device, available storage, and file.
          </p>

          <div class="callout callout-purple">
            <div class="callout-title">
              <svg class="callout-icon text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
              Local Processing
            </div>
            <p>
              Because FileLocker doesn't upload your video to a server over the internet, it works at the native read/write speed of your hard drive. Processing time depends on the file size, storage speed, browser, and device resources. Local processing avoids the need to upload the video to a remote server.
            </p>
          </div>
        </div>
      </div>

      <div class="content-card animate-fade-in-up animate-delay-1">
        <h2 class="section-heading">How to Password Protect a Large Video File Step by Step</h2>
        
        <ol class="steps-grid">
          <li class="step-card">
            <span class="step-number">1</span>
            <strong>Open the FileLocker Tool</strong>
            <span>Go to our free <a href="/lock-file/" class="text-brand-blue hover:underline">File Protection tool</a>.</span>
          </li>
          <li class="step-card">
            <span class="step-number">2</span>
            <strong>Select your Video (.mp4, .mov, .mkv)</strong>
            <span>Choose your large video file. The selected video is processed in your browser rather than uploaded to a FileLocker processing server.</span>
          </li>
          <li class="step-card">
            <span class="step-number">3</span>
            <strong>Create a Password</strong>
            <span>Enter a strong password. This password will be required to watch the video later.</span>
          </li>
          <li class="step-card">
            <span class="step-number">4</span>
            <strong>Save the .vault File</strong>
            <span>Click "Lock &amp; Save File". FileLocker will process the video stream and output a secure <code>.vault</code> file. You can now upload this file to Google Drive, Dropbox, or a USB drive securely.</span>
          </li>
        </ol>
      </div>

      <div class="content-card animate-fade-in-up animate-delay-2">
        <div class="prose max-w-none">
          <h2>How to Unlock a Protected Video File</h2>
          <p>
            When someone needs to watch the video, they must go to the <a href="/unlock-file/">Unlock Tool</a> and enter the password. FileLocker processes the protected data in your browser and restores the original video file when the correct password is supplied.
          </p>

          <h2>What Video File Formats Can You Password Protect?</h2>
          <p>
            FileLocker can protect common video formats including <code>.mp4</code>, <code>.mov</code>, <code>.mkv</code>, and <code>.avi</code>. It encrypts file data rather than relying on a specific document or media format.
          </p>
        </div>
      </div>

      <div class="content-card animate-fade-in-up animate-delay-3">
        <h2 class="section-heading">Frequently Asked Questions</h2>
        <div class="faq-grid">
          <div class="faq-item">
            <h3>What video formats does FileLocker support?</h3>
            <p>FileLocker can protect common video formats including <code>.mp4</code>, <code>.mov</code>, <code>.mkv</code>, and <code>.avi</code>. The file data is encrypted without depending on a particular media format.</p>
          </div>
          <div class="faq-item">
            <h3>Can FileLocker handle very large video files?</h3>
            <p>FileLocker processes video in smaller chunks instead of requiring the entire source file to be held in memory at once. Actual limits depend on browser support, available storage, device resources, and the file.</p>
          </div>
          <div class="faq-item">
            <h3>Is my video uploaded to a server?</h3>
            <p>No. FileLocker processes your video entirely on your device. Because there are no network uploads, processing speed also depends on your browser, device resources, and local storage performance.</p>
          </div>
          <div class="faq-item">
            <h3>How do I share a protected video?</h3>
            <p>After protecting your video, you will have a <code>.vault</code> file. Upload it to Google Drive, Dropbox, or a USB drive. The recipient opens it using FileLocker's unlock tool with the correct password.</p>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <div class="cta-banner mt-8 animate-fade-in-up">
        <p class="cta-label">Ready to secure your video?</p>
        <a href="/lock-file/" class="cta-button">Protect a Video Now</a>
      </div>

    </div>
  </div>
</Layout>
