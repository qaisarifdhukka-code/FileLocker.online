                            <a href="/guides/how-to-password-protect-files/" class="text-slate-700 font-semibold hover:text-brand-blue transition-colors flex items-center gap-1 group">
                                <span class="group-hover:translate-x-0.5 transition-transform">How to Protect Any File</span>
                            </a>
                        </li>
                        <li>
                            <a href="/guides/how-to-password-protect-a-folder/" class="text-slate-700 font-semibold hover:text-brand-blue transition-colors flex items-center gap-1 group">
                                <span class="group-hover:translate-x-0.5 transition-transform">How to Protect a Folder</span>
