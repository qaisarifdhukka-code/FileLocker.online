    </header>

    <!-- FULLSCREEN MOBILE NAVIGATION DRAWER (Image 2 & 3 direction) -->
    <div id="mobile-menu" class="fixed inset-0 z-50 bg-white hidden flex-col justify-between p-6 sm:p-8 overflow-y-auto md:hidden transition-all duration-300">
