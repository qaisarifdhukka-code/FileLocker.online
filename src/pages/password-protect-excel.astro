---
import Layout from '../layouts/Layout.astro';
import ProvisioningApp from '../components/ProvisioningApp';

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "FileLocker — Password Protect Excel Online",
  "url": "https://filelocker.online/password-protect-excel/",
  "applicationCategory": "SecurityApplication",
  "operatingSystem": "All modern browsers (Chrome, Edge, Firefox, Safari)",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Free online tool to password protect Excel spreadsheets (.xlsx, .xls, .csv) directly in your browser with AES-256 encryption. Zero server uploads, 100% private."
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Password Protect an Excel File Online with FileLocker",
  "description": "Step-by-step instructions to encrypt and password protect an Excel workbook directly in your browser without uploading financial data to any server.",
  "step": [
    {
      "@type": "HowToStep",
      "name": "Select Your Excel Spreadsheet",
      "text": "Drop your .xlsx, .xls, or .csv file into the encryption tool. The spreadsheet is read directly into your browser's private memory."
    },
    {
      "@type": "HowToStep",
      "name": "Set a Secure Password",
      "text": "Enter your encryption passphrase. FileLocker derives an authenticated AES-256 key using memory-hard Argon2id (64MB RAM)."
    },
    {
      "@type": "HowToStep",
      "name": "Save Your Encrypted .vault Container",
      "text": "Click Lock File. The browser encrypts the spreadsheet locally and saves a secure .vault container to your device."
    }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://filelocker.online/" },
    { "@type": "ListItem", "position": 2, "name": "Tools", "item": "https://filelocker.online/lock-file/" },
    { "@type": "ListItem", "position": 3, "name": "Password Protect Excel", "item": "https://filelocker.online/password-protect-excel/" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is my Excel spreadsheet uploaded to a server?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. FileLocker processes your Excel spreadsheet entirely inside your browser using client-side JavaScript and the native Web Crypto API. Sensitive financial data, salaries, and formulas never leave your computer."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between Excel's 'Protect Sheet' and FileLocker encryption?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Excel's 'Protect Sheet' feature does NOT encrypt your data. Anyone can extract the .xlsx ZIP archive and delete the sheetProtection tag from the XML file in seconds. FileLocker provides true cryptographic encryption: all workbook bytes are encrypted using authenticated AES-256-GCM."
      }
    },
    {
      "@type": "Question",
      "name": "Can I password protect CSV files with FileLocker?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! Native Microsoft Excel cannot password protect plain-text .csv files without converting them to .xlsx first. FileLocker allows you to encrypt any raw CSV file with AES-256 directly in your browser."
      }
    },
    {
      "@type": "Question",
      "name": "How does my accountant or client open the protected Excel file?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Send them the .vault file and share the password through a secure channel. They can open filelocker.online/unlock-file/ in any browser (Chrome, Edge, Safari, Firefox), enter the password, and instantly restore the original spreadsheet."
      }
    }
  ]
};
---

<Layout 
  title="Password Protect Excel Online Free (AES-256) | FileLocker"
  description="Password protect Excel files (.xlsx, .xls, .csv) online for free. Encrypt financial spreadsheets in your browser with AES-256. Zero uploads, 100% private."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(howToSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <!-- HERO SECTION WITH INTEGRATED TOOL -->
  <section class="w-full relative overflow-hidden bg-white pt-16 pb-20 border-b border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 border border-emerald-100 text-xs font-semibold text-emerald-800 mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
        <span>Dedicated Excel &amp; Spreadsheet Locker · Zero Server Uploads</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-gray-900 leading-tight mb-4 tracking-tight">
        Password Protect <span class="text-emerald-600">Excel Files</span> Online Free
      </h1>
      <p class="text-base sm:text-lg text-gray-600 max-w-2xl mx-auto mb-10 leading-relaxed font-normal">
        Lock confidential financial models, payroll sheets, and client CSVs with client-side AES-256-GCM encryption. Processed 100% in your browser without uploading financial records to any server.
      </p>

      <!-- LIVE INTERACTIVE TOOL DROPZONE -->
      <div class="w-full max-w-2xl mx-auto bg-white rounded-3xl border border-gray-200/90 shadow-[0_12px_45px_rgba(0,0,0,0.08)] overflow-hidden text-left mb-6">
        <div class="bg-gradient-to-r from-emerald-600 via-teal-600 to-indigo-600 px-6 py-4 text-white flex items-center justify-between">
          <div class="flex items-center gap-2.5">
            <span class="p-1.5 bg-white/20 rounded-lg text-white">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>
              </svg>
            </span>
            <div>
              <div class="font-bold text-sm sm:text-base leading-tight">Excel Spreadsheet Locker</div>
              <div class="text-[11px] text-white/80">Supports .xlsx, .xls, .csv · AES-256-GCM + Argon2id</div>
            </div>
          </div>
          <span class="text-xs bg-white/15 px-3 py-1 rounded-full font-medium border border-white/20">Private Mode</span>
        </div>

        <div class="p-4 sm:p-6">
          <ProvisioningApp 
            client:load 
            initialMode="file" 
            acceptExtensions=".xlsx,.xls,.csv" 
            formatName="Excel" 
            hideHeader={true} 
            customTitle="Protect Excel Spreadsheet"
            customSubtitle="Drop your .xlsx, .xls, or .csv file below to encrypt it with a private password."
          />
        </div>

        <div class="bg-gray-50 border-t border-gray-100 py-3 px-6 flex flex-wrap items-center justify-between gap-2 text-xs text-gray-500">
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span><strong>Zero server uploads:</strong> Financial spreadsheets never touch the cloud</span>
          </div>
          <a href="/guides/password-protect-excel/" class="text-brand-blue font-semibold hover:underline">
            Read complete Excel guide →
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- FORMAT-SPECIFIC EDUCATIONAL AUTHORITY & TECHNICAL BREAKDOWN -->
  <section class="w-full bg-[#f8fafc] py-16 px-4 sm:px-6">
    <div class="max-w-4xl mx-auto space-y-12">

      <!-- THE EXCEL SHEET PROTECTION MYTH -->
      <div class="bg-white rounded-2xl border border-gray-200/80 p-8 shadow-sm">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-50 text-amber-800 text-xs font-bold uppercase tracking-wider mb-4 border border-amber-200">
          ⚠️ Critical Accounting Flaw
        </div>
        <h2 class="text-2xl font-bold text-gray-900 mb-4">
          Why "Protect Sheet" in Excel Does Not Encrypt Your Data
        </h2>
        <p class="text-gray-700 leading-relaxed mb-4">
          Thousands of finance professionals and business owners rely on Excel's built-in <strong>"Protect Current Sheet"</strong> button to protect confidential salaries, revenue projections, and customer lists. Unfortunately, this feature was never intended for security:
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-6">
          <div class="p-4 rounded-xl border border-red-200 bg-red-50/50">
            <h3 class="font-bold text-red-900 text-sm mb-2 flex items-center gap-1.5">
              <span>✕</span> Excel "Protect Sheet" Vulnerability
            </h3>
            <p class="text-xs text-red-800 leading-relaxed">
              Modern <code>.xlsx</code> files are simply ZIP archives of XML documents. Anyone can rename <code>file.xlsx</code> to <code>file.zip</code>, open <code>xl/worksheets/sheet1.xml</code>, delete the <code>&lt;sheetProtection /&gt;</code> line, and re-save. The protection is gone in 30 seconds without ever knowing the password.
            </p>
          </div>
          <div class="p-4 rounded-xl border border-emerald-200 bg-emerald-50/50">
            <h3 class="font-bold text-emerald-900 text-sm mb-2 flex items-center gap-1.5">
              <span>✓</span> FileLocker Cryptographic Container
            </h3>
            <p class="text-xs text-emerald-800 leading-relaxed">
              FileLocker treats the spreadsheet as raw binary data and encrypts every single byte using authenticated AES-256-GCM. The XML structures, cell values, and embedded macros cannot be opened, inspected, or unzipped by any attacker.
            </p>
          </div>
        </div>
        <p class="text-gray-600 text-sm">
          Looking for Microsoft Excel menu instructions? Read our in-depth article: <a href="/guides/password-protect-excel/" class="text-brand-blue font-semibold hover:underline">How to Password Protect an Excel File Guide</a>.
        </p>
      </div>

      <!-- EXCEL NATIVE ENCRYPTION VS CSV CHALLENGE -->
      <div class="bg-white rounded-2xl border border-gray-200/80 p-8 shadow-sm">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">
          Spreadsheet Encryption: Method Comparison
        </h2>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm border-collapse">
            <thead>
              <tr class="border-b border-gray-200 bg-gray-50/70 text-gray-700 font-semibold">
                <th class="py-3 px-4">Feature</th>
                <th class="py-3 px-4 text-emerald-700">FileLocker.online</th>
                <th class="py-3 px-4 text-gray-600">Excel "Encrypt with Password"</th>
                <th class="py-3 px-4 text-gray-600">Excel "Protect Sheet"</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 text-gray-700">
              <tr>
                <td class="py-3.5 px-4 font-medium">True Cryptography</td>
                <td class="py-3.5 px-4 font-bold text-emerald-700">Yes (AES-256-GCM)</td>
                <td class="py-3.5 px-4">Yes (AES-256)</td>
                <td class="py-3.5 px-4 text-red-600 font-medium">No (Easily bypassed XML tag)</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-medium">CSV File Support</td>
                <td class="py-3.5 px-4 font-bold text-emerald-700">Native (.csv supported)</td>
                <td class="py-3.5 px-4 text-red-600 font-medium">No (Must convert to .xlsx)</td>
                <td class="py-3.5 px-4 text-red-600 font-medium">No</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-medium">Requires Office 365</td>
                <td class="py-3.5 px-4 font-bold text-emerald-700">No (Works in any browser)</td>
                <td class="py-3.5 px-4">Yes (Desktop Excel needed)</td>
                <td class="py-3.5 px-4">Yes</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-medium">Brute-Force Resistance</td>
                <td class="py-3.5 px-4 font-bold text-emerald-700">Argon2id (64MB RAM hardness)</td>
                <td class="py-3.5 px-4">SHA-512 (GPU-crackable)</td>
                <td class="py-3.5 px-4 text-red-600 font-medium">Zero resistance</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-medium">Zero-Knowledge Cloud Safe</td>
                <td class="py-3.5 px-4 font-bold text-emerald-700">Yes (Encrypted before upload)</td>
                <td class="py-3.5 px-4">Depends on OneDrive config</td>
                <td class="py-3.5 px-4 text-red-600 font-medium">No</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- FAQ SECTION -->
      <div class="bg-white rounded-2xl border border-gray-200/80 p-8 shadow-sm">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Frequently Asked Questions: Excel Security</h2>
        <div class="space-y-6">
          <div class="border-b border-gray-100 pb-5">
            <h3 class="font-bold text-gray-900 text-base mb-2">Can someone read my formulas or macros if I encrypt with FileLocker?</h3>
            <p class="text-gray-600 text-sm leading-relaxed">
              No. When you protect an Excel file with FileLocker, all data inside—including formulas, VBA macros, cell values, and sheet names—is scrambled into ciphertext using AES-256. No one can inspect your formulas without the decryption key.
            </p>
          </div>
          <div class="border-b border-gray-100 pb-5">
            <h3 class="font-bold text-gray-900 text-base mb-2">How can I protect a CSV export from QuickBooks or Stripe?</h3>
            <p class="text-gray-600 text-sm leading-relaxed">
              Simply drop your <code>.csv</code> file into the tool above, type a password, and click Lock File. FileLocker encrypts CSV files without requiring you to open Excel or convert them to <code>.xlsx</code>.
            </p>
          </div>
          <div>
            <h3 class="font-bold text-gray-900 text-base mb-2">How do I decrypt an Excel file later?</h3>
            <p class="text-gray-600 text-sm leading-relaxed">
              Visit <a href="/unlock-file/" class="text-brand-blue font-semibold hover:underline">filelocker.online/unlock-file/</a>, select your <code>.vault</code> file, enter your password, and click Unlock File. Your browser restores the original Excel spreadsheet instantly.
            </p>
          </div>
        </div>
      </div>

      <!-- BOTTOM CALL TO ACTION -->
      <div class="bg-gradient-to-r from-emerald-600 to-teal-700 rounded-2xl p-8 sm:p-10 text-white text-center shadow-lg">
        <h2 class="text-2xl sm:text-3xl font-extrabold mb-3">Protect Financial Data with Complete Privacy</h2>
        <p class="text-emerald-100 max-w-xl mx-auto mb-6 text-sm sm:text-base">
          Scroll up to encrypt your spreadsheet, or unlock an existing protected file.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="#top" class="px-6 py-3 rounded-full bg-white text-emerald-800 font-bold text-sm shadow hover:bg-emerald-50 transition-colors">
            Encrypt Excel Spreadsheet
          </a>
          <a href="/unlock-file/" class="px-6 py-3 rounded-full bg-white/10 hover:bg-white/20 text-white font-bold text-sm border border-white/20 transition-colors">
            Unlock Protected File
          </a>
        </div>
      </div>

    </div>
  </section>
</Layout>

