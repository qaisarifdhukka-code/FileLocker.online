---
import Layout from '../layouts/Layout.astro';
import ProvisioningApp from '../components/ProvisioningApp';

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "FileLocker — Password Protect PDF Online",
  "url": "https://filelocker.online/password-protect-pdf/",
  "applicationCategory": "SecurityApplication",
  "operatingSystem": "All modern browsers (Chrome, Edge, Firefox, Safari)",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Free online tool to password protect PDF files in your browser with AES-256 encryption. Zero server uploads, no Adobe Acrobat required, and 100% private."
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": "How to Password Protect a PDF File Online with FileLocker",
  "description": "Step-by-step instructions to encrypt and password protect a PDF document directly in your browser without uploading it to any server.",
  "step": [
    {
      "@type": "HowToStep",
      "name": "Select Your PDF Document",
      "text": "Drop your PDF into the tool or click Browse. The file is read entirely in local browser memory without uploading any bytes to a remote server."
    },
    {
      "@type": "HowToStep",
      "name": "Set a Strong Master Passphrase",
      "text": "Enter your encryption password. FileLocker derives an authenticated 256-bit AES-GCM key using memory-hard Argon2id (64MB RAM)."
    },
    {
      "@type": "HowToStep",
      "name": "Download the Encrypted .vault File",
      "text": "Click Lock File. The browser encrypts the PDF locally in milliseconds and saves an authenticated .vault container directly to your device."
    }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://filelocker.online/" },
    { "@type": "ListItem", "position": 2, "name": "Tools", "item": "https://filelocker.online/lock-file/" },
    { "@type": "ListItem", "position": 3, "name": "Password Protect PDF", "item": "https://filelocker.online/password-protect-pdf/" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is my PDF uploaded to a server when I protect it?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Unlike cloud PDF tools such as Smallpdf or iLovePDF that transfer your documents to remote cloud storage, FileLocker performs 100% of the cryptographic operations inside your web browser using WebAssembly Argon2id and the Web Crypto API. Zero bytes leave your computer."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need an Adobe Acrobat Pro subscription to password protect a PDF?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Adobe Acrobat Pro costs over $239 per year just to password protect documents. FileLocker is completely free, requires no subscription, and needs no software installation."
      }
    },
    {
      "@type": "Question",
      "name": "What is the difference between a PDF permission password and FileLocker encryption?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Standard PDF 'permission' or 'owner' passwords only restrict printing or editing; the actual text and images remain unencrypted and can be trivially extracted in seconds using command-line tools like qpdf. FileLocker encrypts the entire raw PDF binary stream with authenticated AES-256-GCM, making inspection mathematically impossible without the password."
      }
    },
    {
      "@type": "Question",
      "name": "How does the recipient open the password-protected PDF?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The recipient opens FileLocker's free Unlock Tool at filelocker.online/unlock-file/, selects the .vault file, and enters the password. The original PDF decrypts in their browser instantly."
      }
    },
    {
      "@type": "Question",
      "name": "Can FileLocker recover a forgotten PDF password?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. FileLocker operates under a zero-knowledge architecture. No encryption keys or passwords are ever stored on any server. If you forget your password, the encrypted PDF cannot be recovered."
      }
    }
  ]
};
---

<Layout 
  title="Password Protect PDF Online Free (AES-256) | FileLocker"
  description="Password protect PDF files online for free. Encrypt tax forms, legal documents, and contracts directly in your browser with AES-256. Zero uploads, no Adobe."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(webAppSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(howToSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <!-- HERO SECTION WITH INTEGRATED TOOL -->
  <section class="w-full relative overflow-hidden bg-white pt-16 pb-20 border-b border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-red-50 border border-red-100 text-xs font-semibold text-red-700 mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-red-600 animate-pulse"></span>
        <span>Dedicated PDF Encryption Tool · Zero Server Uploads</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-gray-900 leading-tight mb-4 tracking-tight">
        Password Protect <span class="text-brand-blue">PDF Files</span> Online Free
      </h1>
      <p class="text-base sm:text-lg text-gray-600 max-w-2xl mx-auto mb-10 leading-relaxed font-normal">
        Lock confidential PDF contracts, financial statements, and tax forms with client-side AES-256-GCM encryption. Processed 100% on your device with no uploads and no Adobe subscription.
      </p>

      <!-- LIVE INTERACTIVE TOOL DROPZONE -->
      <div class="w-full max-w-2xl mx-auto bg-white rounded-3xl border border-gray-200/90 shadow-[0_12px_45px_rgba(0,0,0,0.08)] overflow-hidden text-left mb-6">
        <div class="bg-gradient-to-r from-red-600 via-rose-600 to-indigo-600 px-6 py-4 text-white flex items-center justify-between">
          <div class="flex items-center gap-2.5">
            <span class="p-1.5 bg-white/20 rounded-lg text-white">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14h-2v-2h2v2zm0-4h-2V7h2v5z"/>
              </svg>
            </span>
            <div>
              <div class="font-bold text-sm sm:text-base leading-tight">PDF Document Locker</div>
              <div class="text-[11px] text-white/80">AES-256-GCM + Argon2id · In-Browser Processing</div>
            </div>
          </div>
          <span class="text-xs bg-white/15 px-3 py-1 rounded-full font-medium border border-white/20">Private Mode</span>
        </div>

        <div class="p-4 sm:p-6">
          <ProvisioningApp 
            client:load 
            initialMode="file" 
            acceptExtensions=".pdf" 
            formatName="PDF" 
            hideHeader={true} 
            customTitle="Protect PDF Document"
            customSubtitle="Drop your PDF below to lock it with a private password."
          />
        </div>

        <div class="bg-gray-50 border-t border-gray-100 py-3 px-6 flex flex-wrap items-center justify-between gap-2 text-xs text-gray-500">
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span><strong>Zero server uploads:</strong> Data stays in your browser memory</span>
          </div>
          <a href="/guides/password-protect-pdf/" class="text-brand-blue font-semibold hover:underline">
            Read complete PDF guide →
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- FORMAT-SPECIFIC EDUCATIONAL AUTHORITY & TECHNICAL BREAKDOWN -->
  <section class="w-full bg-[#f8fafc] py-16 px-4 sm:px-6">
    <div class="max-w-4xl mx-auto space-y-12">

      <!-- THE PDF SECURITY TRAP: OWNER PASSWORDS VS CONTAINER ENCRYPTION -->
      <div class="bg-white rounded-2xl border border-gray-200/80 p-8 shadow-sm">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-50 text-amber-800 text-xs font-bold uppercase tracking-wider mb-4 border border-amber-200">
          ⚠️ Critical Security Flaw
        </div>
        <h2 class="text-2xl font-bold text-gray-900 mb-4">
          The Hidden Flaw in Standard "PDF Passwords"
        </h2>
        <p class="text-gray-700 leading-relaxed mb-4">
          Most online services and free desktop tools apply what the Adobe PDF standard calls <strong>"Owner Passwords"</strong> (also known as permissions passwords). These passwords restrict copying, printing, or form editing. However, <em>the document content itself is not truly encrypted</em>.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-6">
          <div class="p-4 rounded-xl border border-red-200 bg-red-50/50">
            <h3 class="font-bold text-red-900 text-sm mb-2 flex items-center gap-1.5">
              <span>✕</span> Standard PDF Permissions
            </h3>
            <p class="text-xs text-red-800 leading-relaxed">
              Anyone with command-line utilities like <code>qpdf --decrypt</code> or free web strippers can bypass the restriction in under 1 second. Your sensitive contract or tax form is immediately exposed.
            </p>
          </div>
          <div class="p-4 rounded-xl border border-emerald-200 bg-emerald-50/50">
            <h3 class="font-bold text-emerald-900 text-sm mb-2 flex items-center gap-1.5">
              <span>✓</span> FileLocker Authenticated AES-GCM
            </h3>
            <p class="text-xs text-emerald-800 leading-relaxed">
              FileLocker wraps your raw PDF bytes into a tamper-proof <code>.vault</code> container. Without the exact passphrase, the file cannot be rendered, printed, parsed, or decrypted by any utility on earth.
            </p>
          </div>
        </div>
        <p class="text-gray-600 text-sm">
          Want step-by-step instructions for native macOS Preview or Adobe Acrobat? Check our in-depth tutorial: <a href="/guides/password-protect-pdf/" class="text-brand-blue font-semibold hover:underline">How to Password Protect a PDF Guide</a>.
        </p>
      </div>

      <!-- ADOBE ACROBAT VS CLOUD UPLOADERS VS FILELOCKER -->
      <div class="bg-white rounded-2xl border border-gray-200/80 p-8 shadow-sm">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">
          PDF Encryption Method Comparison
        </h2>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm border-collapse">
            <thead>
              <tr class="border-b border-gray-200 bg-gray-50/70 text-gray-700 font-semibold">
                <th class="py-3 px-4">Feature</th>
                <th class="py-3 px-4 text-emerald-700">FileLocker.online</th>
                <th class="py-3 px-4 text-gray-600">Adobe Acrobat Pro</th>
                <th class="py-3 px-4 text-gray-600">Cloud Tools (Smallpdf/iLovePDF)</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 text-gray-700">
              <tr>
                <td class="py-3.5 px-4 font-medium">Cost</td>
                <td class="py-3.5 px-4 font-bold text-emerald-700">100% Free Forever</td>
                <td class="py-3.5 px-4">$239.88 / year</td>
                <td class="py-3.5 px-4">Free with limits / Paid sub</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-medium">Server Uploads</td>
                <td class="py-3.5 px-4 font-bold text-emerald-700">0 bytes (Browser memory)</td>
                <td class="py-3.5 px-4">Local (Desktop app)</td>
                <td class="py-3.5 px-4 text-red-600 font-medium">Yes (Sent to remote servers)</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-medium">Account Requirement</td>
                <td class="py-3.5 px-4 font-bold text-emerald-700">None (Instant access)</td>
                <td class="py-3.5 px-4">Adobe ID required</td>
                <td class="py-3.5 px-4">Email / Account required</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-medium">Cipher &amp; Key Derivation</td>
                <td class="py-3.5 px-4 font-bold text-emerald-700">AES-256-GCM + Argon2id (64MB)</td>
                <td class="py-3.5 px-4">AES-256 (Proprietary)</td>
                <td class="py-3.5 px-4">Varies / Cloud-managed</td>
              </tr>
              <tr>
                <td class="py-3.5 px-4 font-medium">Tamper Verification</td>
                <td class="py-3.5 px-4 font-bold text-emerald-700">Yes (128-bit AEAD tag)</td>
                <td class="py-3.5 px-4">Partial</td>
                <td class="py-3.5 px-4">None</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- FAQ SECTION -->
      <div class="bg-white rounded-2xl border border-gray-200/80 p-8 shadow-sm">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Frequently Asked Questions: PDF Protection</h2>
        <div class="space-y-6">
          <div class="border-b border-gray-100 pb-5">
            <h3 class="font-bold text-gray-900 text-base mb-2">Are my PDF files uploaded to your servers?</h3>
            <p class="text-gray-600 text-sm leading-relaxed">
              No. FileLocker executes 100% within your web browser using WebAssembly and the native Web Crypto API. Your PDF documents never leave your computer or smartphone. You can verify this independently in DevTools under the Network tab.
            </p>
          </div>
          <div class="border-b border-gray-100 pb-5">
            <h3 class="font-bold text-gray-900 text-base mb-2">Can I password protect scanned tax returns and legal contracts?</h3>
            <p class="text-gray-600 text-sm leading-relaxed">
              Yes. FileLocker is specifically designed for confidential documents like IRS 1040 tax forms, W-2s, non-disclosure agreements, medical records, and bank statements where zero-knowledge privacy is mandatory.
            </p>
          </div>
          <div class="border-b border-gray-100 pb-5">
            <h3 class="font-bold text-gray-900 text-base mb-2">How does my recipient open the protected PDF?</h3>
            <p class="text-gray-600 text-sm leading-relaxed">
              Send the resulting <code>.vault</code> file to your recipient via email, Slack, or Google Drive, and share the password through a separate secure channel (such as Signal or SMS). The recipient navigates to <a href="/unlock-file/" class="text-brand-blue font-semibold hover:underline">filelocker.online/unlock-file/</a>, selects the file, enters the password, and downloads the original PDF.
            </p>
          </div>
          <div>
            <h3 class="font-bold text-gray-900 text-base mb-2">What if I forget my password?</h3>
            <p class="text-gray-600 text-sm leading-relaxed">
              Because FileLocker adheres strictly to zero-knowledge encryption, we do not have master recovery keys, backdoors, or database logs. If you lose your password, the PDF is mathematically unrecoverable.
            </p>
          </div>
        </div>
      </div>

      <!-- BOTTOM CALL TO ACTION -->
      <div class="bg-gradient-to-r from-blue-600 to-indigo-700 rounded-2xl p-8 sm:p-10 text-white text-center shadow-lg">
        <h2 class="text-2xl sm:text-3xl font-extrabold mb-3">Ready to Secure Your PDF?</h2>
        <p class="text-blue-100 max-w-xl mx-auto mb-6 text-sm sm:text-base">
          Scroll up to encrypt your PDF in seconds, or unlock an existing protected file.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href="#top" class="px-6 py-3 rounded-full bg-white text-brand-blue font-bold text-sm shadow hover:bg-blue-50 transition-colors">
            Encrypt PDF Now
          </a>
          <a href="/unlock-file/" class="px-6 py-3 rounded-full bg-white/10 hover:bg-white/20 text-white font-bold text-sm border border-white/20 transition-colors">
            Open / Unlock Protected PDF
          </a>
        </div>
      </div>

    </div>
  </section>
</Layout>

