---
import Layout from '../layouts/Layout.astro';

const techArticleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": "FileLocker Cryptographic Security Architecture & Threat Model",
  "description": "Comprehensive technical whitepaper on FileLocker's zero-knowledge client-side encryption architecture, featuring Argon2id key derivation, AES-GCM 256-bit authenticated encryption, POSIX TAR folder packaging, and Web Streams OPFS streaming.",
  "inLanguage": "en-US",
  "author": {
    "@type": "Organization",
    "name": "FileLocker Security Engineering Team",
    "url": "https://filelocker.online/"
  },
  "publisher": {
    "@type": "Organization",
    "name": "FileLocker",
    "url": "https://filelocker.online/"
  },
  "datePublished": "2026-10-01",
  "dateModified": "2026-11-03",
  "articleBody": "This document outlines the cryptographic specifications, key derivation protocols, binary container formats, and formal threat model implemented in FileLocker.online."
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://filelocker.online/" },
    { "@type": "ListItem", "position": 2, "name": "Security Architecture", "item": "https://filelocker.online/security/" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Why does FileLocker use Argon2id instead of PBKDF2?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Argon2id won the international Password Hashing Competition (PHC) and is formalized in RFC 9106. Unlike older algorithms such as PBKDF2 and bcrypt, Argon2id is memory-hard. FileLocker allocates 64 MB of RAM per hash evaluation, making mass parallel cracking attempts with consumer GPUs, cloud clusters, and dedicated ASIC hardware prohibitively expensive."
      }
    },
    {
      "@type": "Question",
      "name": "How does FileLocker prevent data tampering during transfer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "FileLocker uses AES-GCM (Galois/Counter Mode), an authenticated encryption cipher (AEAD). Along with encrypting plaintext into ciphertext, AES-GCM calculates a 128-bit authentication tag over the data. If even a single bit of the file is flipped or corrupted, the browser's Web Crypto engine immediately rejects the payload and halts decryption."
      }
    },
    {
      "@type": "Question",
      "name": "Can FileLocker or its hosting provider access user files or passwords?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. The FileLocker web application is served as static HTML and JavaScript assets via edge CDN. Once loaded into the client's browser, all key derivation, encryption, and TAR packaging run strictly inside the local browser JavaScript engine. Zero network requests containing file bytes or passphrases are ever made."
      }
    },
    {
      "@type": "Question",
      "name": "How does FileLocker protect entire folder hierarchies?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "When a folder is selected via the File System Access API, FileLocker creates an in-memory POSIX UStar TAR stream on the fly, packaging all nested subdirectories, file names, and relative paths into a unified binary stream before feeding it directly into the AES-GCM encryption pipeline. No temporary unencrypted files are ever written to disk."
      }
    }
  ]
};
---

<Layout 
  title="Cryptographic Security Whitepaper & Architecture | FileLocker" 
  description="Formal cryptographic specification of FileLocker. Verified Argon2id key derivation, authenticated AES-GCM 256-bit encryption, and zero-knowledge threat model."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(techArticleSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <!-- HERO -->
  <div class="guide-hero">
    <div class="hero-shape hero-shape-1"></div>
    <div class="hero-shape hero-shape-2"></div>
    <div class="hero-shape hero-shape-3"></div>
    <div class="hero-inner" style="text-align:center; max-width:52rem;">
      <nav class="hero-breadcrumb">
        <a href="/">Home</a>
        <span class="separator">/</span>
        <span class="current">Security Whitepaper</span>
      </nav>
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-50 border border-blue-100 text-brand-blue text-xs font-bold uppercase tracking-wider mb-5">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C9.243 2 7 4.243 7 7v3H6c-1.103 0-2 .897-2 2v8c0 1.103.897 2 2 2h12c1.103 0 2-.897 2-2v-8c0-1.103-.897-2-2-2h-1V7c0-2.757-2.243-5-5-5zm0 2c1.654 0 3 1.346 3 3v3H9V7c0-1.654 1.346-3 3-3z"/></svg>
        Technical Whitepaper · RFC 9106 · NIST SP 800-38D
      </span>
      <h1>Cryptographic Security Architecture &amp; Threat Model</h1>
      <p class="hero-subtitle" style="margin:0 auto; max-width:42rem;">
        An engineering-grade specification of FileLocker's zero-knowledge client-side encryption engine, memory-hard key derivation, and formal threat boundaries.
      </p>
    </div>
  </div>

  <!-- MAIN WHITEPAPER BODY -->
  <div class="w-full bg-[#f8fafc] py-12 px-6">
    <div class="max-w-4xl mx-auto space-y-10">

      <!-- SECTION 1: EXECUTIVE SUMMARY -->
      <div class="content-card animate-fade-in-up">
        <div class="prose max-w-none text-gray-700 leading-relaxed">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">1. Executive Summary &amp; Core Security Philosophy</h2>
          <p>
            The foundational principle of FileLocker is <strong>Zero-Knowledge Architecture</strong>. In traditional cloud conversion tools and web lockers (such as Smallpdf, iLovePDF, or cloud PDF lockers), user files are uploaded to remote multi-tenant backend servers where encryption is executed server-side. This architecture forces users to trust the hosting provider's infrastructure, administrators, TLS configuration, and data-retention policies.
          </p>
          <p>
            FileLocker inverts this model: <strong>zero bytes of user plaintext, ciphertext, or passphrases ever leave the client device</strong>. The web application is served as static, immutable HTML, JavaScript, and WebAssembly bundles via a global CDN. All cryptographic computations execute strictly within the browser's local sandbox using the hardware-accelerated W3C Web Cryptography API and native WebAssembly primitives.
          </p>
        </div>
      </div>

      <!-- SECTION 2: VERIFIED SPECIFICATIONS TABLE -->
      <div class="content-card animate-fade-in-up">
        <h2 class="section-heading">2. Cryptographic Parameter Matrix (Verified from Source)</h2>
        <p class="text-gray-600 mb-6 text-sm">
          Every cryptographic parameter implemented in FileLocker adheres strictly to current OWASP, NIST, and IETF standards:
        </p>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs sm:text-sm border-collapse">
            <thead>
              <tr class="border-b border-gray-200 bg-gray-50 text-gray-900">
                <th class="py-3 px-3.5 font-bold">Cryptographic Component</th>
                <th class="py-3 px-3.5 font-bold">Implementation Specification</th>
                <th class="py-3 px-3.5 font-bold">Standard / Authority</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 text-gray-700">
              <tr class="bg-blue-50/40">
                <td class="py-3 px-3.5 font-bold text-brand-blue">Key Derivation Function (KDF)</td>
                <td class="py-3 px-3.5 font-mono text-xs">Argon2id (hash-wasm WebAssembly)</td>
                <td class="py-3 px-3.5">RFC 9106 / PHC Winner</td>
              </tr>
              <tr>
                <td class="py-3 px-3.5 font-semibold text-gray-900">KDF Memory Hardness (m)</td>
                <td class="py-3 px-3.5 font-mono text-xs">65,536 KB (64 MB of RAM)</td>
                <td class="py-3 px-3.5">OWASP Recommended Baseline</td>
              </tr>
              <tr>
                <td class="py-3 px-3.5 font-semibold text-gray-900">KDF Time Cost (t)</td>
                <td class="py-3 px-3.5 font-mono text-xs">3 passes</td>
                <td class="py-3 px-3.5">RFC 9106 Recommendation</td>
              </tr>
              <tr>
                <td class="py-3 px-3.5 font-semibold text-gray-900">KDF Parallelism (p)</td>
                <td class="py-3 px-3.5 font-mono text-xs">1 thread</td>
                <td class="py-3 px-3.5">Browser WebAssembly Sandbox</td>
              </tr>
              <tr>
                <td class="py-3 px-3.5 font-semibold text-gray-900">Salt Generation</td>
                <td class="py-3 px-3.5 font-mono text-xs">16 bytes (128-bit) CSPRNG</td>
                <td class="py-3 px-3.5">crypto.getRandomValues()</td>
              </tr>
              <tr class="bg-blue-50/40">
                <td class="py-3 px-3.5 font-bold text-brand-blue">Symmetric Cipher</td>
                <td class="py-3 px-3.5 font-mono text-xs">AES-GCM 256-bit (Galois/Counter Mode)</td>
                <td class="py-3 px-3.5">NIST SP 800-38D / FIPS 197</td>
              </tr>
              <tr>
                <td class="py-3 px-3.5 font-semibold text-gray-900">Initialization Vector (IV/Nonce)</td>
                <td class="py-3 px-3.5 font-mono text-xs">12 bytes (96-bit) CSPRNG per chunk</td>
                <td class="py-3 px-3.5">NIST SP 800-38D Recommended Nonce</td>
              </tr>
              <tr>
                <td class="py-3 px-3.5 font-semibold text-gray-900">Authentication Tag Length</td>
                <td class="py-3 px-3.5 font-mono text-xs">128-bit MAC Tag</td>
                <td class="py-3 px-3.5">Full Galois Field Authenticity</td>
              </tr>
              <tr>
                <td class="py-3 px-3.5 font-semibold text-gray-900">Folder Packaging Container</td>
                <td class="py-3 px-3.5 font-mono text-xs">In-memory POSIX UStar TAR stream</td>
                <td class="py-3 px-3.5">POSIX.1-1988 Standard</td>
              </tr>
              <tr>
                <td class="py-3 px-3.5 font-semibold text-gray-900">Large File Memory Pipeline</td>
                <td class="py-3 px-3.5 font-mono text-xs">Web Streams API + OPFS</td>
                <td class="py-3 px-3.5">W3C File System Access Spec</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- SECTION 3: KEY DERIVATION (ARGON2ID) -->
      <div class="content-card animate-fade-in-up">
        <div class="prose max-w-none text-gray-700 leading-relaxed">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">3. Key Derivation: Argon2id (RFC 9106)</h2>
          <p>
            Passwords chosen by humans often exhibit lower entropy than raw cryptographic keys. When converting a user password into a 256-bit AES key, the strength of the derivation function determines the attacker's brute-force economics.
          </p>
          <p>
            FileLocker implements <strong>Argon2id</strong> via optimized WebAssembly (compiled from reference C implementations). Argon2id combines memory-independent cache timing protection (from Argon2i) with memory-dependent side-channel resistance (from Argon2d):
          </p>
          <ul class="space-y-2 pl-5 list-disc text-sm sm:text-base">
            <li>
              <strong>Memory-Hardness:</strong> Every key derivation allocates exactly <strong>64 Megabytes (65,536 KB)</strong> of high-speed memory. An adversary attempting to crack passwords using parallel GPU mining rigs or specialized ASIC clusters is severely bottlenecked by memory bandwidth and die size, rendering distributed dictionary attacks cost-prohibitive.
            </li>
            <li>
              <strong>CSPRNG Salt:</strong> For every encrypted container, a fresh 16-byte cryptographically secure pseudorandom salt is generated via <code>crypto.getRandomValues()</code>. This guarantees that identical passwords generate completely distinct cryptographic keys, defeating rainbow table attacks.
            </li>
          </ul>
        </div>
      </div>

      <!-- SECTION 4: DATA ENCRYPTION (AES-GCM) -->
      <div class="content-card animate-fade-in-up">
        <div class="prose max-w-none text-gray-700 leading-relaxed">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">4. Authenticated Encryption: AES-GCM 256-bit</h2>
          <p>
            Payload encryption utilizes <strong>AES-GCM</strong> (Advanced Encryption Standard in Galois/Counter Mode). AES-GCM is an Authenticated Encryption with Associated Data (AEAD) construction:
          </p>
          <ul class="space-y-3 pl-5 list-disc text-sm sm:text-base">
            <li>
              <strong>Confidentiality:</strong> AES-256 employs 14 rounds of substitution-permutation network transformations. There are no known practical attacks against AES-256; exhaustive key search requires \(2^{256}\) operations, exceeding the number of atoms in the observable universe.
            </li>
            <li>
              <strong>Tamper-Proof Integrity:</strong> Unlike unauthenticated cipher modes (such as AES-CBC or AES-CTR) which are susceptible to bit-flipping and padding-oracle attacks, AES-GCM generates a 128-bit authentication tag over both the ciphertext and associated metadata. If any byte in the file is modified, truncated, or injected during transmission or storage, the browser's cryptographic engine throws a verification exception and immediately halts output.
            </li>
            <li>
              <strong>Nonce Discipline:</strong> Each encryption run generates a fresh 12-byte (96-bit) cryptographically random Initialization Vector (IV). Nonces are never reused under the same key.
            </li>
          </ul>
        </div>
      </div>

      <!-- SECTION 5: CONTAINER FORMAT (.VAULT) -->
      <div class="content-card animate-fade-in-up">
        <div class="prose max-w-none text-gray-700 leading-relaxed">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">5. The Portable .vault Container Architecture</h2>
          <p>
            FileLocker packages encrypted data into clean, self-contained <code>.vault</code> binary archives designed for maximum cross-platform compatibility:
          </p>
          <div class="my-4 p-4 bg-gray-900 text-gray-200 font-mono text-xs rounded-xl overflow-x-auto space-y-1">
            <div class="text-emerald-400 font-bold">// FileLocker .vault Verified Chunked Binary Container Specification</div>
            <div>[00..03] Magic Byte Identifier: 0x46 0x4C 0x54 0x52 ("FLTR" - 4 bytes)</div>
            <div>[04]     Format Version: 0x01 (1 byte)</div>
            <div>[05..08] Metadata JSON Length: 4 bytes (32-bit Little-Endian unsigned integer)</div>
            <div>[09..N]  Metadata JSON Payload (UTF-8 encoded JSON: &#123; originalName, fileSize, isFolder, salt, branding &#125;)</div>
            <div>[N+1..N+8] Global Chunk Nonce: 8 bytes CSPRNG entropy</div>
            <div class="text-indigo-300 font-semibold mt-2">// Authenticated Payload Chunks (10 MB streaming blocks):</div>
            <div>[Each Chunk] Initialization Vector: 12 bytes [IV]</div>
            <div>             Authentication Tag:    16 bytes (128-bit AES-GCM AEAD verification tag)</div>
            <div>             Ciphertext Block:      Encrypted payload slice (up to 10,485,760 bytes)</div>
          </div>
          <p class="text-sm">
            Because the container format is non-executable and carries no machine-specific binaries, it moves freely through corporate email gateways, Google Workspace filters, and messaging apps without triggering false-positive malware quarantines.
          </p>
        </div>
      </div>

      <!-- SECTION 6: FORMAL THREAT MODEL -->
      <div class="content-card animate-fade-in-up">
        <h2 class="section-heading">6. Formal Threat Model &amp; Adversary Analysis</h2>
        <p class="text-gray-600 mb-6 text-sm">
          A rigorous security evaluation of how FileLocker responds to specific adversary scenarios:
        </p>

        <div class="space-y-4">
          <div class="p-4 rounded-xl border border-emerald-200 bg-emerald-50/40">
            <div class="flex items-start gap-3">
              <span class="text-emerald-700 font-bold text-lg">✓</span>
              <div>
                <strong class="text-gray-900 block font-bold text-sm">Adversary: Cloud Storage &amp; Hosting Infrastructure (Google Drive, Dropbox, AWS)</strong>
                <p class="text-xs text-gray-700 mt-1 mb-0 leading-relaxed">
                  <em>Threat:</em> Cloud providers or subpoenaed hosting services inspect stored archives.  
                  <em>Mitigation:</em> Cloud hosts only store ciphertext. They have zero access to keys, passphrases, or plaintext metadata. Content inspection is mathematically impossible.
                </p>
              </div>
            </div>
          </div>

          <div class="p-4 rounded-xl border border-emerald-200 bg-emerald-50/40">
            <div class="flex items-start gap-3">
              <span class="text-emerald-700 font-bold text-lg">✓</span>
              <div>
                <strong class="text-gray-900 block font-bold text-sm">Adversary: Man-in-the-Middle (MITM) &amp; Passive Network Sniffers</strong>
                <p class="text-xs text-gray-700 mt-1 mb-0 leading-relaxed">
                  <em>Threat:</em> Network eavesdroppers intercept Wi-Fi or ISP traffic while the user encrypts or decrypts files.  
                  <em>Mitigation:</em> Zero bytes of file data or passwords traverse the network. All processing is confined to browser memory. Sniffers capture nothing.
                </p>
              </div>
            </div>
          </div>

          <div class="p-4 rounded-xl border border-emerald-200 bg-emerald-50/40">
            <div class="flex items-start gap-3">
              <span class="text-emerald-700 font-bold text-lg">✓</span>
              <div>
                <strong class="text-gray-900 block font-bold text-sm">Adversary: Active Ciphertext Manipulation (Bit-Flipping / Tampering)</strong>
                <p class="text-xs text-gray-700 mt-1 mb-0 leading-relaxed">
                  <em>Threat:</em> An attacker alters bytes inside the .vault file to inject malicious payload headers.  
                  <em>Mitigation:</em> AES-GCM's 128-bit authentication tag immediately detects any altered bits. Decryption fails instantly before any data is output.
                </p>
              </div>
            </div>
          </div>

          <div class="p-4 rounded-xl border border-amber-200 bg-amber-50/40">
            <div class="flex items-start gap-3">
              <span class="text-amber-700 font-bold text-lg">⚠️</span>
              <div>
                <strong class="text-gray-900 block font-bold text-sm">Adversary: Compromised Endpoint / Kernel-Level Keyloggers</strong>
                <p class="text-xs text-gray-700 mt-1 mb-0 leading-relaxed">
                  <em>Boundary:</em> If the client operating system is infected with active spyware, physical screen recorders, or kernel keyloggers, the adversary can capture the user's passphrase at keystroke entry. No cryptographic algorithm can protect against an actively compromised endpoint. Users must maintain basic device hygiene.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- SECTION 7: INDEPENDENT VERIFIABILITY -->
      <div class="content-card animate-fade-in-up">
        <div class="prose max-w-none text-gray-700 leading-relaxed">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">7. How to Verify Zero Network Transmission</h2>
          <p>
            Security claims must be verifiable. Any developer, security auditor, or privacy researcher can independently verify that FileLocker uploads zero bytes:
          </p>
          <ol class="space-y-2 pl-5 list-decimal text-sm sm:text-base">
            <li>Open Chrome, Firefox, Safari, or Edge and navigate to <a href="/lock-file/" class="text-brand-blue font-semibold hover:underline">filelocker.online/lock-file/</a>.</li>
            <li>Press <kbd class="px-2 py-0.5 bg-gray-100 rounded border text-xs font-mono">F12</kbd> (or right-click and select <em>Inspect</em>) to open Developer Tools.</li>
            <li>Switch to the <strong>Network</strong> tab and check the <em>"Preserve log"</em> checkbox.</li>
            <li>Select a multi-megabyte file or folder and click <strong>Lock File</strong>.</li>
            <li>Observe the network activity log: zero POST, PUT, or WebSocket requests are transmitted. The file size remains completely absent from upstream bandwidth metrics.</li>
          </ol>
        </div>
      </div>

      <!-- SECTION 8: FAQS -->
      <div class="content-card animate-fade-in-up">
        <h2 class="section-heading">Frequently Asked Questions</h2>
        <div class="faq-grid mt-6">
          <div class="faq-item">
            <h3>Why Argon2id instead of PBKDF2?</h3>
            <p>Argon2id is memory-hard (allocating 64MB RAM per hash), making mass GPU brute-force attacks economically and computationally infeasible compared to PBKDF2.</p>
          </div>
          <div class="faq-item">
            <h3>How are folders handled?</h3>
            <p>Folders are packaged on the fly into an in-memory POSIX UStar TAR stream, preserving subdirectories and filenames before being encrypted via AES-GCM.</p>
          </div>
          <div class="faq-item">
            <h3>Can FileLocker decrypt my files?</h3>
            <p>No. FileLocker holds zero master keys and has no database of user passwords. If you lose your password, the data is unrecoverable.</p>
          </div>
          <div class="faq-item">
            <h3>Is Web Crypto safe for enterprise data?</h3>
            <p>Yes. The W3C Web Cryptography API is compiled directly into browser binaries by Apple, Google, and Mozilla using FIPS-tested cryptographic libraries.</p>
          </div>
        </div>
      </div>

      <!-- SECTION 8: RESPONSIBLE DISCLOSURE & SECURITY POLICY -->
      <div class="content-card animate-fade-in-up">
        <div class="prose max-w-none text-gray-700 leading-relaxed">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">8. Responsible Disclosure &amp; Independent Auditing</h2>
          <p>
            We believe that security through obscurity is zero security. FileLocker relies exclusively on open, peer-reviewed cryptographic standards:
          </p>
          <ul class="space-y-2 text-sm pl-5 list-disc">
            <li><strong>Argon2id (RFC 9106):</strong> Implemented via WebAssembly from the audited, open-source <code>hash-wasm</code> engine.</li>
            <li><strong>AES-256-GCM (NIST SP 800-38D):</strong> Executed by the host browser's native Web Cryptography API, maintained and verified by Google, Apple, and Mozilla.</li>
            <li><strong>Client-Side Verifiability:</strong> Every line of JavaScript and WebAssembly executed on FileLocker can be inspected in real time using browser Developer Tools.</li>
          </ul>
          <div class="p-4 rounded-xl border border-blue-200 bg-blue-50/60 mt-4">
            <h3 class="text-sm font-bold text-blue-900 mb-1">Vulnerability Reporting Policy</h3>
            <p class="text-xs text-blue-800 leading-relaxed mb-0">
              If you identify a cryptographic weakness, potential implementation flaw, or security issue, please contact our security team directly at <a href="mailto:security@filelocker.online" class="underline font-semibold">security@filelocker.online</a>. We review all reports within 24 hours and commit to transparent, responsible disclosure.
            </p>
          </div>
        </div>
      </div>

      <!-- SECTION 9: CTA -->
      <div class="cta-banner mt-10 animate-fade-in-up">
        <h2 class="text-white text-2xl font-bold mb-2">Experience Client-Side Cryptography in Action</h2>
        <p class="cta-label mb-6">Test our in-browser AES-256 encryption pipeline with zero uploads and zero accounts.</p>
        <div class="flex flex-wrap justify-center gap-3 relative z-10">
          <a href="/lock-file/" class="cta-button">Lock a File</a>
          <a href="/lock-folder/" class="cta-button" style="background:transparent;color:#fff;border:2px solid rgba(255,255,255,0.4);">Lock a Folder</a>
        </div>
      </div>

    </div>
  </div>
</Layout>
